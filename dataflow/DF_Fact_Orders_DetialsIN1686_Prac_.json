{
	"name": "DF_Fact_Orders_DetialsIN1686_Prac_",
	"properties": {
		"folder": {
			"name": "Practice"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "SrcOrdersDetails"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "TgtOrdersDetails"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "FactOrderDetails",
					"rejectedDataLinkedService": {
						"referenceName": "LS_Azure_Blob_Storage",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "split1"
				},
				{
					"name": "NullHandling"
				},
				{
					"name": "select1"
				},
				{
					"name": "OrderDetailsKey"
				},
				{
					"name": "SelectedColumns1"
				},
				{
					"name": "SelectedColumns"
				},
				{
					"name": "union1"
				},
				{
					"name": "join1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderDetailID as integer,",
				"          OrderID as integer,",
				"          ProductID as short,",
				"          Quantity as short,",
				"          Created_date as string,",
				"          Created_by as string,",
				"          Updated_date as string,",
				"          Updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcOrdersDetails",
				"source(output(",
				"          orderdetail_id as integer,",
				"          order_id as integer,",
				"          product_id as string,",
				"          quantity as string,",
				"          created_date as string,",
				"          created_by as string,",
				"          updated_date as string,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TgtOrdersDetails",
				"join1 split(isNull(tgt_order_id),",
				"     (OrderDetailID == tgt_orderdetail_id) && (OrderID != tgt_order_id) || !isNull(tgt_order_id),",
				"     disjoint: false) ~> split1@(Insert, Update)",
				"SrcOrdersDetails derive(each(match(type == \"string\"), $$ = iifNull($$,\"UNK\",$$)),",
				"          each(match(type == \"integer\"), $$ = iifNull($$,0,$$)),",
				"          each(match(type == \"timestamp\"), $$ = iifNull($$,toTimestamp(\"1990-01-01\") ,$$))) ~> NullHandling",
				"TgtOrdersDetails select(mapColumn(",
				"          tgt_orderdetail_id = orderdetail_id,",
				"          tgt_order_id = order_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"NullHandling keyGenerate(output(orderdetail_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> OrderDetailsKey",
				"split1@Insert select(mapColumn(",
				"          OrderDetailID,",
				"          orderdetail_key,",
				"          OrderID,",
				"          ProductID,",
				"          Quantity,",
				"          Created_date,",
				"          Created_by,",
				"          Updated_date,",
				"          Updated_by,",
				"          runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectedColumns1",
				"split1@Update select(mapColumn(",
				"          OrderDetailID,",
				"          orderdetail_key,",
				"          OrderID,",
				"          ProductID,",
				"          Quantity,",
				"          Created_date,",
				"          Created_by,",
				"          Updated_date,",
				"          Updated_by,",
				"          runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectedColumns",
				"SelectedColumns1, SelectedColumns union(byName: true)~> union1",
				"OrderDetailsKey, select1 join(OrderDetailID == tgt_orderdetail_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['fact_orders_IN1686.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> FactOrderDetails"
			]
		}
	}
}