{
	"name": "DF_Stratification_Test",
	"properties": {
		"folder": {
			"name": "Module_Practice/Testing"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "TgtOrders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "sinkInvalidOrdersRec"
				}
			],
			"transformations": [
				{
					"name": "split1"
				},
				{
					"name": "NewRecCheck"
				},
				{
					"name": "OldRecCheck"
				},
				{
					"name": "unionNewOldRec"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as integer,",
				"          CustomerID as integer,",
				"          ProductID as integer,",
				"          OrderDate as date,",
				"          Amount as integer,",
				"          Order_type as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TgtOrders",
				"TgtOrders split(OrderDate>addDays(OrderDate, -12),",
				"     OrderDate<addDays(OrderDate, -12),",
				"     disjoint: true) ~> split1@(New, Old)",
				"split1@New filter(Order_type!='Recent') ~> NewRecCheck",
				"split1@Old filter(Order_type!='Old') ~> OldRecCheck",
				"NewRecCheck, OldRecCheck union(byName: true)~> unionNewOldRec",
				"unionNewOldRec sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Invalid_Orders_Stratification_Rec'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sinkInvalidOrdersRec"
			]
		}
	}
}