{
	"name": "DF_Order_details_INCR",
	"properties": {
		"folder": {
			"name": "practice"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "srcSTGorderdetails"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "tgtOrderDetails"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "selectTGT"
				},
				{
					"name": "LEFTSrcTgt"
				},
				{
					"name": "surrogateOrderDetailKey"
				},
				{
					"name": "split1"
				},
				{
					"name": "union"
				},
				{
					"name": "selectColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderDetailID as integer,",
				"          OrderID as integer,",
				"          ProductID as integer,",
				"          Quantity as integer,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcSTGorderdetails",
				"source(output(",
				"          OrderDetailID as integer,",
				"          OrderID as integer,",
				"          ProductID as integer,",
				"          Quantity as integer,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string,",
				"          orderdetail_key as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> tgtOrderDetails",
				"tgtOrderDetails select(mapColumn(",
				"          t_OrderDetailID = OrderDetailID,",
				"          t_OrderID = OrderID,",
				"          t_ProductID = ProductID,",
				"          t_Quantity = Quantity",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectTGT",
				"srcSTGorderdetails, selectTGT join(OrderDetailID == t_OrderDetailID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> LEFTSrcTgt",
				"union keyGenerate(output(orderdetail_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateOrderDetailKey",
				"LEFTSrcTgt split(isNull(t_OrderDetailID),",
				"     (OrderDetailID == t_OrderDetailID) && ((OrderID != t_OrderID) || (ProductID != t_ProductID) || (t_Quantity !=Quantity)),",
				"     disjoint: true) ~> split1@(Insert, Update)",
				"split1@Insert, split1@Update union(byName: true)~> union",
				"surrogateOrderDetailKey select(mapColumn(",
				"          OrderDetailID,",
				"          orderdetail_key,",
				"          OrderID,",
				"          Product_iID = ProductID,",
				"          Quantity,",
				"          created_date,",
				"          created_by,",
				"          updated_date,",
				"          updated_by,",
				"          runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectColumns",
				"selectColumns sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Fact_orderdetails_IN1685.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}