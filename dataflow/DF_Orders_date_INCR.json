{
	"name": "DF_Orders_date_INCR",
	"properties": {
		"folder": {
			"name": "practice"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "SRCstgorders"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "TGTorders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "SNKFctOrders"
				}
			],
			"transformations": [
				{
					"name": "SELECTtgtcols"
				},
				{
					"name": "LEFTSrcTgt"
				},
				{
					"name": "SURROGATEorderkey"
				},
				{
					"name": "split1"
				},
				{
					"name": "UNIONstreams"
				},
				{
					"name": "SELECTcols"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as integer,",
				"          CustomerID as integer,",
				"          OrderAmount as decimal(10,2),",
				"          OrderDate as timestamp,",
				"          Status as string,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCstgorders",
				"source(output(",
				"          order_id as integer,",
				"          order_key as integer,",
				"          customer_id as integer,",
				"          order_amount as decimal(10,2),",
				"          order_date as timestamp,",
				"          status as string,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TGTorders",
				"TGTorders select(mapColumn(",
				"          each(match(true()),",
				"               \"T_\"+$$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SELECTtgtcols",
				"SRCstgorders, SELECTtgtcols join(OrderID == T_order_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> LEFTSrcTgt",
				"UNIONstreams keyGenerate(output(order_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> SURROGATEorderkey",
				"LEFTSrcTgt split(isNull(T_order_id),",
				"     ( OrderID == T_order_id ) && (OrderDate>greatest(T_order_date)),",
				"     disjoint: true) ~> split1@(INSERTstream, UPDATEstream)",
				"split1@INSERTstream, split1@UPDATEstream union(byName: true)~> UNIONstreams",
				"SURROGATEorderkey select(mapColumn(",
				"          order_id = OrderID,",
				"          order_key,",
				"          customer_id = CustomerID,",
				"          order_amount = OrderAmount,",
				"          order_date = OrderDate,",
				"          status = Status,",
				"          created_date,",
				"          created_by,",
				"          updated_date,",
				"          updated_by,",
				"          runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SELECTcols",
				"SELECTcols sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['fct_orders_date.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SNKFctOrders"
			]
		}
	}
}