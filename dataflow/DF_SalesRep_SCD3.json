{
	"name": "DF_SalesRep_SCD3",
	"properties": {
		"folder": {
			"name": "workshop/STG_DW"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "SRCsalesrep"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "TGTsalesrep"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "leftjoin1"
				},
				{
					"name": "selectTGT",
					"description": "Renaming TGTsales"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2",
					"description": "derivedUPD"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "select1"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Sales_S_Key as integer,",
				"          Sales_Rep_Id as integer,",
				"          Sales_Rep_Name as string,",
				"          Sales_Rep_LoginAccess as string,",
				"          Sales_Rep_Email as string,",
				"          Sales_Rep_Phone as string,",
				"          Sales_Rep_Address as string,",
				"          Sales_Rep_City as string,",
				"          Sales_Rep_Country as string,",
				"          Created_Date as timestamp,",
				"          Last_Modified_Date as timestamp,",
				"          Delete_Flag as string,",
				"          Active_Flag as string,",
				"          Created_Time as timestamp,",
				"          Created_By as string,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Updated_By as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCsalesrep",
				"source(output(",
				"          Sales_S_Key as integer,",
				"          Sales_Rep_Id as integer,",
				"          Sales_Rep_Name as string,",
				"          Sales_Rep_LoginAccess as string,",
				"          Sales_Rep_Email as string,",
				"          Sales_Rep_Phone as string,",
				"          Sales_Rep_Address as string,",
				"          Sales_Rep_City as string,",
				"          Sales_Rep_Country as string,",
				"          Created_Date as timestamp,",
				"          Last_Modified_Date as timestamp,",
				"          Delete_Flag as string,",
				"          Active_Flag as string,",
				"          Created_Time as timestamp,",
				"          Created_By as string,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Updated_By as string,",
				"          Previous_Sales_Rep_City as string,",
				"          Current_Sales_Rep_City as string,",
				"          Current_Sales_Rep_Phone as string,",
				"          Previous_Sales_Rep_Phone as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TGTsalesrep",
				"SRCsalesrep, selectTGT join(Sales_Rep_Id == T_Sales_Rep_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> leftjoin1",
				"TGTsalesrep select(mapColumn(",
				"          T_Sales_S_Key = Sales_S_Key,",
				"          T_Sales_Rep_Id = Sales_Rep_Id,",
				"          T_Sales_Rep_Name = Sales_Rep_Name,",
				"          T_Sales_Rep_LoginAccess = Sales_Rep_LoginAccess,",
				"          T_Sales_Rep_Email = Sales_Rep_Email,",
				"          T_Sales_Rep_Phone = Sales_Rep_Phone,",
				"          T_Sales_Rep_Address = Sales_Rep_Address,",
				"          T_Sales_Rep_City = Sales_Rep_City,",
				"          T_Sales_Rep_Country = Sales_Rep_Country,",
				"          T_Created_Date = Created_Date,",
				"          T_Last_Modified_Date = Last_Modified_Date,",
				"          T_Delete_Flag = Delete_Flag,",
				"          T_Active_Flag = Active_Flag,",
				"          T_Created_Time = Created_Time,",
				"          T_Created_By = Created_By,",
				"          T_Last_Modified_Time = Last_Modified_Time,",
				"          T_Last_Updated_By = Last_Updated_By,",
				"          Previous_Sales_Rep_City,",
				"          Current_Sales_Rep_City,",
				"          Current_Sales_Rep_Phone,",
				"          Previous_Sales_Rep_Phone",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectTGT",
				"leftjoin1 split(isNull(T_Sales_Rep_Id),",
				"     (Sales_Rep_Id == T_Sales_Rep_Id) && ((Sales_Rep_Phone != T_Sales_Rep_Phone) || (Sales_Rep_City != T_Sales_Rep_City) || (Sales_Rep_Country != T_Sales_Rep_Country)),",
				"     disjoint: true) ~> split1@(InsertStream, UpdateStream)",
				"split1@UpdateStream derive(Current_Sales_Rep_City = Sales_Rep_City,",
				"          Previous_Sales_Rep_City = Current_Sales_Rep_City,",
				"          Sales_Rep_City = T_Sales_Rep_City) ~> derivedColumn2",
				"split1@InsertStream derive(Current_Sales_Rep_City = Sales_Rep_City) ~> derivedColumn3",
				"derivedColumn3 select(mapColumn(",
				"          Sales_S_Key,",
				"          Sales_Rep_Id,",
				"          Sales_Rep_Name,",
				"          Sales_Rep_LoginAccess,",
				"          Sales_Rep_Email,",
				"          Sales_Rep_Phone,",
				"          Sales_Rep_Address,",
				"          Sales_Rep_City,",
				"          Sales_Rep_Country,",
				"          Created_Date,",
				"          Last_Modified_Date,",
				"          Delete_Flag,",
				"          Active_Flag,",
				"          Created_Time,",
				"          Created_By,",
				"          Last_Modified_Time,",
				"          Last_Updated_By,",
				"          Previous_Sales_Rep_City,",
				"          Current_Sales_Rep_City,",
				"          Current_Sales_Rep_Phone,",
				"          Previous_Sales_Rep_Phone",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumn2 select(mapColumn(",
				"          Sales_S_Key,",
				"          Sales_Rep_Id,",
				"          Sales_Rep_Name,",
				"          Sales_Rep_LoginAccess,",
				"          Sales_Rep_Email,",
				"          Sales_Rep_Phone,",
				"          Sales_Rep_Address,",
				"          Sales_Rep_City,",
				"          Sales_Rep_Country,",
				"          Created_Date,",
				"          Last_Modified_Date,",
				"          Delete_Flag,",
				"          Active_Flag,",
				"          Created_Time,",
				"          Created_By,",
				"          Last_Modified_Time,",
				"          Last_Updated_By,",
				"          Previous_Sales_Rep_City,",
				"          Current_Sales_Rep_City,",
				"          Current_Sales_Rep_Phone,",
				"          Previous_Sales_Rep_Phone",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['salesrep_tgt1.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['salesrep_t2.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink2"
			]
		}
	}
}