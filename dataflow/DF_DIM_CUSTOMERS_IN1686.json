{
	"name": "DF_DIM_CUSTOMERS_IN1686",
	"properties": {
		"folder": {
			"name": "MOCK"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "StgCustomers"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "TGTCustomer"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "TgtDimcustomers",
					"rejectedDataLinkedService": {
						"referenceName": "LS_Azure_Blob_Storage",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "LeftJOIN"
				},
				{
					"name": "Transformations"
				},
				{
					"name": "split1"
				},
				{
					"name": "StgCustomerSelect"
				},
				{
					"name": "TGTCustomerSelect"
				},
				{
					"name": "InsertAduitColumn"
				},
				{
					"name": "UpdateAduitColumn"
				},
				{
					"name": "NullHandling"
				},
				{
					"name": "insertunionupdate"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CustomerID as short,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Email as string,",
				"          Country as string,",
				"          CreatedDate as date,",
				"          Created_date as string,",
				"          Created_by as string,",
				"          Updated_date as string,",
				"          Updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> StgCustomers",
				"source(output(",
				"          customer_id as integer,",
				"          customer_key as string,",
				"          first_name as string,",
				"          last_name as string,",
				"          customer_name as string,",
				"          email as string,",
				"          country as string,",
				"          isActive as string,",
				"          start_date as string,",
				"          end_date as string,",
				"          created_date as string,",
				"          created_by as string,",
				"          updated_date as string,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TGTCustomer",
				"StgCustomerSelect, TGTCustomerSelect join(CustomerID == customer_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> LeftJOIN",
				"LeftJOIN derive(customer_name = concat(FirstName,\" \",LastName)) ~> Transformations",
				"NullHandling split(isNull(customer_id) || !isNull(customer_id) && (StgCustomerSelect@Country != TGTCustomer@country),",
				"     !isNull(customer_id) && (StgCustomerSelect@Country != TGTCustomer@country),",
				"     disjoint: false) ~> split1@(Insert, Update)",
				"StgCustomers select(mapColumn(",
				"          CustomerID,",
				"          FirstName,",
				"          LastName,",
				"          Email,",
				"          Country,",
				"          CreatedDate,",
				"          Created_date,",
				"          Created_by,",
				"          Updated_date,",
				"          Updated_by,",
				"          runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> StgCustomerSelect",
				"TGTCustomer select(mapColumn(",
				"          customer_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> TGTCustomerSelect",
				"split1@Insert derive(isActive = \"Y\",",
				"          start_date = currentUTC(),",
				"          end_date = currentUTC()) ~> InsertAduitColumn",
				"split1@Update derive(isActive = \"N\",",
				"          start_date = currentUTC(),",
				"          end_date = CreatedDate) ~> UpdateAduitColumn",
				"Transformations derive(each(match(type==\"string\"), $$ = iifNull($$, \"UNK\", $$)),",
				"          each(match(type == \"integer\"), $$ = iifNull($$, 0, $$))) ~> NullHandling",
				"InsertAduitColumn, UpdateAduitColumn union(byName: true)~> insertunionupdate",
				"insertunionupdate sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Dim_customers_In1686'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> TgtDimcustomers"
			]
		}
	}
}