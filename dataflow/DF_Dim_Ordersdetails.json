{
	"name": "DF_Dim_Ordersdetails",
	"properties": {
		"folder": {
			"name": "Practice_DF_IN1675"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "SrcOrders"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "TgtOrders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "DimOrderDetails"
				}
			],
			"transformations": [
				{
					"name": "join"
				},
				{
					"name": "orderdetailkey"
				},
				{
					"name": "NewRecords"
				},
				{
					"name": "Insert"
				},
				{
					"name": "select"
				}
			],
			"scriptLines": [
				"source(output(",
				"          orderdetail_id as integer,",
				"          order_id as integer,",
				"          product_id as integer,",
				"          quantity as integer,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcOrders",
				"source(output(",
				"          orderdetail_id as integer,",
				"          orderdetail_key as integer,",
				"          order_id as integer,",
				"          product_id as integer,",
				"          quantity as integer,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TgtOrders",
				"orderdetailkey, TgtOrders join(SrcOrders@orderdetail_id == TgtOrders@orderdetail_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join",
				"SrcOrders keyGenerate(output(Orderdetail_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> orderdetailkey",
				"join filter(isNull(TgtOrders@order_id) ) ~> NewRecords",
				"NewRecords alterRow(insertIf(true())) ~> Insert",
				"Insert select(mapColumn(",
				"          orderdetail_id = SrcOrders@orderdetail_id,",
				"          Orderdetail_key = orderdetailkey@Orderdetail_key,",
				"          order_id = SrcOrders@order_id,",
				"          product_id = SrcOrders@product_id,",
				"          quantity = SrcOrders@quantity,",
				"          created_date = SrcOrders@created_date,",
				"          created_by = SrcOrders@created_by,",
				"          updated_date = SrcOrders@updated_date,",
				"          updated_by = SrcOrders@updated_by,",
				"          runid = SrcOrders@runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select",
				"select sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Dim_OrderDetails.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> DimOrderDetails"
			]
		}
	}
}