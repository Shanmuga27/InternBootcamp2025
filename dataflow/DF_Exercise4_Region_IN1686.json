{
	"name": "DF_Exercise4_Region_IN1686",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "Customers"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "Orders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "OrdersAPAC"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "OrdersEMEA"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "CustomerAMER"
				}
			],
			"transformations": [
				{
					"name": "CustomersJoinsOrders"
				},
				{
					"name": "StartsWithJ"
				},
				{
					"name": "split1"
				},
				{
					"name": "amountgt2000"
				},
				{
					"name": "LikeINC"
				}
			],
			"scriptLines": [
				"parameters{",
				"     pRegion as string[],",
				"     FILENAME1 as string,",
				"     FILENAME2 as string,",
				"     FILENAME3 as string",
				"}",
				"source(output(",
				"          CustomerID as string,",
				"          Name as string,",
				"          Country as string,",
				"          Age as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Customers",
				"source(output(",
				"          OrderID as string,",
				"          CustomerID as string,",
				"          ProductID as string,",
				"          OrderDate as date,",
				"          Amount as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Orders",
				"Customers, Orders join(Customers@CustomerID == Orders@CustomerID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> CustomersJoinsOrders",
				"split1@APAC filter(startsWith(Name,'J')) ~> StartsWithJ",
				"CustomersJoinsOrders split($pRegion[1] == 'APAC' && (Country== 'India' || Country== 'Australia'),",
				"     $pRegion[2] == 'EMEA' && (Country== 'UK'),",
				"     $pRegion[3] == 'EMEA' && (Country== 'USA' || Country== 'Canada'),",
				"     disjoint: false) ~> split1@(APAC, EMEA, AMER)",
				"split1@EMEA filter(Amount > 2000) ~> amountgt2000",
				"split1@AMER filter(like(lower(Name), 'inc')) ~> LikeINC",
				"StartsWithJ sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> OrdersAPAC",
				"amountgt2000 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> OrdersEMEA",
				"LikeINC sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> CustomerAMER"
			]
		}
	}
}