{
	"name": "DF_aggregate",
	"properties": {
		"folder": {
			"name": "Repractise"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "source2"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "source3"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "source4"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "join2"
				},
				{
					"name": "join3"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				},
				{
					"name": "window1"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename as string",
				"}",
				"source(output(",
				"          customer_id as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          email as string,",
				"          country as string,",
				"          created_date as string,",
				"          {created_by } as string,",
				"          updated_date as string,",
				"          updated_by as string,",
				"          runid as string,",
				"          customer_key as short,",
				"          customer_name as string,",
				"          isActive as boolean,",
				"          start_date as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          product_id as short,",
				"          category as string,",
				"          price as integer,",
				"          {created date} as string,",
				"          {created by } as string,",
				"          {updated date} as string,",
				"          {updated by} as string,",
				"          runid as string,",
				"          products_key as short,",
				"          product_name as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"source(output(",
				"          order_id as integer,",
				"          customer_id as integer,",
				"          order_amount as integer,",
				"          order_date as string,",
				"          status as string,",
				"          {created date} as string,",
				"          {created by } as string,",
				"          {updated date} as string,",
				"          {updated by} as string,",
				"          { runid} as string,",
				"          order_key as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source3",
				"source(output(",
				"          orderdetail_id as integer,",
				"          order_id as integer,",
				"          product_id as integer,",
				"          quantity as string,",
				"          {created date} as string,",
				"          {created by } as string,",
				"          {updated date} as string,",
				"          {updated by} as string,",
				"          { runid} as string,",
				"          {orderdetail_key     } as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source4",
				"source1, source3 join(source1@customer_id == source3@customer_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1, source4 join(source3@order_id == source4@order_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2, source2 join(source4@product_id == source2@product_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"select1 split(lower(status) == 'completed',",
				"     disjoint: false) ~> split1@(filter)",
				"split1@filter derive(YearMonth = toString(order_date,'yyyy-MM')) ~> derivedColumn1",
				"join3 select(mapColumn(",
				"          customer_id = source1@customer_id,",
				"          first_name,",
				"          last_name,",
				"          email,",
				"          country,",
				"          created_date,",
				"          {created_by },",
				"          updated_date,",
				"          updated_by,",
				"          runid = source1@runid,",
				"          customer_key,",
				"          customer_name,",
				"          isActive,",
				"          start_date,",
				"          order_id = source3@order_id,",
				"          customer_id = source3@customer_id,",
				"          order_amount,",
				"          order_date,",
				"          status,",
				"          {created date} = source3@{created date},",
				"          {created by } = source3@{created by },",
				"          {updated date} = source3@{updated date},",
				"          {updated by} = source3@{updated by},",
				"          { runid} = source3@{ runid},",
				"          order_key,",
				"          orderdetail_id,",
				"          order_id = source4@order_id,",
				"          product_id = source4@product_id,",
				"          quantity,",
				"          {created date} = source4@{created date},",
				"          {created by } = source4@{created by },",
				"          {updated date} = source4@{updated date},",
				"          {updated by} = source4@{updated by},",
				"          { runid} = source4@{ runid},",
				"          {orderdetail_key     },",
				"          product_id = source2@product_id,",
				"          category,",
				"          price,",
				"          {created date} = source2@{created date},",
				"          {created by } = source2@{created by },",
				"          {updated date} = source2@{updated date},",
				"          {updated by} = source2@{updated by},",
				"          runid = source2@runid,",
				"          products_key,",
				"          product_name",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumn1 window(over(category,",
				"          country,",
				"          YearMonth),",
				"     asc(YearMonth, true),",
				"     sales = sum(order_amount)) ~> window1",
				"window1 select(mapColumn(",
				"          country,",
				"          category,",
				"          YearMonth,",
				"          sales",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     partitionFileNames:[($filename)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}