{
	"name": "DF_EDL_STG_Estimate",
	"properties": {
		"folder": {
			"name": "Workshop/EDL - STG"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "EDLEstimate"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "STGLocation"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "STGCustomer"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "STGProduct"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "STGSalesRep"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "STGEstimate"
				}
			],
			"transformations": [
				{
					"name": "DerivedColumn"
				},
				{
					"name": "transformation1"
				},
				{
					"name": "join1"
				},
				{
					"name": "select"
				},
				{
					"name": "join2"
				},
				{
					"name": "join3"
				},
				{
					"name": "select1"
				},
				{
					"name": "join4"
				},
				{
					"name": "transformation2"
				},
				{
					"name": "transformation3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Estimate_Key as integer,",
				"          Transaction_Id as integer,",
				"          Transaction_Line_Id as integer,",
				"          Memo as string,",
				"          Sticker_Requirements as string,",
				"          Inner_Requirements as string,",
				"          Customer_Requirements as string,",
				"          Sales_Program as string,",
				"          Buyer_Dept as string,",
				"          Buyer_Confirmed_On as string,",
				"          Dept_Program as string,",
				"          Program_0 as string,",
				"          Cancelled as string,",
				"          Confidence_Factor_Id as integer,",
				"          Company_Id as integer,",
				"          Item_Id as integer,",
				"          Location_Id as integer,",
				"          Sales_Rep_Id as integer,",
				"          TranId as string,",
				"          Price_Sticker_Id as integer,",
				"          Po as string,",
				"          Release_Order_Number as string,",
				"          Cntnr_ as string,",
				"          Etd_Ship_Date as timestamp,",
				"          Ship_Date_Outbound as timestamp,",
				"          Cancel_Date_Outbound as timestamp,",
				"          Expiration_Date as timestamp,",
				"          Item_Count as integer,",
				"          Inner_Qty as integer,",
				"          Release_Quantity as string,",
				"          Quantity_Received_In_Shipment as integer,",
				"          Item_Unit_Price as string,",
				"          Amount as float,",
				"          Eta_Arrival_Date as string,",
				"          Delete_Flg as string,",
				"          Active_Flag as string,",
				"          Create_Date as timestamp,",
				"          Date_Created as timestamp,",
				"          Date_Last_Modified_Gmt as string,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> EDLEstimate",
				"source(output(",
				"          Location_Id as short,",
				"          Location_key as short,",
				"          Location_Name as string,",
				"          Location_City as string,",
				"          Location_Country as string,",
				"          Location_State as string,",
				"          Location_Zipcode as string,",
				"          Delete_Flg as boolean,",
				"          Active_Flag as boolean,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> STGLocation",
				"source(output(",
				"          Customer_Id as integer,",
				"          Customer_key as short,",
				"          Company_Name as string,",
				"          Delete_Flg as string,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          Active_Flag as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> STGCustomer",
				"source(output(",
				"          Item_ID as integer,",
				"          Item_Key as short,",
				"          Item_Descr as string,",
				"          Brand_descr as string,",
				"          Artwork_descr as string,",
				"          Color_descr as string,",
				"          Package_Type_descr as string,",
				"          Special_Requirements_descr as string,",
				"          Case_Pack_descr as string,",
				"          Full_Name_descr as string,",
				"          Display_name_descr as string,",
				"          Account_manager_name as string,",
				"          Brand_name as string,",
				"          Brand_manager_name as string,",
				"          Item_Status_descr as string,",
				"          Item_Type_descr as string,",
				"          Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Master_Carton_req_descr as string,",
				"          Trade_Partner_Name as string,",
				"          Type_Name as string,",
				"          Trade_Partner_CD as string,",
				"          VendorName as string,",
				"          UPC_nbr as string,",
				"          On_Hand_Quantity as boolean,",
				"          SSCC14_nbr as boolean,",
				"          Master_Carton_Item_nbr as integer,",
				"          Part_Of_Assembly_Item as string,",
				"          Delete_Flg as string,",
				"          Active_Flag as string,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> STGProduct",
				"source(output(",
				"          Sales_Rep_Id as short,",
				"          Sales_key as short,",
				"          Sales_Rep_Name as string,",
				"          Sales_Rep_Address as string,",
				"          Sales_Rep_City as string,",
				"          Sales_Rep_Country as string,",
				"          Sales_Rep_Email as string,",
				"          Sales_Rep_Loginaccess as boolean,",
				"          Sales_Rep_Phone as string,",
				"          Delete_Flg as boolean,",
				"          Active_Flag as boolean,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> STGSalesRep",
				"EDLEstimate derive(Sticker_Requirement_Purchase_descr = case(Sticker_Requirements=='NULL' || Sticker_Requirements == '0','No Stickers' ,\r",
				"    (Inner_Requirements=='NULL' || Inner_Requirements == '0') && (Customer_Requirements=='NULL' || Customer_Requirements == '0'),Sticker_Requirements ,\r",
				"        Customer_Requirements=='NULL' || Customer_Requirements == '0', Sticker_Requirements, 'unk'),",
				"          Confidence_Factor_Id = toString( case(Confidence_Factor_Id == 1, '25%',\r",
				"    Confidence_Factor_Id == 2, '50%',\r",
				"        Confidence_Factor_Id == 3, '75%',\r",
				"            Confidence_Factor_Id == 4, '90%',\r",
				"                Confidence_Factor_Id == 5, 'Dropped',\r",
				"                    Confidence_Factor_Id == 6, 'Actual',\r",
				"                        Confidence_Factor_Id == 7, '90%-Pre',\r",
				"                            Confidence_Factor_Id == 8, '90%-Releases', 'unk')),",
				"          Date_Last_Modified_Gmt = toTimestamp(currentDate()),",
				"          Last_Updated_By = \"IN1684\",",
				"          Last_Update_Timestamp = currentTimestamp()) ~> DerivedColumn",
				"select derive(Level_Descr = case(Confidence_Factor_Id == '25%','',\r",
				"    Confidence_Factor_Id == '50%','',\r",
				"    Confidence_Factor_Id == 'Dropped','',\r",
				"    Confidence_Factor_Id == '75%', 'Pending Confirmation',\r",
				"    Confidence_Factor_Id == '90%','Pending Approval%',\r",
				"    Confidence_Factor_Id == 'Actual', 'Confirmed',\r",
				"    Confidence_Factor_Id == '90%-Pre', 'Confirmed',\r",
				"    Confidence_Factor_Id == '90%-Releases','Confirmed') ,",
				"          Final_Destination_Container = concat(Location_City,Location_Name),",
				"          PRICE_STICKER_descr = case(\r",
				"  like(Sticker_Requirements, '%$%price sticker%'),\r",
				"  regexExtract(Sticker_Requirements, '\\\\$.*?price sticker', 0),\r",
				"  'No Sticker'\r",
				")\r",
				") ~> transformation1",
				"DerivedColumn, STGLocation join(EDLEstimate@Location_Id == STGLocation@Location_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          Estimate_Key,",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo,",
				"          Sticker_Requirements,",
				"          Inner_Requirements,",
				"          Customer_Requirements,",
				"          Sales_Program,",
				"          Buyer_Dept,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program,",
				"          Program_0,",
				"          Cancelled,",
				"          Confidence_Factor_Id,",
				"          Company_Id,",
				"          Item_Id,",
				"          Location_Id = EDLEstimate@Location_Id,",
				"          Sales_Rep_Id,",
				"          TranId,",
				"          Price_Sticker_Id,",
				"          Po,",
				"          Release_Order_Number,",
				"          Cntnr_,",
				"          Etd_Ship_Date,",
				"          Ship_Date_Outbound,",
				"          Cancel_Date_Outbound,",
				"          Expiration_Date,",
				"          Item_Count,",
				"          Inner_Qty,",
				"          Release_Quantity,",
				"          Quantity_Received_In_Shipment,",
				"          Item_Unit_Price,",
				"          Amount,",
				"          Eta_Arrival_Date,",
				"          Delete_Flg = EDLEstimate@Delete_Flg,",
				"          Active_Flag = EDLEstimate@Active_Flag,",
				"          Create_Date,",
				"          Date_Created,",
				"          Date_Last_Modified_Gmt,",
				"          Created_By = EDLEstimate@Created_By,",
				"          Created_Timestamp = EDLEstimate@Created_Timestamp,",
				"          Last_Updated_By = DerivedColumn@Last_Updated_By,",
				"          Last_Update_Timestamp = DerivedColumn@Last_Update_Timestamp,",
				"          Sticker_Requirement_Purchase_descr,",
				"          Location_key,",
				"          Location_Name,",
				"          Location_City,",
				"          Location_Country,",
				"          Location_State,",
				"          Location_Zipcode",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select",
				"transformation1, STGCustomer join(Company_Id == Customer_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2, STGProduct join(select@Item_Id == STGProduct@Item_ID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join4 select(mapColumn(",
				"          Sales_Estimate_Key = Estimate_Key,",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo_descr = Memo,",
				"          Sticker_Requirements_descr = Sticker_Requirements,",
				"          Inner_Requirements_descr = Inner_Requirements,",
				"          Customer_Requirements_descr = Customer_Requirements,",
				"          Sales_Program_descr = Sales_Program,",
				"          Buyer_Dept_descr = Buyer_Dept,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program_descr = Dept_Program,",
				"          Program_descr = Program_0,",
				"          Cancelled_descr = Cancelled,",
				"          Sticker_Requirement_Purchase_descr,",
				"          Confidence_Factor_descr = Confidence_Factor_Id,",
				"          Level_Descr,",
				"          Company_Id,",
				"          Item_Id = select@Item_Id,",
				"          Location_Id,",
				"          Sales_Rep_Id = select@Sales_Rep_Id,",
				"          TranId,",
				"          Price_Sticker_Id,",
				"          Po,",
				"          Release_Order_Number,",
				"          Cntnr_,",
				"          Etd_Ship_Date,",
				"          Ship_Date_Outbound,",
				"          Cancel_Date_Outbound,",
				"          Expiration_Date,",
				"          Item_Count,",
				"          Inner_Qty,",
				"          Release_Quantity,",
				"          Quantity_Received_In_Shipment,",
				"          Item_Unit_Price,",
				"          Amount,",
				"          Eta_Arrival_Date,",
				"          Delete_Flg = select@Delete_Flg,",
				"          Active_Flag = select@Active_Flag,",
				"          Create_Date = select@Create_Date,",
				"          Date_Created,",
				"          Date_Last_Modified_Gmt,",
				"          Created_By = select@Created_By,",
				"          Created_Timestamp = select@Created_Timestamp,",
				"          Last_Updated_By = select@Last_Updated_By,",
				"          Last_Update_Timestamp = select@Last_Update_Timestamp,",
				"          Location_key,",
				"          Location_Name,",
				"          Location_City,",
				"          Location_Country,",
				"          Final_Destination_Container,",
				"          PRICE_STICKER_descr,",
				"          Customer_Id,",
				"          Customer_key,",
				"          Company_Name,",
				"          Item_Key,",
				"          Sales_key",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> select1",
				"join3, STGSalesRep join(select@Sales_Rep_Id == STGSalesRep@Sales_Rep_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join4",
				"select1 derive(Month_Ship_dt = concat(toString(year(Ship_Date_Outbound),'-',toString(month(Ship_Date_Outbound)))),",
				"          ETD_dt = toTimestamp(iif(    \r",
				"    like(Location_Name,'%DotCom Distribution - Edison NJ%'), subDays(toDate(Ship_Date_Outbound),66),    \r",
				"    iif(like(Location_Name,'%Berkley%'), subDays(toDate(Ship_Date_Outbound),59),    \r",
				"    iif(like(Location_Name,'%POE China%'), subDays(toDate(Ship_Date_Outbound),14),    \r",
				"    iif(like(Location_Name,'%POE OAK%'), subDays(toDate(Ship_Date_Outbound),59),    \r",
				"    iif(like(Location_Name,'%POE Vietnam%'), subDays(toDate(Ship_Date_Outbound),14)    \r",
				"    ,subDays(toDate(Ship_Date_Outbound),45)))))))) ~> transformation2",
				"transformation2 derive(Month_ETD_dt = concat(toString(year(ETD_dt)),'-',toString(month(ETD_dt))),",
				"          MS_Domestic_Ship_Date = subDays(Etd_Ship_Date, 45),",
				"          MS_Domestic_Cancel_Date = addDays(Etd_Ship_Date,55),",
				"          each(match(type == 'string'), $$ = iif(isNull($$) || $$ == 'NULL', 'UNK', $$)),",
				"          each(match(type == 'integer'), trim($$) = iifNull($$, 0)),",
				"          each(match(type == 'timestamp'), $$ = iifNull($$, toTimestamp('1900-01-01 00:00:00', 'dd-MM-yyyy HH:mm:ss')))) ~> transformation3",
				"transformation3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['STG_Estimate'],",
				"     mapColumn(",
				"          Sales_Estimate_Key,",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo_descr,",
				"          Sticker_Requirements_descr,",
				"          Inner_Requirements_descr,",
				"          Customer_Requirements_descr,",
				"          Sales_Program_descr,",
				"          Buyer_Dept_descr,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program_descr,",
				"          Program_descr,",
				"          Cancelled_descr,",
				"          Sticker_Requirement_Purchase_descr,",
				"          Confidence_Factor_descr,",
				"          Level_Descr,",
				"          Final_Destination_Container,",
				"          PRICE_STICKER_descr,",
				"          Customer_key,",
				"          Item_Key,",
				"          Sales_Rep_key = Sales_key,",
				"          Location_key,",
				"          Document_nbr = TranId,",
				"          Price_Sticker_ID = Price_Sticker_Id,",
				"          Po_nbr = Po,",
				"          Release_Order_nbr = Release_Order_Number,",
				"          CNTNR_nbr = Cntnr_,",
				"          Etd_Ship_Date,",
				"          Ship_Date_Outbound,",
				"          Cancel_Date_Outbound,",
				"          Expiration_Date,",
				"          Eta_Arrival_Date,",
				"          Month_Ship_dt,",
				"          ETD_dt,",
				"          Month_ETD_dt,",
				"          MS_Domestic_Ship_Date,",
				"          MS_Domestic_Cancel_Date,",
				"          Item_qty = Item_Count,",
				"          Inner_qty = Inner_Qty,",
				"          Release_qty = Release_Quantity,",
				"          Quantity_Received_In_Shipment,",
				"          Item_unit_price = Item_Unit_Price,",
				"          Amount,",
				"          Delete_Flg,",
				"          Active_Flag,",
				"          Create_Date,",
				"          Date_Created,",
				"          Date_Last_Modified_Gmt,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     partitionBy('hash', 1)) ~> STGEstimate"
			]
		}
	}
}