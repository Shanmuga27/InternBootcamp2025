{
	"name": "DF_edl_to_STG_Purchaseorder",
	"properties": {
		"folder": {
			"name": "edl_to_stg"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "source2"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "source3"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "source4"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "join1"
				},
				{
					"name": "join2"
				},
				{
					"name": "join3"
				},
				{
					"name": "select4"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "select5"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename as string",
				"}",
				"source(output(",
				"          Transaction_Id as integer,",
				"          Transaction_Line_Id as integer,",
				"          Memo as string,",
				"          Sticker_Requirements as string,",
				"          Inner_Requirements as string,",
				"          Customer_Requirements as string,",
				"          Sales_Program as string,",
				"          Buyer_Dept as string,",
				"          Buyer_Confirmed_On as timestamp,",
				"          Dept_Program as string,",
				"          Program_0 as string,",
				"          Cancelled as string,",
				"          Confidence_Factor_Id as integer,",
				"          Company_Id as integer,",
				"          Item_Id as integer,",
				"          Location_Id as integer,",
				"          Sales_Rep_Id as string,",
				"          TranId as string,",
				"          Price_Sticker_Id as string,",
				"          Po as integer,",
				"          Release_Order_Number as string,",
				"          Cntnr_ as string,",
				"          Etd_Ship_Date as timestamp,",
				"          Ship_Date_Outbound as timestamp,",
				"          Cancel_Date_Outbound as timestamp,",
				"          Expiration_Date as string,",
				"          Item_Count as string,",
				"          Inner_Qty as string,",
				"          Release_Quantity as string,",
				"          Quantity_Received_In_Shipment as string,",
				"          Item_Unit_Price as string,",
				"          Amount as string,",
				"          Eta_Arrival_Date as string,",
				"          Closed_Script as string,",
				"          Estimate_key as integer,",
				"          Delete_flag as string,",
				"          Created_by as string,",
				"          Created_timestamp as timestamp,",
				"          Last_updated_by as string,",
				"          Last_updated_timestamp as timestamp,",
				"          Created_date as timestamp,",
				"          Date_created as timestamp,",
				"          Date_last_modified_gmt as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          Location_Id as integer,",
				"          Location_Name as string,",
				"          Location_City as string,",
				"          Location_Country as string,",
				"          Location_State as string,",
				"          Location_Zipcode as string,",
				"          Location_key as integer,",
				"          Delete_flag as string,",
				"          Created_by as string,",
				"          Created_timestamp as timestamp,",
				"          Last_updated_by as string,",
				"          Last_updated_timestamp as timestamp,",
				"          Active_flag as string,",
				"          Date_last_modified as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"source(output(",
				"          Item_Id as integer,",
				"          Item_Descr as string,",
				"          Brand_descr as string,",
				"          Artwork_descr as string,",
				"          Color_descr as string,",
				"          Package_Type_descr as string,",
				"          Special_Req_descr as string,",
				"          Case_Pack_descr as string,",
				"          Full_Name_descr as string,",
				"          Display_name_descr as string,",
				"          Account_manager_name as string,",
				"          Brand_name as string,",
				"          brand_manager_name as string,",
				"          Item_status_descr as string,",
				"          item_type_descr as string,",
				"          maker_name as string,",
				"          product_manager_name as string,",
				"          Master_Carton_req_descr as string,",
				"          Trade_partner_Name as string,",
				"          Type_Name as string,",
				"          Trade_partner_CD as string,",
				"          Vendor_Name as string,",
				"          UPC_nbr as string,",
				"          On_Hand_Quantity as boolean,",
				"          SSCC14_nbr as boolean,",
				"          Master_Carton_Item_nbr as integer,",
				"          Item_key as short,",
				"          Delete_flag as boolean,",
				"          Created_by as string,",
				"          Created_timestamp as timestamp,",
				"          Last_updated_by as string,",
				"          Last_updated_timestamp as timestamp,",
				"          Active_flag as boolean,",
				"          Created_date as timestamp,",
				"          Date_last_modified as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source3",
				"source(output(",
				"          Customer_Id as integer,",
				"          Company_Name as string,",
				"          Cutomer_key as short,",
				"          Delete_flag as boolean,",
				"          Created_by as string,",
				"          Created_timestamp as timestamp,",
				"          Last_updated_by as string,",
				"          Last_updated_timestamp as timestamp,",
				"          Active_flag as boolean,",
				"          Created_date as timestamp,",
				"          Date_last_modified as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source4",
				"join3 derive(each(match(type=='string'), $$ = replace(iifNull($$, \"UNK\"),'NULL','UNK')),",
				"          each(match(type=='integer'), $$ = iifNull($$, 0)),",
				"          each(match(type=='timestamp'), $$ = iifNull($$, toTimestamp('1900-01-01', 'yyyy-MM-dd'))),",
				"          Sticker_Requirement_Purchase_descr = iif(Sticker_Requirements=='0','No Stickers' ,     iif(Inner_Requirements=='0' && Customer_Requirements=='0',Sticker_Requirements ,         iif(Customer_Requirements=='0', Sticker_Requirements, 'unk'))),",
				"          Confidence_Factor_descr = iif(Confidence_Factor_Id == 1, '25%',\r",
				"iif(Confidence_Factor_Id == 2, '50%',\r",
				"iif(Confidence_Factor_Id == 3, '75%',\r",
				"iif(Confidence_Factor_Id == 4, '90%',\r",
				"iif(Confidence_Factor_Id == 5, 'Dropped',\r",
				"iif(Confidence_Factor_Id == 6, 'Actual',\r",
				"iif(Confidence_Factor_Id == 7, '90%-Pre',\r",
				"iif(Confidence_Factor_Id == 8, '90%-Releases',\r",
				"'UNK'))))))))) ~> derivedColumn1",
				"derivedColumn1 derive(Level_Descr = iif(Confidence_Factor_descr == '25%', '', iif(Confidence_Factor_descr == '50%', '', iif(Confidence_Factor_descr == 'Dropped', '', iif(Confidence_Factor_descr == '75%', 'Pending Confirmation', iif(Confidence_Factor_descr == '90%', 'Pending Approval%', iif(Confidence_Factor_descr == 'Actual', 'Confirmed', iif(Confidence_Factor_descr == '90%-Pre', 'Confirmed', iif(Confidence_Factor_descr == '90%-Releases', 'Confirmed', 'UNK')))))))),",
				"          Final_Destination_Container = concat(Location_City, Location_Name),",
				"          PRICE_STICKER_descr = case(like(Sticker_Requirements,'%$%price sticker'),replace(replace(Sticker_Requirements,'$',''),' price sticker',''), 'No Sticker'),",
				"          Month_Ship_dt = concat(toString(year(Ship_Date_Outbound)),'-',toString(month(Ship_Date_Outbound))) \r",
				",",
				"          ETD_dt = iif(\r",
				"    like(Location_Name,'%DotCom Distribution - Edison NJ%'), subDays(toDate(Ship_Date_Outbound),66),\r",
				"    iif(like(Location_Name,'%Berkley%'), subDays(toDate(Ship_Date_Outbound),59),\r",
				"    iif(like(Location_Name,'%POE China%'), subDays(toDate(Ship_Date_Outbound),14),\r",
				"    iif(like(Location_Name,'%POE OAK%'), subDays(toDate(Ship_Date_Outbound),59),\r",
				"    iif(like(Location_Name,'%POE Vietnam%'), subDays(toDate(Ship_Date_Outbound),14),\r",
				"    subDays(toDate(Ship_Date_Outbound),45)\r",
				")))))\r",
				" ) ~> derivedColumn2",
				"source3 select(mapColumn(",
				"          Item_key = Item_Id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"source4 select(mapColumn(",
				"          Customer_key = Customer_Id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"source1, select4 join(Location_Id == Location_key,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1, select2 join(Item_Id == Item_key,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2, select3 join(Company_Id == Customer_key,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"source2 select(mapColumn(",
				"          Location_key = Location_Id,",
				"          Location_Name,",
				"          Location_City",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"derivedColumn2 derive(Month_ETD_dt = concat(toString(year(ETD_dt)),'-',toString(month(ETD_dt))) ,",
				"          MS_Domestic_Ship_Date = Etd_Ship_Date-45 ,",
				"          MS_Domestic_Cancel_Date = Etd_Ship_Date+55) ~> derivedColumn3",
				"derivedColumn3 select(mapColumn(",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo_descr = Memo,",
				"          Sticker_Requirement_descr = Sticker_Requirements,",
				"          Inner_Requirement_descr = Inner_Requirements,",
				"          Customer_Requirement_descr = Customer_Requirements,",
				"          Sales_Program_descr = Sales_Program,",
				"          Buyer_Dept_descr = Buyer_Dept,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program_descr = Dept_Program,",
				"          Program_descr = Program_0,",
				"          Cancelled_descr = Cancelled,",
				"          Confidence_Factor_descr = Confidence_Factor_Id,",
				"          Company_Id,",
				"          Item_Id,",
				"          Location_Id,",
				"          Sales_Rep_Id,",
				"          Document_nbr = TranId,",
				"          Price_Sticker_Id,",
				"          PO_nbr = Po,",
				"          Release_Order_nbr = Release_Order_Number,",
				"          CNTNR_nbr = Cntnr_,",
				"          ETD_Ship_dt = Etd_Ship_Date,",
				"          Ship_Outbound_dt = Ship_Date_Outbound,",
				"          Cancel_Outbound_dt = Cancel_Date_Outbound,",
				"          Expiration_dt = Expiration_Date,",
				"          Item_qty = Item_Count,",
				"          Inner_qty = Inner_Qty,",
				"          Release_qty = Release_Quantity,",
				"          Quantity_Received_In_Shipment,",
				"          Item_unit_price = Item_Unit_Price,",
				"          Amount,",
				"          ETA_Arrival_Date = Eta_Arrival_Date,",
				"          Closed_Script,",
				"          Delete_flag,",
				"          Created_by,",
				"          Created_timestamp,",
				"          Last_updated_by,",
				"          Last_updated_timestamp,",
				"          Created_date,",
				"          Date_created,",
				"          Date_last_modified_gmt,",
				"          Location_key,",
				"          Location_Name,",
				"          Location_City,",
				"          Item_key,",
				"          Customer_key,",
				"          Sticker_Requirement_Purchase_descr,",
				"          Confidence_Factor_descr,",
				"          Level_Descr,",
				"          Final_Destination_Container,",
				"          PRICE_STICKER_descr,",
				"          Month_Ship_dt,",
				"          ETD_dt,",
				"          Month_ETD_dt,",
				"          MS_Domestic_Ship_Date,",
				"          MS_Domestic_Cancel_Date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select5",
				"select5 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     partitionFileNames:[($filename)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}