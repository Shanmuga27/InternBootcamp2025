{
	"name": "SCD3_SALESREPS",
	"properties": {
		"folder": {
			"name": "STG_To_DW"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_IN1689",
						"type": "DatasetReference"
					},
					"name": "STGSales"
				},
				{
					"name": "DimSales"
				}
			],
			"sinks": [
				{
					"name": "TGTSales"
				}
			],
			"transformations": [
				{
					"name": "SRC"
				},
				{
					"name": "join"
				},
				{
					"name": "select2"
				},
				{
					"name": "insertif"
				},
				{
					"name": "transformation1"
				},
				{
					"name": "union"
				},
				{
					"name": "select4"
				},
				{
					"name": "TGT"
				},
				{
					"name": "split1"
				},
				{
					"name": "updateif"
				},
				{
					"name": "transformation2"
				},
				{
					"name": "select5"
				},
				{
					"name": "select6"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> STGSales",
				"source(output(",
				"          Sales_Rep_key as integer,",
				"          Sales_Rep_ID as integer,",
				"          Sales_Rep_Name as string,",
				"          Sales_Rep_Address as string,",
				"          Sales_Rep_City as string,",
				"          Prev_Sales_Rep_City as string,",
				"          Sales_Rep_Country as string,",
				"          Prev_Sales_Rep_Country as string,",
				"          Sales_Rep_Email as string,",
				"          Sales_Rep_Loginaccess as string,",
				"          Sales_Rep_Phone as string,",
				"          Prev_Sales_Rep_Phone as string,",
				"          Delete_Flg as string,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false) ~> DimSales",
				"STGSales select(mapColumn(",
				"          Sales_Rep_key = Sales_key,",
				"          Sales_Rep_ID = Sales_Rep_Id,",
				"          Sales_Rep_Name,",
				"          Sales_Rep_Address,",
				"          Sales_Rep_City,",
				"          Sales_Rep_Country,",
				"          Sales_Rep_Email,",
				"          Sales_Rep_Loginaccess,",
				"          Sales_Rep_Phone,",
				"          Delete_Flg,",
				"          Create_Date,",
				"          Date_Last_Modified,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SRC",
				"select6, TGT join(SRC_Sales_Rep_ID == Sales_Rep_ID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join",
				"transformation1 select(mapColumn(",
				"          SRC_Sales_Rep_key,",
				"          SRC_Sales_Rep_ID,",
				"          SRC_Sales_Rep_Name,",
				"          SRC_Sales_Rep_Address,",
				"          SRC_Sales_Rep_Email,",
				"          SRC_Sales_Rep_Loginaccess,",
				"          SRC_Delete_Flg,",
				"          SRC_Create_Date,",
				"          SRC_Date_Last_Modified,",
				"          SRC_Created_By,",
				"          SRC_Created_Timestamp,",
				"          SRC_Last_Updated_By,",
				"          SRC_Last_Update_Timestamp,",
				"          Sales_Rep_City,",
				"          Prev_Sales_Rep_City,",
				"          Sales_Rep_Country,",
				"          Prev_Sales_Rep_Country,",
				"          Sales_Rep_Phone,",
				"          Prev_Sales_Rep_Phone",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> select2",
				"split1@INSERT alterRow(insertIf(true())) ~> insertif",
				"insertif derive(Sales_Rep_City = SRC_Sales_Rep_City,",
				"          Prev_Sales_Rep_City = toString(null()),",
				"          Sales_Rep_Country = SRC_Sales_Rep_Country,",
				"          Prev_Sales_Rep_Country = toString(null()),",
				"          Sales_Rep_Phone = SRC_Sales_Rep_Phone,",
				"          Prev_Sales_Rep_Phone = toString(null()),",
				"          SRC_Delete_Flg = \"N\",",
				"          SRC_Create_Date = toTimestamp(currentDate()),",
				"          SRC_Date_Last_Modified = currentTimestamp(),",
				"          SRC_Created_By = \"IN1684\",",
				"          SRC_Created_Timestamp = currentTimestamp(),",
				"          SRC_Last_Updated_By = \"IN1684\",",
				"          SRC_Last_Update_Timestamp = currentTimestamp()) ~> transformation1",
				"select2, select5 union(byName: true)~> union",
				"union select(mapColumn(",
				"          Sales_Rep_key = SRC_Sales_Rep_key,",
				"          Sales_Rep_ID = SRC_Sales_Rep_ID,",
				"          Sales_Rep_Name = SRC_Sales_Rep_Name,",
				"          Sales_Rep_Address = SRC_Sales_Rep_Address,",
				"          Sales_Rep_City,",
				"          Prev_Sales_Rep_City,",
				"          Sales_Rep_Country,",
				"          Prev_Sales_Rep_Country,",
				"          Sales_Rep_Email = SRC_Sales_Rep_Email,",
				"          Sales_Rep_Loginaccess = SRC_Sales_Rep_Loginaccess,",
				"          Sales_Rep_Phone,",
				"          Prev_Sales_Rep_Phone,",
				"          Delete_Flg = SRC_Delete_Flg,",
				"          Create_Date = SRC_Create_Date,",
				"          Date_Last_Modified = SRC_Date_Last_Modified,",
				"          Created_By = SRC_Created_By,",
				"          Created_Timestamp = SRC_Created_Timestamp,",
				"          Last_Updated_By = SRC_Last_Updated_By,",
				"          Last_Update_Timestamp = SRC_Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> select4",
				"DimSales select(mapColumn(",
				"          Sales_Rep_key,",
				"          Sales_Rep_ID,",
				"          Sales_Rep_Name,",
				"          Sales_Rep_Address,",
				"          Sales_Rep_City,",
				"          Prev_Sales_Rep_City,",
				"          Sales_Rep_Country,",
				"          Prev_Sales_Rep_Country,",
				"          Sales_Rep_Email,",
				"          Sales_Rep_Loginaccess,",
				"          Sales_Rep_Phone,",
				"          Prev_Sales_Rep_Phone,",
				"          Delete_Flg,",
				"          Create_Date,",
				"          Date_Last_Modified,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> TGT",
				"join split(isNull(Sales_Rep_ID),",
				"     SRC_Sales_Rep_ID==Sales_Rep_ID && (SRC_Sales_Rep_City != Sales_Rep_City || SRC_Sales_Rep_Country != Sales_Rep_Country || SRC_Sales_Rep_Phone != Sales_Rep_Phone),",
				"     disjoint: false) ~> split1@(INSERT, UPDATE)",
				"split1@UPDATE alterRow(updateIf(true())) ~> updateif",
				"updateif derive(Sales_Rep_City = SRC_Sales_Rep_City,",
				"          Prev_Sales_Rep_City = Sales_Rep_City,",
				"          Sales_Rep_Country = SRC_Sales_Rep_Country,",
				"          Prev_Sales_Rep_Country = Sales_Rep_Country,",
				"          Sales_Rep_Phone = SRC_Sales_Rep_Phone,",
				"          Prev_Sales_Rep_Phone = Sales_Rep_Phone,",
				"          SRC_Delete_Flg = \"Y\",",
				"          SRC_Date_Last_Modified = toTimestamp(currentDate()),",
				"          SRC_Last_Updated_By = \"IN1684\",",
				"          SRC_Last_Update_Timestamp = currentTimestamp()) ~> transformation2",
				"transformation2 select(mapColumn(",
				"          SRC_Sales_Rep_key,",
				"          SRC_Sales_Rep_ID,",
				"          SRC_Sales_Rep_Name,",
				"          SRC_Sales_Rep_Address,",
				"          SRC_Sales_Rep_Email,",
				"          SRC_Sales_Rep_Loginaccess,",
				"          SRC_Delete_Flg,",
				"          SRC_Create_Date,",
				"          SRC_Date_Last_Modified,",
				"          SRC_Created_By,",
				"          SRC_Created_Timestamp,",
				"          SRC_Last_Updated_By,",
				"          SRC_Last_Update_Timestamp,",
				"          Sales_Rep_City,",
				"          Prev_Sales_Rep_City,",
				"          Sales_Rep_Country,",
				"          Prev_Sales_Rep_Country,",
				"          Sales_Rep_Phone,",
				"          Prev_Sales_Rep_Phone",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> select5",
				"SRC select(mapColumn(",
				"          each(match(true()),",
				"               \"SRC_\"+$$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select6",
				"select4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Dim_SalesRep'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> TGTSales"
			]
		}
	}
}