{
	"name": "DF_Orders",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Src",
						"type": "DatasetReference"
					},
					"name": "SrcOrders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Src",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "OrdersSplit"
				},
				{
					"name": "union1"
				},
				{
					"name": "OrderType"
				},
				{
					"name": "RowNumber"
				},
				{
					"name": "HandlingDuplicates"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as string,",
				"          CustomerID as string,",
				"          ProductID as string,",
				"          OrderDate as date,",
				"          Amount as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcOrders",
				"SrcOrders split(OrderDate>addMonths(currentDate(),-12),",
				"     disjoint: false) ~> OrdersSplit@(RecentOrders, OldOrders)",
				"OrdersSplit@RecentOrders, OrdersSplit@OldOrders union(byName: true)~> union1",
				"union1 derive(Order_type = iif(OrderDate>addMonths(currentDate(), -12),'Recent','Old')) ~> OrderType",
				"OrderType window(over(OrderID),",
				"     desc(OrderDate, true),",
				"     ROW_NUMBER = rowNumber()) ~> RowNumber",
				"RowNumber filter(ROW_NUMBER ==1) ~> HandlingDuplicates",
				"HandlingDuplicates select(mapColumn(",
				"          OrderID,",
				"          CustomerID,",
				"          ProductID,",
				"          OrderDate,",
				"          Amount,",
				"          Order_type",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['AllOrders_Unioned_IN1677.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}