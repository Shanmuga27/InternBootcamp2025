{
	"name": "DF_Orders",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "Orders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "sink"
				}
			],
			"transformations": [
				{
					"name": "split1"
				},
				{
					"name": "OrderTypeRecent"
				},
				{
					"name": "OrderTypeOld"
				},
				{
					"name": "union"
				},
				{
					"name": "rank"
				},
				{
					"name": "removeduplicates"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as string,",
				"          CustomerID as string,",
				"          ProductID as string,",
				"          OrderDate as date,",
				"          Amount as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Orders",
				"Orders split(OrderDate > addMonths(currentDate(), -12),",
				"     disjoint: false) ~> split1@(RecentOrders, OldOrders)",
				"split1@RecentOrders derive(OrderType = \"Recent\") ~> OrderTypeRecent",
				"split1@OldOrders derive(OrderType = \"Old\") ~> OrderTypeOld",
				"OrderTypeRecent, OrderTypeOld union(byName: true,",
				"     partitionBy('hash', 1))~> union",
				"union window(rank = rowNumber()) ~> rank",
				"rank filter(rank == 1) ~> removeduplicates",
				"removeduplicates sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['AllOrders_Unioned_IN1684.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink"
			]
		}
	}
}