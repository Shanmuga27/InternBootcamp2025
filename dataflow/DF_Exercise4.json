{
	"name": "DF_Exercise4",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "SourceOrders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "AllOrdersUnioned"
				}
			],
			"transformations": [
				{
					"name": "split1"
				},
				{
					"name": "DerivedColumn1"
				},
				{
					"name": "DerivedColumn2"
				},
				{
					"name": "Union"
				},
				{
					"name": "RemoveDup"
				},
				{
					"name": "Filter"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as string,",
				"          CustomerID as string,",
				"          ProductID as string,",
				"          OrderDate as date,",
				"          Amount as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SourceOrders",
				"SourceOrders split(OrderDate> addMonths(currentDate(),12),",
				"     OrderDate< addMonths(currentDate(),-12),",
				"     disjoint: false) ~> split1@(RecentOrders, OldOrders)",
				"split1@RecentOrders derive({Order Type} = 'Recent') ~> DerivedColumn1",
				"split1@OldOrders derive({Order Type} = 'Old') ~> DerivedColumn2",
				"DerivedColumn1, DerivedColumn2 union(byName: true)~> Union",
				"Union window(over(OrderID),",
				"     desc(OrderDate, true),",
				"     rn = rowNumber()) ~> RemoveDup",
				"RemoveDup filter(rn==1) ~> Filter",
				"Filter sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['AllOrder_Unioned_IN1675.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> AllOrdersUnioned"
			]
		}
	}
}