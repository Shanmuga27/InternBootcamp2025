{
	"name": "DF_STG_TGT_customers_SCD2",
	"properties": {
		"folder": {
			"name": "IN1677_Mock"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Src",
						"type": "DatasetReference"
					},
					"name": "srcCustomers"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Src",
						"type": "DatasetReference"
					},
					"name": "tgtCustomers"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Src",
						"type": "DatasetReference"
					},
					"name": "sinkTgtCustomer"
				}
			],
			"transformations": [
				{
					"name": "SkCustomerKey"
				},
				{
					"name": "JoinSrcTgt"
				},
				{
					"name": "split1"
				},
				{
					"name": "selectColumns"
				},
				{
					"name": "Insert"
				},
				{
					"name": "Update"
				},
				{
					"name": "DcAuditcol"
				},
				{
					"name": "DcAuditcol1"
				},
				{
					"name": "unionSrcTgt"
				},
				{
					"name": "selectSrc"
				},
				{
					"name": "selectTgt"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CustomerID as integer,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Email as string,",
				"          Country as string,",
				"          CreatedDate as timestamp,",
				"          created_date as timestamp,",
				"          {created_by } as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcCustomers",
				"source(output(",
				"          customer_id as integer,",
				"          customer_key as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          customer_name as string,",
				"          email as string,",
				"          country as string,",
				"          isActive as string,",
				"          start_date as timestamp,",
				"          end_date as timestamp,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> tgtCustomers",
				"selectColumns keyGenerate(output(customer_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> SkCustomerKey",
				"SkCustomerKey, tgtCustomers join(CustomerID == customer_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinSrcTgt",
				"JoinSrcTgt split(isNull(customer_id)||(selectColumns@Country != tgtCustomers@country),",
				"     CustomerID==customer_id && (selectColumns@Country!=tgtCustomers@country),",
				"     disjoint: false) ~> split1@(insert, update)",
				"srcCustomers select(mapColumn(",
				"          CustomerID,",
				"          FirstName,",
				"          LastName,",
				"          Email,",
				"          Country,",
				"          created_date,",
				"          {created_by },",
				"          updated_date,",
				"          updated_by,",
				"          runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectColumns",
				"split1@insert alterRow(insertIf(true())) ~> Insert",
				"split1@update alterRow(updateIf(true())) ~> Update",
				"Insert derive(customer_name = concat(FirstName,' ',LastName),",
				"          isActive = 'Y',",
				"          start_date = currentTimestamp(),",
				"          end_date = toTimestamp(null()),",
				"          created_date = currentTimestamp(),",
				"          updated_date = toTimestamp(null()),",
				"          updated_by = toString(null())\r",
				") ~> DcAuditcol",
				"Update derive(isActive = 'N',",
				"          end_date = currentTimestamp(),",
				"          updated_date = currentTimestamp(),",
				"          updated_by = {created_by }) ~> DcAuditcol1",
				"selectSrc, selectTgt union(byName: true)~> unionSrcTgt",
				"DcAuditcol select(mapColumn(",
				"          CustomerID,",
				"          FirstName,",
				"          LastName,",
				"          Email = split1@insert@Email,",
				"          Country = split1@insert@Country,",
				"          created_date,",
				"          {created_by },",
				"          updated_date,",
				"          updated_by,",
				"          runid = split1@insert@runid,",
				"          customer_key = split1@insert@customer_key,",
				"          customer_id,",
				"          customer_key = split1@insert@customer_key,",
				"          first_name,",
				"          last_name,",
				"          customer_name,",
				"          email = split1@insert@email,",
				"          country = split1@insert@country,",
				"          isActive,",
				"          start_date,",
				"          end_date,",
				"          created_by,",
				"          runid = split1@insert@runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectSrc",
				"DcAuditcol1 select(mapColumn(",
				"          CustomerID,",
				"          FirstName,",
				"          LastName,",
				"          Email = split1@update@Email,",
				"          Country = split1@update@Country,",
				"          created_date = split1@update@created_date,",
				"          {created_by },",
				"          updated_date,",
				"          updated_by,",
				"          runid = split1@update@runid,",
				"          customer_key = split1@update@customer_key,",
				"          customer_id,",
				"          customer_key = split1@update@customer_key,",
				"          first_name,",
				"          last_name,",
				"          customer_name,",
				"          email = split1@update@email,",
				"          country = split1@update@country,",
				"          isActive,",
				"          start_date,",
				"          end_date,",
				"          created_date = split1@update@created_date,",
				"          created_by,",
				"          runid = split1@update@runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectTgt",
				"unionSrcTgt sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Dim_customers_IN1677'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          customer_id = CustomerID,",
				"          customer_key,",
				"          first_name = FirstName,",
				"          last_name = LastName,",
				"          customer_name,",
				"          email = unionSrcTgt@Email,",
				"          country = unionSrcTgt@Country,",
				"          isActive,",
				"          start_date,",
				"          end_date,",
				"          created_date,",
				"          created_by = {created_by },",
				"          updated_date,",
				"          updated_by,",
				"          runid",
				"     ),",
				"     partitionBy('hash', 1)) ~> sinkTgtCustomer"
			]
		}
	}
}