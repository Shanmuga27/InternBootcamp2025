{
	"name": "DF_SalesRep_SCD3_copy1",
	"properties": {
		"folder": {
			"name": "workshop/STG_DW"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "SRCsalesrep"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "TGTsalesrep"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "leftjoin1"
				},
				{
					"name": "selectTGT",
					"description": "Renaming TGTprod "
				},
				{
					"name": "derivedColumn1",
					"description": "Adding extra columns for scd3"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2",
					"description": "derivedUPD"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "select1"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Item_S_Key as integer,",
				"          Item_Id as integer,",
				"          Item_Descr as string,",
				"          Brand_Descr as string,",
				"          Artwork_Descr as string,",
				"          Color_Descr as string,",
				"          Package_Type_Descr as string,",
				"          Special_Req_Descr as string,",
				"          Case_Pack_Desccr as string,",
				"          Full_Name_Descr as string,",
				"          Display_Name_Descr as string,",
				"          Account_Manager_Name as string,",
				"          Brand_Name as string,",
				"          Brand_Manager_Name as string,",
				"          Item_Status_Descr as string,",
				"          Item_Type_Descr as string,",
				"          Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Master_Carton_Req_Descr as string,",
				"          Trade_Partner_Name as string,",
				"          Part_Of_Assembly_Item as string,",
				"          Type_Name as string,",
				"          Trade_Partner_Code as string,",
				"          Vendor_Name as string,",
				"          UPC_nbr as string,",
				"          On_Hand_Quantity as integer,",
				"          SSCC14_nbr as integer,",
				"          Master_Carton_Item_Nbr as integer,",
				"          Created_Date as timestamp,",
				"          Last_Modified_Date as timestamp,",
				"          Delete_Flag as string,",
				"          Active_Flag as string,",
				"          Created_Time as timestamp,",
				"          Created_By as string,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Updated_By as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCsalesrep",
				"source(output(",
				"          Item_S_Key as integer,",
				"          Item_Id as integer,",
				"          Item_Descr as string,",
				"          Brand_Descr as string,",
				"          Artwork_Descr as string,",
				"          Color_Descr as string,",
				"          Package_Type_Descr as string,",
				"          Special_Req_Descr as string,",
				"          Case_Pack_Desccr as string,",
				"          Full_Name_Descr as string,",
				"          Display_Name_Descr as string,",
				"          Account_Manager_Name as string,",
				"          Brand_Name as string,",
				"          Brand_Manager_Name as string,",
				"          Previous_Brand_Manager_Name as string,",
				"          Current_Brand_Manager_Name as string,",
				"          Item_Status_Descr as string,",
				"          Item_Type_Descr as string,",
				"          Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Previous_Product_Manager_Name as string,",
				"          Current_Product_Manager_Name as string,",
				"          Master_Carton_Req_Descr as string,",
				"          Trade_Partner_Name as string,",
				"          Part_Of_Assembly_Item as string,",
				"          Type_Name as string,",
				"          Trade_Partner_Code as string,",
				"          Vendor_Name as string,",
				"          UPC_nbr as string,",
				"          On_Hand_Quantity as integer,",
				"          SSCC14_nbr as integer,",
				"          Master_Carton_Item_Nbr as integer,",
				"          Created_Date as timestamp,",
				"          Last_Modified_Date as timestamp,",
				"          Delete_Flag as string,",
				"          Active_Flag as string,",
				"          Created_Time as timestamp,",
				"          Created_By as string,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Updated_By as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TGTsalesrep",
				"derivedColumn1, selectTGT join(SRCprod@Item_Id == selectTGT@Item_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> leftjoin1",
				"TGTsalesrep select(mapColumn(",
				"          Item_S_Key,",
				"          Item_Id,",
				"          Item_Descr,",
				"          Brand_Descr,",
				"          Artwork_Descr,",
				"          Color_Descr,",
				"          Package_Type_Descr,",
				"          Special_Req_Descr,",
				"          Case_Pack_Desccr,",
				"          Full_Name_Descr,",
				"          Display_Name_Descr,",
				"          Account_Manager_Name,",
				"          Brand_Name,",
				"          T_Brand_Manager_Name = Brand_Manager_Name,",
				"          T_Previous_Brand_Manager_Name = Previous_Brand_Manager_Name,",
				"          T_Current_Brand_Manager_Name = Current_Brand_Manager_Name,",
				"          Item_Status_Descr,",
				"          Item_Type_Descr,",
				"          Maker_Name,",
				"          T_Product_Manager_Name = Product_Manager_Name,",
				"          T_Previous_Product_Manager_Name = Previous_Product_Manager_Name,",
				"          T_Current_Product_Manager_Name = Current_Product_Manager_Name,",
				"          Master_Carton_Req_Descr,",
				"          Trade_Partner_Name,",
				"          Part_Of_Assembly_Item,",
				"          Type_Name,",
				"          Trade_Partner_Code,",
				"          Vendor_Name,",
				"          UPC_nbr,",
				"          On_Hand_Quantity,",
				"          SSCC14_nbr,",
				"          Master_Carton_Item_Nbr,",
				"          Created_Date,",
				"          Last_Modified_Date,",
				"          Delete_Flag,",
				"          Active_Flag,",
				"          Created_Time,",
				"          Created_By,",
				"          Last_Modified_Time,",
				"          Last_Updated_By",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectTGT",
				"SRCsalesrep derive(Previous_Brand_Manager_Name = toString(null()),",
				"          Current_Brand_Manager_Name = toString(null()),",
				"          Previous_Product_Manager_Name = toString(null()),",
				"          Current_Product_Manager_Name = toString(null())) ~> derivedColumn1",
				"leftjoin1 split(isNull(selectTGT@Item_Id),",
				"     (SRCprod@Item_Id == selectTGT@Item_Id) && ((Brand_Manager_Name != T_Brand_Manager_Name) || (Product_Manager_Name != T_Product_Manager_Name)),",
				"     disjoint: true) ~> split1@(InsertStream, UpdateStream)",
				"split1@UpdateStream derive(Current_Brand_Manager_Name = Brand_Manager_Name,",
				"          Previous_Brand_Manager_Name = Current_Brand_Manager_Name,",
				"          Brand_Manager_Name = T_Previous_Product_Manager_Name,",
				"          Current_Product_Manager_Name = Product_Manager_Name,",
				"          Previous_Product_Manager_Name = Current_Product_Manager_Name,",
				"          Product_Manager_Name = T_Previous_Product_Manager_Name) ~> derivedColumn2",
				"split1@InsertStream derive(Current_Brand_Manager_Name = Brand_Manager_Name) ~> derivedColumn3",
				"derivedColumn3 select(mapColumn(",
				"          Item_S_Key = split1@InsertStream@Item_S_Key,",
				"          Item_Id = split1@InsertStream@Item_Id,",
				"          Item_Descr = split1@InsertStream@Item_Descr,",
				"          Brand_Descr = split1@InsertStream@Brand_Descr,",
				"          Artwork_Descr = split1@InsertStream@Artwork_Descr,",
				"          Color_Descr = split1@InsertStream@Color_Descr,",
				"          Package_Type_Descr = split1@InsertStream@Package_Type_Descr,",
				"          Special_Req_Descr = split1@InsertStream@Special_Req_Descr,",
				"          Case_Pack_Desccr = split1@InsertStream@Case_Pack_Desccr,",
				"          Full_Name_Descr = split1@InsertStream@Full_Name_Descr,",
				"          Display_Name_Descr = split1@InsertStream@Display_Name_Descr,",
				"          Account_Manager_Name = split1@InsertStream@Account_Manager_Name,",
				"          Brand_Name = split1@InsertStream@Brand_Name,",
				"          Brand_Manager_Name,",
				"          Item_Status_Descr = split1@InsertStream@Item_Status_Descr,",
				"          Item_Type_Descr = split1@InsertStream@Item_Type_Descr,",
				"          Maker_Name = split1@InsertStream@Maker_Name,",
				"          Product_Manager_Name,",
				"          Master_Carton_Req_Descr = split1@InsertStream@Master_Carton_Req_Descr,",
				"          Trade_Partner_Name = split1@InsertStream@Trade_Partner_Name,",
				"          Part_Of_Assembly_Item = split1@InsertStream@Part_Of_Assembly_Item,",
				"          Type_Name = split1@InsertStream@Type_Name,",
				"          Trade_Partner_Code = split1@InsertStream@Trade_Partner_Code,",
				"          Vendor_Name = split1@InsertStream@Vendor_Name,",
				"          UPC_nbr = split1@InsertStream@UPC_nbr,",
				"          On_Hand_Quantity = split1@InsertStream@On_Hand_Quantity,",
				"          SSCC14_nbr = split1@InsertStream@SSCC14_nbr,",
				"          Master_Carton_Item_Nbr = split1@InsertStream@Master_Carton_Item_Nbr,",
				"          Created_Date = split1@InsertStream@Created_Date,",
				"          Last_Modified_Date = split1@InsertStream@Last_Modified_Date,",
				"          Delete_Flag = split1@InsertStream@Delete_Flag,",
				"          Active_Flag = split1@InsertStream@Active_Flag,",
				"          Created_Time = split1@InsertStream@Created_Time,",
				"          Created_By = split1@InsertStream@Created_By,",
				"          Last_Modified_Time = split1@InsertStream@Last_Modified_Time,",
				"          Last_Updated_By = split1@InsertStream@Last_Updated_By,",
				"          Previous_Brand_Manager_Name,",
				"          Current_Brand_Manager_Name,",
				"          Previous_Product_Manager_Name,",
				"          Current_Product_Manager_Name",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumn2 select(mapColumn(",
				"          Item_S_Key = split1@UpdateStream@Item_S_Key,",
				"          Item_Id = split1@UpdateStream@Item_Id,",
				"          Item_Descr = split1@UpdateStream@Item_Descr,",
				"          Brand_Descr = split1@UpdateStream@Brand_Descr,",
				"          Artwork_Descr = split1@UpdateStream@Artwork_Descr,",
				"          Color_Descr = split1@UpdateStream@Color_Descr,",
				"          Package_Type_Descr = split1@UpdateStream@Package_Type_Descr,",
				"          Special_Req_Descr = split1@UpdateStream@Special_Req_Descr,",
				"          Case_Pack_Desccr = split1@UpdateStream@Case_Pack_Desccr,",
				"          Full_Name_Descr = split1@UpdateStream@Full_Name_Descr,",
				"          Display_Name_Descr = split1@UpdateStream@Display_Name_Descr,",
				"          Account_Manager_Name = split1@UpdateStream@Account_Manager_Name,",
				"          Brand_Name = split1@UpdateStream@Brand_Name,",
				"          Brand_Manager_Name,",
				"          Item_Status_Descr = split1@UpdateStream@Item_Status_Descr,",
				"          Item_Type_Descr = split1@UpdateStream@Item_Type_Descr,",
				"          Maker_Name = split1@UpdateStream@Maker_Name,",
				"          Product_Manager_Name,",
				"          Master_Carton_Req_Descr = split1@UpdateStream@Master_Carton_Req_Descr,",
				"          Trade_Partner_Name = split1@UpdateStream@Trade_Partner_Name,",
				"          Part_Of_Assembly_Item = split1@UpdateStream@Part_Of_Assembly_Item,",
				"          Type_Name = split1@UpdateStream@Type_Name,",
				"          Trade_Partner_Code = split1@UpdateStream@Trade_Partner_Code,",
				"          Vendor_Name = split1@UpdateStream@Vendor_Name,",
				"          UPC_nbr = split1@UpdateStream@UPC_nbr,",
				"          On_Hand_Quantity = split1@UpdateStream@On_Hand_Quantity,",
				"          SSCC14_nbr = split1@UpdateStream@SSCC14_nbr,",
				"          Master_Carton_Item_Nbr = split1@UpdateStream@Master_Carton_Item_Nbr,",
				"          Created_Date = split1@UpdateStream@Created_Date,",
				"          Last_Modified_Date = split1@UpdateStream@Last_Modified_Date,",
				"          Delete_Flag = split1@UpdateStream@Delete_Flag,",
				"          Active_Flag = split1@UpdateStream@Active_Flag,",
				"          Created_Time = split1@UpdateStream@Created_Time,",
				"          Created_By = split1@UpdateStream@Created_By,",
				"          Last_Modified_Time = split1@UpdateStream@Last_Modified_Time,",
				"          Last_Updated_By = split1@UpdateStream@Last_Updated_By,",
				"          Previous_Brand_Manager_Name,",
				"          Current_Brand_Manager_Name,",
				"          Previous_Product_Manager_Name,",
				"          Current_Product_Manager_Name",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['SCD3_prod_tgt1.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['SCD3_prod_t2.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink2"
			]
		}
	}
}