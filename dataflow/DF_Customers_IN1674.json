{
	"name": "DF_Customers_IN1674",
	"properties": {
		"folder": {
			"name": "MockTest/SRC_to_STG"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "srcCus"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     pipname as string,",
				"     runid as string",
				"}",
				"source(output(",
				"          CustomerID as integer,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Email as string,",
				"          Country as string,",
				"          CreatedDate as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcCus",
				"srcCus derive({created by } = $pipname,",
				"          {updated date} = currentDate(),",
				"          {updated by} = $pipname,",
				"          runid = $runid) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          customer_id = CustomerID,",
				"          first_name = FirstName,",
				"          last_name = LastName,",
				"          email = Email,",
				"          country = Country,",
				"          {created date} = CreatedDate,",
				"          {created by },",
				"          {updated date},",
				"          {updated by},",
				"          runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}