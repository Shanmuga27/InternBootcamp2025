{
	"name": "DF_stg_to_tgt_customers_m",
	"properties": {
		"folder": {
			"name": "Repractise"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "surrogateKey1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				},
				{
					"name": "join1"
				},
				{
					"name": "split1"
				},
				{
					"name": "select2"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "join2"
				},
				{
					"name": "split2"
				},
				{
					"name": "select3"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "alterRow2"
				},
				{
					"name": "select4"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename1 as string,",
				"     filename2 as string",
				"}",
				"source(output(",
				"          customer_id as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          email as string,",
				"          country as string,",
				"          {created date} as timestamp,",
				"          {created by } as string,",
				"          {updated date} as timestamp,",
				"          {updated by} as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          customer_id as integer,",
				"          customer_key as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          customer_name as string,",
				"          email as string,",
				"          country as string,",
				"          isActive as string,",
				"          start_date as string,",
				"          end_date as string,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"source1 keyGenerate(output(customer_key as long),",
				"     startAt: L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1 derive(customer_name = concat(first_name, last_name)) ~> derivedColumn1",
				"source2 select(mapColumn(",
				"          tgt_customer_id = customer_id,",
				"          tgt_customer_key = customer_key,",
				"          tgt_first_name = first_name,",
				"          tgt_last_name = last_name,",
				"          tgt_customer_name = customer_name,",
				"          tgt_email = email,",
				"          tgt_country = country,",
				"          tgt_isActive = isActive,",
				"          tgt_start_date = start_date,",
				"          tgt_end_date = end_date,",
				"          tgt_created_date = created_date,",
				"          tgt_created_by = created_by,",
				"          tgt_updated_date = updated_date,",
				"          tgt_updated_by = updated_by,",
				"          tgt_runid = runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumn1, select1 join(customer_id == tgt_customer_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 split(isNull(tgt_customer_id) || !isNull(tgt_customer_id) && (tgt_country!=country && tgt_isActive == 'Y'),",
				"     disjoint: false) ~> split1@(insert)",
				"split1@insert select(mapColumn(",
				"          customer_id,",
				"          first_name,",
				"          last_name,",
				"          email,",
				"          country,",
				"          created_date = {created date},",
				"          {created_by } = {created by },",
				"          updated_date = {updated date},",
				"          updated_by = {updated by},",
				"          runid,",
				"          customer_key,",
				"          customer_name",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 derive(isActive = 'Y',",
				"          start_date = currentTimestamp()) ~> derivedColumn2",
				"select1, source1 join(tgt_customer_id == customer_id,",
				"     joinType:'right',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2 split(!isNull(tgt_customer_id) && (tgt_country!=country && tgt_isActive == 'Y'),",
				"     disjoint: false) ~> split2@(update)",
				"split2@update select(mapColumn(",
				"          customer_id = tgt_customer_id,",
				"          customer_key = tgt_customer_key,",
				"          first_name = tgt_first_name,",
				"          last_name = tgt_last_name,",
				"          customer_name = tgt_customer_name,",
				"          email = tgt_email,",
				"          country = tgt_country,",
				"          start_date = tgt_start_date,",
				"          created_by = tgt_created_by,",
				"          updated_date = tgt_updated_date,",
				"          updated_by = tgt_updated_by,",
				"          runid = tgt_runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3 derive(end_date = currentTimestamp(),",
				"          isActive = 'N') ~> derivedColumn3",
				"derivedColumn2 alterRow(insertIf(true())) ~> alterRow1",
				"derivedColumn3 alterRow(updateIf(true())) ~> alterRow2",
				"alterRow1 select(mapColumn(",
				"          customer_id,",
				"          first_name,",
				"          last_name,",
				"          email,",
				"          country,",
				"          created_date,",
				"          {created_by },",
				"          updated_date,",
				"          updated_by,",
				"          runid,",
				"          customer_key,",
				"          customer_name,",
				"          isActive,",
				"          start_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     partitionFileNames:[($filename1)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1",
				"alterRow2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     partitionFileNames:[($filename2)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink2"
			]
		}
	}
}