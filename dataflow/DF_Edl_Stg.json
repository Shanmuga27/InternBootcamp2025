				},
				{
					"name": "JoinSalesRep"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Customer_Id as integer,",
				"          Customer_key as integer,",
				"          Company_Name as string,",
				"          Delete_Flg as string,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          Active_Flag as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> EdlCustomers",
				"source(output(",
				"          Location_Id as integer,",
				"          Location_key as integer,",
				"          Name as string,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Zipcode as integer,",
				"          Delete_Flg as string,",
				"          Active_Flag as string,",
				"          Date_Last_Modified as string,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> EdlLocation",
				"source(output(",
				"          Item_Id as integer,",
				"          Items_key as integer,",
				"          Generic_Description as string,",
				"          PurchaseDescription as string,",
				"          Artwork as string,",
				"          Color as string,",
				"          Package_Type as string,",
				"          Special_Requirements as string,",
				"          Case_Pack as string,",
				"          Full_Name as string,",
				"          Display_Name as string,",
				"          Account_Manager_Name as string,",
				"          Brand_Name as string,",
				"          Brand_Manager_Name as string,",
				"          Item_Status as string,",
				"          Item_Type as string,",
				"          Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Master_Carton_Rqmnts as string,",
				"          Trade_Partner_Name as string,",
				"          Type_Name as string,",
				"          Trade_Partner_Code as string,",
				"          VendorName as string,",
				"          UPC as string,",
				"          QunatityOnHand as string,",
				"          SSCC14 as string,",
				"          Master_Carton_Markings_Item_N as string,",
				"          Part_Of_Assembly_Item as string,",
				"          Delete_flg as string,",
				"          Active_Flag as string,",
				"          Create_Date as timestamp,",
				"          Date_last_modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as timestamp,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> EdlProduct",
				"source(output(",
				"          Sales_Rep_Id as integer,",
				"          SalesReps_key as integer,",
				"          Sales_Rep_Name as string,",
				"          Address as string,",
				"          City as string,",
				"          Country as string,",
				"          Email as string,",
				"          LoginAccess as boolean,",
				"          Phone as string,",
				"          Delete_flg as string,",
				"          Active_Flag as string,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> EdlSalesReps",
				"source(output(",
				"          Estimate_key as integer,",
				"          Transaction_Id as integer,",
				"          Transaction_Line_Id as integer,",
				"          Memo as string,",
				"          Sticker_Requirements as string,",
				"          Inner_Requirements as string,",
				"          Customer_Requirements as string,",
				"          Sales_Program as string,",
				"          Buyer_Dept as string,",
				"          Buyer_Confirmed_On as string,",
				"          Dept_Program as string,",
				"          Program_0 as string,",
				"          Cancelled as string,",
				"          Confidence_Factor_Id as integer,",
				"          Company_Id as integer,",
				"          Item_Id as integer,",
				"          Location_Id as integer,",
				"          Sales_Rep_Id as integer,",
				"          TranId as string,",
				"          Price_Sticker_Id as integer,",
				"          Po as string,",
				"          Release_Order_Number as string,",
				"          Quantity_Received_In_Shipment as integer,",
				"          Cntnr_ as string,",
				"          Etd_Ship_Date as timestamp,",
				"          Ship_Date_Outbound as timestamp,",
				"          Cancel_Date_Outbound as timestamp,",
				"          Expiration_Date as timestamp,",
				"          Item_Count as integer,",
				"          Inner_Qty as string,",
				"          Release_Quantity as string,",
				"          Item_Unit_Price as string,",
				"          Amount as string,",
				"          Eta_Arrival_Date as string,",
				"          Delete_Flag as string,",
				"          Create_Date as timestamp,",
				"          Date_Created as timestamp,",
				"          Date_Last_Modified_Gmt as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> EdlEstimateToStgEstimate",
				"derivedColumn2 derive(each(match(type=='string'), $$ = iif(isNull($$)||lower($$)=='null', 'UNK', $$)),",
				"          each(match(type=='timestamp'), $$ = iifNull($$, toTimestamp('1900-01-01 00:00:00'))),",
				"          each(match(type=='integer'), $$ = iifNull($$, 0, $$))) ~> derivedColumn1",
				"EdlCustomers derive(Date_Last_Modified = toTimestamp(currentDate()),",
				"          Last_Updated_By = 'IN1677',",
				"          Last_Update_Timestamp = currentTimestamp()) ~> derivedColumn2",
				"EdlLocation derive(Date_Last_Modified = toTimestamp(currentDate()),",
				"          Last_Updated_By = 'IN1677',",
				"          Last_Update_Timestamp = currentTimestamp()) ~> derivedColumn3",
				"derivedColumn3 derive(each(match(type=='string'), $$ = iif(isNull($$)||lower($$)=='null', 'UNK', $$)),",
				"          each(match(type=='timestamp'), $$ = iifNull($$, toTimestamp('1900-01-01 00:00:00'))),",
				"          each(match(type=='integer'), $$ = iifNull($#, 0))) ~> derivedColumn4",
				"EdlProduct derive(Date_last_modified = toTimestamp(currentDate()),",
				"          Last_Updated_By = 'IN1677',",
				"          Last_Update_Timestamp = currentTimestamp()) ~> derivedColumn5",
				"derivedColumn5 derive(each(match(type=='string'), $$ = iif(isNull($$)||lower($$)=='null', 'UNK', $$)),",
				"          each(match(type=='timestamp'), $$ = iifNull($$, toTimestamp('1900-01-01 00:00:00'))),",
				"          each(match(type=='integer'), $$ = iifNull($#, 0))) ~> derivedColumn6",
				"EdlSalesReps derive(Date_Last_Modified = toTimestamp(currentDate()),",
				"          Last_Updated_By = 'IN1677',",
				"          Last_Update_Timestamp = currentTimestamp()) ~> derivedColumn7",
				"derivedColumn7 derive(each(match(type=='string'), $$ = iif(isNull($$)||lower($$)=='null', 'UNK', $$)),",
				"          each(match(type=='timestamp'), $$ = iifNull($$, toTimestamp('1900-01-01 00:00:00'))),",
				"          each(match(type=='integer'), $$ = iifNull($#, 0))) ~> derivedColumn8",
				"select1 derive(Date_Last_Modified_Gmt = currentUTC(),",
				"          Last_Updated_By = 'IN1677',",
				"          Last_Update_Timestamp = currentTimestamp()) ~> Update",
				"Update derive(Sticker_Requirement_Purchase_descr = iif(Sticker_Requirements=='0','No Stickers' , \r",
				"    iif(Inner_Requirements=='0' && Customer_Requirements=='0',Sticker_Requirements , \r",
				"        iif(Customer_Requirements=='0', Sticker_Requirements, 'unk'))),",
				"          Confidence_Factor_descr = toString(\r",
				"  iif(Confidence_Factor_Id == 1, '25%',\r",
				"  iif(Confidence_Factor_Id == 2, '50%',\r",
				"  iif(Confidence_Factor_Id == 3, '75%',\r",
				"  iif(Confidence_Factor_Id == 4, '90%',\r",
				"  iif(Confidence_Factor_Id == 5, 'Dropped',\r",
				"  iif(Confidence_Factor_Id == 6, 'Actual',\r",
				"  iif(Confidence_Factor_Id == 7, '90%-Pre',\r",
				"  iif(Confidence_Factor_Id == 8, '90%-Releases', 'unk')\r",
				"  )))))))\r",
				"),",
				"          Final_Destination_Container = concat(City, Name),",
				"          PRICE_STICKER_descr = case(like(Sticker_Requirements,'%$%price sticker'),replace(replace(Sticker_Requirements,'$',''),' price sticker',''), 'No Sticker'),",
				"          Month_Ship_dt = concat(toString(year(Ship_Date_Outbound)),'-',toString(month(Ship_Date_Outbound))),",
				"          ETD_dt = iif(\r",
				"    like(Name,'%DotCom Distribution - Edison NJ%'), subDays(toDate(Ship_Date_Outbound),66),\r",
				"    iif(like(Name,'%Berkley%'), subDays(toDate(Ship_Date_Outbound),59),\r",
				"    iif(like(Name,'%POE China%'), subDays(toDate(Ship_Date_Outbound),14),\r",
				"    iif(like(Name,'%POE OAK%'), subDays(toDate(Ship_Date_Outbound),59),\r",
				"    iif(like(Name,'%POE Vietnam%'), subDays(toDate(Ship_Date_Outbound),14)\r",
				"    ,subDays(toDate(Ship_Date_Outbound),45)\r",
				"\r",
				")))))\r",
				"\r",
				",",
				"          MS_Domestic_Ship_Date = subDays(Etd_Ship_Date, 45),",
				"          MS_Domestic_Cancel_Date = addDays(Etd_Ship_Date, 55)) ~> DerivedCol1",
				"DerivedCol1 derive(Level_Descr = case(\r",
				"    Confidence_Factor_descr=='25%', '', \r",
				"    Confidence_Factor_descr=='50%','',\r",
				"    Confidence_Factor_descr=='Dropped','',\r",
				"    Confidence_Factor_descr=='75%','Pending Confirmation',\r",
				"    Confidence_Factor_descr=='90%','Pending Approval%',\r",
				"    Confidence_Factor_descr=='Actual','Confirmed',\r",
				"    Confidence_Factor_descr=='90%-pre','Confirmed',\r",
				"    Confidence_Factor_descr=='90%-Releases','Confirmed','unk'),",
				"          Month_ETD_dt = concat(toString(year(ETD_dt)),'-',toString(month(ETD_dt)))) ~> DerivedCol2",
				"EdlEstimateToStgEstimate, EdlLocation join(EdlEstimateToStgEstimate@Location_Id == EdlLocation@Location_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinLocation",
				"JoinSalesRep select(mapColumn(",
				"          Estimate_key,",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo,",
				"          Sticker_Requirements,",
				"          Inner_Requirements,",
				"          Customer_Requirements,",
				"          Sales_Program,",
				"          Buyer_Dept,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program,",
				"          Program_0,",
				"          Cancelled,",
				"          Confidence_Factor_Id,",
				"          Company_Id,",
				"          Item_Id = EdlEstimateToStgEstimate@Item_Id,",
				"          Location_Id = EdlEstimateToStgEstimate@Location_Id,",
				"          Sales_Rep_Id = EdlEstimateToStgEstimate@Sales_Rep_Id,",
				"          TranId,",
				"          Price_Sticker_Id,",
				"          Po,",
				"          Release_Order_Number,",
				"          Quantity_Received_In_Shipment,",
				"          Cntnr_,",
				"          Etd_Ship_Date,",
				"          Ship_Date_Outbound,",
				"          Cancel_Date_Outbound,",
				"          Expiration_Date,",
				"          Item_Count,",
				"          Inner_Qty,",
				"          Release_Quantity,",
				"          Item_Unit_Price,",
				"          Amount,",
				"          Eta_Arrival_Date,",
				"          Delete_Flag,",
				"          Create_Date = EdlEstimateToStgEstimate@Create_Date,",
				"          Date_Created,",
				"          Date_Last_Modified_Gmt,",
				"          Created_By = EdlEstimateToStgEstimate@Created_By,",
				"          Created_Timestamp = EdlEstimateToStgEstimate@Created_Timestamp,",
				"          Last_Updated_By = EdlEstimateToStgEstimate@Last_Updated_By,",
				"          Last_Update_Timestamp = EdlEstimateToStgEstimate@Last_Update_Timestamp,",
				"          Location_Id = EdlLocation@Location_Id,",
				"          Location_key,",
				"          Name,",
				"          Country = EdlLocation@Country,",
				"          City = EdlLocation@City,",
				"          State,",
				"          Zipcode,",
				"          Delete_Flg = EdlLocation@Delete_Flg,",
				"          Active_Flag = EdlLocation@Active_Flag,",
				"          Date_Last_Modified = EdlLocation@Date_Last_Modified,",
				"          Created_By = EdlLocation@Created_By,",
				"          Created_Timestamp = EdlLocation@Created_Timestamp,",
				"          Last_Updated_By = EdlLocation@Last_Updated_By,",
				"          Last_Update_Timestamp = EdlLocation@Last_Update_Timestamp,",
				"          Customer_Id,",
				"          Customer_key,",
				"          Company_Name,",
				"          Delete_Flg = EdlCustomers@Delete_Flg,",
				"          Create_Date = EdlCustomers@Create_Date,",
				"          Date_Last_Modified = EdlCustomers@Date_Last_Modified,",
				"          Created_By = EdlCustomers@Created_By,",
				"          Created_Timestamp = EdlCustomers@Created_Timestamp,",
				"          Last_Updated_By = EdlCustomers@Last_Updated_By,",
				"          Last_Update_Timestamp = EdlCustomers@Last_Update_Timestamp,",
				"          Active_Flag = EdlCustomers@Active_Flag,",
				"          Item_Id = EdlProduct@Item_Id,",
				"          Items_key,",
				"          Generic_Description,",
				"          PurchaseDescription,",
				"          Artwork,",
				"          Color,",
				"          Package_Type,",
				"          Special_Requirements,",
				"          Case_Pack,",
				"          Full_Name,",
				"          Display_Name,",
				"          Account_Manager_Name,",
				"          Brand_Name,",
				"          Brand_Manager_Name,",
				"          Item_Status,",
				"          Item_Type,",
				"          Maker_Name,",
				"          Product_Manager_Name,",
				"          Master_Carton_Rqmnts,",
				"          Trade_Partner_Name,",
				"          Type_Name,",
				"          Trade_Partner_Code,",
				"          VendorName,",
				"          UPC,",
				"          QunatityOnHand,",
				"          SSCC14,",
				"          Master_Carton_Markings_Item_N,",
				"          Part_Of_Assembly_Item,",
				"          Delete_flg = EdlProduct@Delete_flg,",
				"          Active_Flag = EdlProduct@Active_Flag,",
				"          Create_Date = EdlProduct@Create_Date,",
				"          Date_last_modified = EdlProduct@Date_last_modified,",
				"          Created_By = EdlProduct@Created_By,",
				"          Created_Timestamp = EdlProduct@Created_Timestamp,",
				"          Last_Updated_By = EdlProduct@Last_Updated_By,",
				"          Last_Update_Timestamp = EdlProduct@Last_Update_Timestamp,",
				"          Sales_Rep_Id = EdlSalesReps@Sales_Rep_Id,",
				"          SalesReps_key,",
				"          Sales_Rep_Name,",
				"          Address,",
				"          City = EdlSalesReps@City,",
				"          Country = EdlSalesReps@Country,",
				"          Email,",
				"          LoginAccess,",
				"          Phone,",
				"          Delete_flg = EdlSalesReps@Delete_flg,",
				"          Active_Flag = EdlSalesReps@Active_Flag,",
				"          Create_Date = EdlSalesReps@Create_Date,",
				"          Date_Last_Modified = EdlSalesReps@Date_Last_Modified,",
				"          Created_By = EdlSalesReps@Created_By,",
				"          Created_Timestamp = EdlSalesReps@Created_Timestamp,",
				"          Last_Updated_By = EdlSalesReps@Last_Updated_By,",
				"          Last_Update_Timestamp = EdlSalesReps@Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"JoinLocation, EdlCustomers join(Company_Id == Customer_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinToCustomers",
				"JoinToCustomers, EdlProduct join(EdlEstimateToStgEstimate@Item_Id == EdlProduct@Item_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinToProduct",
				"DerivedCol2 derive(each(match(type=='string'), $$ = iif(isNull($$) || $$ == 'NULL', 'UNK', $$)),",
				"          each(match(type=='timestamp'), $$ = iifNull($$,toTimestamp('1900-01-01 00:00:00'), $$)),",
				"          each(match(type=='integer'), $$ = iifNull($#, 0, $#))) ~> NullHandling",
				"JoinToProduct, EdlSalesReps join(EdlEstimateToStgEstimate@Sales_Rep_Id == EdlSalesReps@Sales_Rep_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinSalesRep",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['STG_Customer'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          Customer_Id,",
				"          Customer_key,",
				"          Company_Name,",
				"          Delete_Flg,",
				"          Create_Date,",
				"          Date_Last_Modified,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp,",
				"          Active_Flag",
				"     ),",
				"     partitionBy('hash', 1)) ~> StgCustomer",
				"derivedColumn4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['STG_Location'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          Location_Id,",
				"          Location_key,",
				"          Location_Name = Name,",
				"          Location_Country = Country,",
				"          Location_City = City,",
				"          Location_State = State,",
				"          Location_Zipcode = Zipcode,",
				"          Delete_Flg,",
				"          Active_Flag,",
				"          Created_Date = Date_Last_Modified,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     partitionBy('hash', 1)) ~> StgLocation",
				"derivedColumn6 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['STG_Product'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          Item_Id,",
				"          Item_key = Items_key,",
				"          Items_Descr = Generic_Description,",
				"          Brand_descr = PurchaseDescription,",
				"          Artwork_descr = Artwork,",
				"          Color_descr = Color,",
				"          Package_Type_descr = Package_Type,",
				"          Special_Req_descr = Special_Requirements,",
				"          Case_Pack_descr = Case_Pack,",
				"          Full_Name_descr = Full_Name,",
				"          Display_Name_descr = Display_Name,",
				"          Account_Manager_Name,",
