{
	"name": "DF_Date_Format",
	"properties": {
		"folder": {
			"name": "QA"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SRCorders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SNKOrderDate"
				}
			],
			"transformations": [
				{
					"name": "DataFormat"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as short,",
				"          order_key as short,",
				"          customer_id as short,",
				"          order_amount as short,",
				"          order_date as string,",
				"          status as string,",
				"          {created date} as date,",
				"          {created by} as string,",
				"          {updated date} as date,",
				"          {updated by} as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCorders",
				"SRCorders filter(isNull(toTimestamp(trim(order_date), 'yyyy-MM-dd'))\r",
				") ~> DataFormat",
				"DataFormat sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['orderdate'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SNKOrderDate"
			]
		}
	}
}