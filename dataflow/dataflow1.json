{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "file1",
						"type": "DatasetReference"
					},
					"name": "baselineorders"
				},
				{
					"dataset": {
						"referenceName": "DelimitedText5",
						"type": "DatasetReference"
					},
					"name": "deltaorders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "updated_baseline",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "unionallorders"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as string,",
				"          car_id as string,",
				"          customer_id as string,",
				"          order_start_dt as string,",
				"          order_close_dt as string,",
				"          status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> baselineorders",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> deltaorders",
				"baselineorders, deltaorders union(byName: true)~> unionallorders",
				"unionallorders sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}