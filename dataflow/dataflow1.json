{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "file1",
						"type": "DatasetReference"
					},
					"name": "baselineorders"
				},
				{
					"dataset": {
						"referenceName": "DelimitedText5",
						"type": "DatasetReference"
					},
					"name": "deltaorders"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "union1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as string,",
				"          car_id as string,",
				"          customer_id as string,",
				"          order_start_dt as string,",
				"          order_close_dt as string,",
				"          status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> baselineorders",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> deltaorders",
				"baselineorders, deltaorders union(byName: true)~> union1",
				"union1 filter(ERROR_FUNCTION('')) ~> filter1"
			]
		}
	}
}