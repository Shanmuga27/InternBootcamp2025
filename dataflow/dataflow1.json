{
	"name": "dataflow1",
	"properties": {
		"folder": {
			"name": "Workshop/EDL - STG"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "EDLCustomer"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "EDLLocation"
				},
				{
					"name": "source3"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "STGCustomer"
				},
				{
					"name": "sink2"
				},
				{
					"name": "sink3"
				}
			],
			"transformations": [
				{
					"name": "NullHandling1"
				},
				{
					"name": "HandleEmpty1"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "derivedColumn6"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Customer_Id as integer,",
				"          Customer_key as integer,",
				"          Company_Name as string,",
				"          Delete_Flg as string,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          Active_Flag as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> EDLCustomer",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> EDLLocation",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> source3",
				"HandleEmpty1 derive(each(match(type=='string'), $$ = \r",
				"iif(isNull($$) || $$ == 'NULL', 'UNK', $$)\r",
				"),",
				"          each(match(type == 'integer'), $$ = iifNull($#, 0)),",
				"          each(match(type == 'timestamp'), $$ = iifNull($$, toTimestamp('1900-01-01 00:00:00', 'dd-MM-yyyy HH:mm:ss')))) ~> NullHandling1",
				"EDLCustomer derive(Date_Last_Modified = toTimestamp(currentDate()),",
				"          Last_Updated_By = \"IN1684\",",
				"          Last_Update_Timestamp = currentTimestamp()) ~> HandleEmpty1",
				"EDLLocation derive() ~> derivedColumn3",
				"derivedColumn3 derive() ~> derivedColumn4",
				"source3 derive() ~> derivedColumn5",
				"derivedColumn5 derive() ~> derivedColumn6",
				"NullHandling1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['STG_Customer'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> STGCustomer",
				"derivedColumn4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink2",
				"derivedColumn6 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink3"
			]
		}
	}
}