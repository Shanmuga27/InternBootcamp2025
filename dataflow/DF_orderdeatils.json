{
	"name": "DF_orderdeatils",
	"properties": {
		"folder": {
			"name": "IN1677_Mock"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"name": "src"
				},
				{
					"name": "tgt"
				}
			],
			"sinks": [
				{
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "sk"
				},
				{
					"name": "join1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> src",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> tgt",
				"src keyGenerate(output(order_details_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> sk",
				"sk, tgt join(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 split(ERROR_FUNCTION(''),",
				"     disjoint: false) ~> split1@(insert)",
				"split1@insert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}