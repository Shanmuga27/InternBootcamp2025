{
	"name": "DF_STGProducts_IN1674",
	"properties": {
		"folder": {
			"name": "MockTest/STG_to_TRG"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "product"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "surrogateKey1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          product_id as short,",
				"          product_name as string,",
				"          category as string,",
				"          price as integer,",
				"          {created date} as date,",
				"          {created by } as string,",
				"          {updated date} as date,",
				"          {updated by} as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> product",
				"product keyGenerate(output(product_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1 derive(product_name = initCap(product_name),",
				"          isActive = \"yes\",",
				"          start_date = currentDate(),",
				"          end_date = \"1990-01-01\") ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          product_id,",
				"          product_name,",
				"          category,",
				"          price,",
				"          {created date},",
				"          {created by },",
				"          {updated date},",
				"          {updated by},",
				"          runid,",
				"          product_key,",
				"          isActive,",
				"          start_date,",
				"          end_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}