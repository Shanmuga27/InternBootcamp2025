{
	"name": "DF_Nullcheck",
	"properties": {
		"folder": {
			"name": "Testing"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "TGTdimcustomers"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "SNKnullcustomers"
				}
			],
			"transformations": [
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          customer_id as integer,",
				"          customer_key as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          customer_name as string,",
				"          email as string,",
				"          country as string,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string,",
				"          isActive as boolean,",
				"          start_date as timestamp,",
				"          end_date as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TGTdimcustomers",
				"TGTdimcustomers split(isNull(customer_name),",
				"     disjoint: true) ~> split1@(Null, NotNull)",
				"split1@Null sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['test_null_customers.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SNKnullcustomers"
			]
		}
	}
}