{
	"name": "DF_products_full",
	"properties": {
		"folder": {
			"name": "practice"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "srcStgProducts"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "SNKproducts"
				}
			],
			"transformations": [
				{
					"name": "transformation"
				},
				{
					"name": "surrogateProductKey"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ProductID as integer,",
				"          ProductName as string,",
				"          Category as string,",
				"          Price as string,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcStgProducts",
				"srcStgProducts derive(ProductName = initCap(ProductName),",
				"          isActive = 'Y',",
				"          start_date = currentTimestamp(),",
				"          end_date = toTimestamp(null())) ~> transformation",
				"transformation keyGenerate(output(Product_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateProductKey",
				"surrogateProductKey sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Dim_products_IN1685.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SNKproducts"
			]
		}
	}
}