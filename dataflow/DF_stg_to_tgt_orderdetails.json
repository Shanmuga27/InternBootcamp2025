{
	"name": "DF_stg_to_tgt_orderdetails",
	"properties": {
		"folder": {
			"name": "Repractise"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "SRCorders"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "SNKorders"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "join1"
				},
				{
					"name": "select2"
				},
				{
					"name": "surrogateKey1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename as string",
				"}",
				"source(output(",
				"          orderdetail_id as integer,",
				"          order_id as integer,",
				"          product_id as integer,",
				"          quantity as integer,",
				"          {created date} as string,",
				"          {created by } as string,",
				"          {updated date} as string,",
				"          {updated by} as string,",
				"          { runid} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCorders",
				"source(output(",
				"          orderdetail_id as integer,",
				"          orderdetail_key as integer,",
				"          order_id as integer,",
				"          product_id as integer,",
				"          quantity as integer,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 select(mapColumn(",
				"          tgt_orderdetail_id = orderdetail_id,",
				"          tgt_orderdetail_key = orderdetail_key,",
				"          tgt_order_id = order_id,",
				"          tgt_product_id = product_id,",
				"          tgt_quantity = quantity,",
				"          tgt_created_date = created_date,",
				"          tgt_created_by = created_by,",
				"          tgt_updated_date = updated_date,",
				"          tgt_updated_by = updated_by,",
				"          tgt_runid = runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"surrogateKey1, select1 join(orderdetail_id == tgt_orderdetail_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"split1@insert select(mapColumn(",
				"          orderdetail_id,",
				"          order_id,",
				"          product_id,",
				"          quantity,",
				"          {created date},",
				"          {created by },",
				"          {updated date},",
				"          {updated by},",
				"          { runid},",
				"          {orderdetail_key     }",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"SRCorders keyGenerate(output({orderdetail_key     } as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"join1 split(isNull(tgt_orderdetail_id),",
				"     disjoint: false) ~> split1@(insert)",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     partitionFileNames:[($filename)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SNKorders"
			]
		}
	}
}