{
	"name": "DF_stg_to_tgt_orderdetails",
	"properties": {
		"folder": {
			"name": "Repractise"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "SRCorders"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "SNKorders"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "join1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename as string",
				"}",
				"source(output(",
				"          orderdetail_id as integer,",
				"          order_id as integer,",
				"          product_id as integer,",
				"          quantity as integer,",
				"          {created date} as string,",
				"          {created by } as string,",
				"          {updated date} as string,",
				"          {updated by} as string,",
				"          { runid} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCorders",
				"source(output(",
				"          order_id as integer,",
				"          order_key as integer,",
				"          customer_id as string,",
				"          order_amount as string,",
				"          order_date as timestamp,",
				"          status as string,",
				"          create_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 select(mapColumn(",
				"          tgt_order_id = order_id,",
				"          tgt_order_key = order_key,",
				"          tgt_customer_id = customer_id,",
				"          tgt_order_amount = order_amount,",
				"          tgt_order_date = order_date,",
				"          tgt_status = status,",
				"          tgt_create_date = create_date,",
				"          tgt_created_by = created_by,",
				"          tgt_updated_date = updated_date,",
				"          tgt_updated_by = updated_by,",
				"          tgt_runid = runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"SRCorders, select1 join(order_id == tgt_order_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 filter(isNull(order_id)) ~> filter1",
				"filter1 select(mapColumn(",
				"          order_id,",
				"          customer_id,",
				"          order_amount,",
				"          order_date,",
				"          status,",
				"          {created date},",
				"          {created by },",
				"          {updated date},",
				"          {updated by},",
				"          { runid}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     partitionFileNames:[($filename)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SNKorders"
			]
		}
	}
}