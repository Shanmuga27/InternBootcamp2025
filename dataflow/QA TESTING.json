{
	"name": "QA TESTING",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_IN1689",
						"type": "DatasetReference"
					},
					"name": "METADATASET"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "NULLCHECK"
				},
				{
					"name": "DISTCOLUMN"
				},
				{
					"name": "lookup1"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> METADATASET",
				"METADATASET derive({CUSTOMER ID} = ERROR_FUNCTION('')) ~> NULLCHECK",
				"NULLCHECK aggregate(groupBy({CUSTOMER ID}),",
				"     {CUSTOMER ID} = ERROR_FUNCTION('COUNT(DISTINCT CUSTOMER ID)')) ~> DISTCOLUMN",
				"DISTCOLUMN lookup(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1"
			]
		}
	}
}