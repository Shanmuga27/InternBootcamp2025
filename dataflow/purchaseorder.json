{
	"name": "purchaseorder",
	"properties": {
		"folder": {
			"name": "workshop/EDL_STG"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "src1"
				},
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "sourceProducts"
				},
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "sourceLOCATIONS"
				},
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "sourceSALESREP"
				},
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "sourceCUST"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derv",
					"description": "last modified values"
				},
				{
					"name": "join1"
				},
				{
					"name": "join2loc"
				},
				{
					"name": "ESTjoinSALESREP"
				},
				{
					"name": "selectPROD"
				},
				{
					"name": "selectLOCATIONS"
				},
				{
					"name": "selectSALESREP"
				},
				{
					"name": "select1"
				},
				{
					"name": "derived1",
					"description": "derived columns tranf"
				},
				{
					"name": "derived2",
					"description": "derived columns tranf"
				},
				{
					"name": "selectCUST"
				},
				{
					"name": "CUSTjoin"
				},
				{
					"name": "derivedNULL",
					"description": "NULL"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename as string (\"\")",
				"}",
				"source(output(",
				"          Transaction_Id as integer,",
				"          Transaction_Line_Id as integer,",
				"          Memo as string,",
				"          Sticker_Requirements as string,",
				"          Inner_Requirements as string,",
				"          Customer_Requirements as string,",
				"          Sales_Program as string,",
				"          Buyer_Dept as string,",
				"          Buyer_Confirmed_On as string,",
				"          Dept_Program as string,",
				"          Program_0 as string,",
				"          Cancelled as string,",
				"          Confidence_Factor_Id as string,",
				"          Company_Id as integer,",
				"          Item_Id as string,",
				"          Location_Id as string,",
				"          Sales_Rep_Id as string,",
				"          TranId as string,",
				"          Price_Sticker_Id as string,",
				"          Po as string,",
				"          Release_Order_Number as string,",
				"          Cntnr_ as string,",
				"          Etd_Ship_Date as timestamp,",
				"          Ship_Date_Outbound as string,",
				"          Cancel_Date_Outbound as string,",
				"          Expiration_Date as string,",
				"          Item_Count as string,",
				"          Inner_Qty as string,",
				"          Release_Quantity as string,",
				"          Quantity_Received_In_Shipment as string,",
				"          Item_Unit_Price as string,",
				"          Amount as string,",
				"          Eta_Arrival_Date as string,",
				"          Closed_Script as boolean,",
				"          Estimate_key as short,",
				"          Delete_Flag as boolean,",
				"          Create_Date as timestamp,",
				"          Date_Created as string,",
				"          Date_Last_Modified_Gmt as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> src1",
				"source(output(",
				"          Item_Id as string,",
				"          Generic_Description as string,",
				"          PurchaseDescription as string,",
				"          Artwork as string,",
				"          Color as string,",
				"          Package_Type as string,",
				"          Special_Requirements as string,",
				"          Case_Pack as string,",
				"          Full_Name as string,",
				"          Display_Name as string,",
				"          Account_Manager_Name as string,",
				"          Brand_Name as string,",
				"          Brand_Manager_Name as string,",
				"          Item_Status as string,",
				"          Item_Type as string,",
				"          Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Master_Carton_Rqmnts as string,",
				"          Trade_Partner_Name as string,",
				"          Part_Of_Assembly_Item as string,",
				"          Type_Name as string,",
				"          Trade_Partner_Code as string,",
				"          VendorName as string,",
				"          UPC as string,",
				"          QunatityOnHand as string,",
				"          SSCC14 as string,",
				"          Master_Carton_Markings_Item_N as string,",
				"          Item_key as short,",
				"          Delete_flg as boolean,",
				"          Active_Flag as boolean,",
				"          Create_Date as timestamp,",
				"          Date_last_modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceProducts",
				"source(output(",
				"          Location_Id as string,",
				"          Name as string,",
				"          City as string,",
				"          Country as string,",
				"          State as string,",
				"          Zipcode as string,",
				"          Location_key as short,",
				"          Delete_Flg as boolean,",
				"          Active_Flag as boolean,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceLOCATIONS",
				"source(output(",
				"          Sales_Rep_Id as string,",
				"          Sales_Rep_Name as string,",
				"          LoginAccess as boolean,",
				"          Email as string,",
				"          Phone as string,",
				"          Address as string,",
				"          City as string,",
				"          Country as string,",
				"          Sales_key as short,",
				"          Delete_flg as boolean,",
				"          Active_Flag as boolean,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceSALESREP",
				"source(output(",
				"          Customer_Id as integer,",
				"          Company_Name as string,",
				"          Customer_Key as string,",
				"          Delete_Flag as boolean,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          {Created_By } as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          Active_Flag as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceCUST",
				"src1 derive(Last_Modified_Date = currentTimestamp(),",
				"          Last_Modified_Time = currentTimestamp(),",
				"          Last_Modified_GMT = currentUTC(),",
				"          Last_Updated_By = 'IN1685') ~> derv",
				"derv, selectPROD join(src1@Item_Id == selectPROD@Item_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1, selectLOCATIONS join(src1@Location_Id == selectLOCATIONS@Location_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2loc",
				"join2loc, selectSALESREP join(src1@Sales_Rep_Id == selectSALESREP@Sales_Rep_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> ESTjoinSALESREP",
				"sourceProducts select(mapColumn(",
				"          Item_Id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectPROD",
				"sourceLOCATIONS select(mapColumn(",
				"          Location_Id,",
				"          Location_Name = Name,",
				"          Location_City = City,",
				"          Location_key",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectLOCATIONS",
				"sourceSALESREP select(mapColumn(",
				"          Sales_Rep_Id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectSALESREP",
				"CUSTjoin select(mapColumn(",
				"          each(match(/* All input columns */ true()),",
				"               /* Input name */ $$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(Sticker_Requirement_Purchase_descr = iif(Sticker_Requirements=='NULL' || Sticker_Requirements=='0', 'No stickers', iif(Inner_Requirements=='NULL' && Customer_Requirements=='NULL', Sticker_Requirements, Sticker_Requirements)),",
				"          Confidence_Factor_descr = iif(Confidence_Factor_Id=='1', '25%', iif(Confidence_Factor_Id=='2', '50%', iif(Confidence_Factor_Id=='3', '75%', iif(Confidence_Factor_Id=='4', '90%', iif(Confidence_Factor_Id=='5', 'Dropped', iif(Confidence_Factor_Id=='6', 'Actual', iif(Confidence_Factor_Id=='7', '90%-Pre', iif(Confidence_Factor_Id=='8', '90%-Releases', 'Invalid')))))))),",
				"          Final_Destination_Container = concat(Location_Name,Location_City),",
				"          PRICE_STICKER_descr = case(like(Sticker_Requirements,'price sticker'), concat(Sticker_Requirements ,'$',Price_Sticker_Id), 'No sticker'),",
				"          Month_Ship_Date = concat(toString(year(toDate(Ship_Date_Outbound))),'-',toString(month(toDate(Ship_Date_Outbound)))),",
				"          ETD_date = iif(\r",
				"    like(Location_Name,'%DotCom Distribution - Edison NJ%'), subDays(toDate(Ship_Date_Outbound),66),\r",
				"    iif(like(Location_Name,'%Berkley%'), subDays(toDate(Ship_Date_Outbound),59),\r",
				"    iif(like(Location_Name,'%POE China%'), subDays(toDate(Ship_Date_Outbound),14),\r",
				"    iif(like(Location_Name,'%POE OAK%'), subDays(toDate(Ship_Date_Outbound),59),\r",
				"    iif(like(Location_Name,'%POE Vietnam%'), subDays(toDate(Ship_Date_Outbound),14),\r",
				"    subDays(toDate(Ship_Date_Outbound),45)\r",
				"))))),",
				"          MS_Domestic_Ship_Date = subDays(Etd_Ship_Date,45),",
				"          MS_Domestic_Cancel_Date = addDays(Etd_Ship_Date, 55)) ~> derived1",
				"derived1 derive(Level_Descr = iif(Confidence_Factor_descr=='25%', '', iif(Confidence_Factor_descr=='50%', '', iif(Confidence_Factor_descr=='Dropped', '', iif(Confidence_Factor_descr=='75%', 'Pending Confirmation', iif(Confidence_Factor_descr=='90%', 'Pending Approval', iif(Confidence_Factor_descr=='Actual', 'Confirmed', iif(Confidence_Factor_descr=='90%-Pre', 'Confirmed', iif(Confidence_Factor_descr=='90%-Releases', 'Confirmed', 'Invalid')))))))),",
				"          Month_ETD_date = concat(toString(year(ETD_date)),'-',toString(month(ETD_date)))) ~> derived2",
				"sourceCUST select(mapColumn(",
				"          Customer_Key = Customer_Id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectCUST",
				"ESTjoinSALESREP, selectCUST join(Company_Id == Customer_Key,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> CUSTjoin",
				"derived2 derive(each(match(type=='string'), $$ = replace(iifNull($$, \"UNK\"),'NULL', 'UNK')),",
				"          each(match(type=='integer'), $$ = iifNull($#, 0)),",
				"          each(match(type=='timestamp'), $$ = iifNull($$, toTimestamp('1900-01-01 00:00:00', 'yyyy-MM-dd HH:mm:ss'))),",
				"          each(match(type=='date'), $$ = iifNull($$, toDate('1900-01-01', 'yyyy-MM-dd')))) ~> derivedNULL",
				"derivedNULL sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['STG_PurchaseOrder.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}