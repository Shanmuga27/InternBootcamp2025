{
	"name": "DF_FactOrders_Null_Test",
	"properties": {
		"folder": {
			"name": "Module_Practice/Testing"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "FactOrders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "sinkNullErrors"
				}
			],
			"transformations": [
				{
					"name": "split"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as integer,",
				"          order_key as integer,",
				"          customer_id as short,",
				"          order_amount as short,",
				"          order_date as date,",
				"          status as string,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as string,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> FactOrders",
				"FactOrders split(isNull(order_id),",
				"     disjoint: true) ~> split@(Null)",
				"split@Null sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Null_Errors'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sinkNullErrors"
			]
		}
	}
}