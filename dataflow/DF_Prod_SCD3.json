				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TGTprod",
				"derivedColumn1 join(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> leftjoin1",
				"TGTprod select(mapColumn(",
				"          T_Item_S_Key = Item_S_Key,",
				"          T_Item_Id = Item_Id,",
				"          T_Item_Descr = Item_Descr,",
				"          T_Brand_Descr = Brand_Descr,",
				"          T_Artwork_Descr = Artwork_Descr,",
				"          T_Color_Descr = Color_Descr,",
				"          T_Package_Type_Descr = Package_Type_Descr,",
				"          T_Special_Req_Descr = Special_Req_Descr,",
				"          T_Case_Pack_Desccr = Case_Pack_Desccr,",
				"          T_Full_Name_Descr = Full_Name_Descr,",
				"          T_Display_Name_Descr = Display_Name_Descr,",
				"          T_Account_Manager_Name = Account_Manager_Name,",
				"          T_Brand_Name = Brand_Name,",
				"          T_Brand_Manager_Name = Brand_Manager_Name,",
				"          T_Item_Status_Descr = Item_Status_Descr,",
				"          T_Item_Type_Descr = Item_Type_Descr,",
				"          T_Maker_Name = Maker_Name,",
				"          T_Product_Manager_Name = Product_Manager_Name,",
				"          T_Master_Carton_Req_Descr = Master_Carton_Req_Descr,",
				"          T_Trade_Partner_Name = Trade_Partner_Name,",
				"          T_Part_Of_Assembly_Item = Part_Of_Assembly_Item,",
				"          T_Type_Name = Type_Name,",
				"          T_Trade_Partner_Code = Trade_Partner_Code,",
				"          T_Vendor_Name = Vendor_Name,",
				"          T_UPC_nbr = UPC_nbr,",
				"          {T-On_Hand_Quantity} = On_Hand_Quantity,",
				"          T_SSCC14_nbr = SSCC14_nbr,",
				"          T_Master_Carton_Item_Nbr = Master_Carton_Item_Nbr,",
				"          T_Created_Date = Created_Date,",
				"          T_Last_Modified_Date = Last_Modified_Date,",
				"          T_Delete_Flag = Delete_Flag,",
				"          T_Active_Flag = Active_Flag,",
				"          T_Created_Time = Created_Time,",
				"          T_Created_By = Created_By,",
				"          TLast_Modified_Time = Last_Modified_Time,",
				"          Last_Updated_By",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectTGT",
				"SRCprod derive(Previous_Brand_Manager_Name = toString(null()),",
				"          Current_Brand_Manager_Name = toString(null()),",
				"          Previous_Product_Manager_Name = toString(null()),",
				"          Current_Product_Manager_Name = toString(null())) ~> derivedColumn1"
			]
		}
