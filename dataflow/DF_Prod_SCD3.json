{
	"name": "DF_Prod_SCD3",
	"properties": {
		"folder": {
			"name": "workshop/STG_DW"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "SRCprod"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "TGTprod"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "leftjoin1"
				},
				{
					"name": "selectTGT",
					"description": "Renaming TGTprod "
				},
				{
					"name": "derivedColumn1",
					"description": "Adding extra columns for scd3"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2",
					"description": "derivedUPD"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Item_S_Key as integer,",
				"          Item_Id as integer,",
				"          Item_Descr as string,",
				"          Brand_Descr as string,",
				"          Artwork_Descr as string,",
				"          Color_Descr as string,",
				"          Package_Type_Descr as string,",
				"          Special_Req_Descr as string,",
				"          Case_Pack_Desccr as string,",
				"          Full_Name_Descr as string,",
				"          Display_Name_Descr as string,",
				"          Account_Manager_Name as string,",
				"          Brand_Name as string,",
				"          Brand_Manager_Name as string,",
				"          Item_Status_Descr as string,",
				"          Item_Type_Descr as string,",
				"          Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Master_Carton_Req_Descr as string,",
				"          Trade_Partner_Name as string,",
				"          Part_Of_Assembly_Item as string,",
				"          Type_Name as string,",
				"          Trade_Partner_Code as string,",
				"          Vendor_Name as string,",
				"          UPC_nbr as string,",
				"          On_Hand_Quantity as integer,",
				"          SSCC14_nbr as integer,",
				"          Master_Carton_Item_Nbr as integer,",
				"          Created_Date as timestamp,",
				"          Last_Modified_Date as timestamp,",
				"          Delete_Flag as string,",
				"          Active_Flag as string,",
				"          Created_Time as timestamp,",
				"          Created_By as string,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Updated_By as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCprod",
				"source(output(",
				"          Item_S_Key as integer,",
				"          Item_Id as integer,",
				"          Item_Descr as string,",
				"          Brand_Descr as string,",
				"          Artwork_Descr as string,",
				"          Color_Descr as string,",
				"          Package_Type_Descr as string,",
				"          Special_Req_Descr as string,",
				"          Case_Pack_Desccr as string,",
				"          Full_Name_Descr as string,",
				"          Display_Name_Descr as string,",
				"          Account_Manager_Name as string,",
				"          Brand_Name as string,",
				"          Brand_Manager_Name as string,",
				"          Previous_Brand_Manager_Name as string,",
				"          Current_Brand_Manager_Name as string,",
				"          Item_Status_Descr as string,",
				"          Item_Type_Descr as string,",
				"          Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Previous_Product_Manager_Name as string,",
				"          Current_Product_Manager_Name as string,",
				"          Master_Carton_Req_Descr as string,",
				"          Trade_Partner_Name as string,",
				"          Part_Of_Assembly_Item as string,",
				"          Type_Name as string,",
				"          Trade_Partner_Code as string,",
				"          Vendor_Name as string,",
				"          UPC_nbr as string,",
				"          On_Hand_Quantity as integer,",
				"          SSCC14_nbr as integer,",
				"          Master_Carton_Item_Nbr as integer,",
				"          Created_Date as timestamp,",
				"          Last_Modified_Date as timestamp,",
				"          Delete_Flag as string,",
				"          Active_Flag as string,",
				"          Created_Time as timestamp,",
				"          Created_By as string,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Updated_By as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TGTprod",
				"derivedColumn1, selectTGT join(SRCprod@Item_Id == selectTGT@Item_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> leftjoin1",
				"TGTprod select(mapColumn(",
				"          Item_S_Key,",
				"          Item_Id,",
				"          Item_Descr,",
				"          Brand_Descr,",
				"          Artwork_Descr,",
				"          Color_Descr,",
				"          Package_Type_Descr,",
				"          Special_Req_Descr,",
				"          Case_Pack_Desccr,",
				"          Full_Name_Descr,",
				"          Display_Name_Descr,",
				"          Account_Manager_Name,",
				"          Brand_Name,",
				"          T_Brand_Manager_Name = Brand_Manager_Name,",
				"          T_Previous_Brand_Manager_Name = Previous_Brand_Manager_Name,",
				"          T_Current_Brand_Manager_Name = Current_Brand_Manager_Name,",
				"          Item_Status_Descr,",
				"          Item_Type_Descr,",
				"          Maker_Name,",
				"          T_Product_Manager_Name = Product_Manager_Name,",
				"          T_Previous_Product_Manager_Name = Previous_Product_Manager_Name,",
				"          T_Current_Product_Manager_Name = Current_Product_Manager_Name,",
				"          Master_Carton_Req_Descr,",
				"          Trade_Partner_Name,",
				"          Part_Of_Assembly_Item,",
				"          Type_Name,",
				"          Trade_Partner_Code,",
				"          Vendor_Name,",
				"          UPC_nbr,",
				"          On_Hand_Quantity,",
				"          SSCC14_nbr,",
				"          Master_Carton_Item_Nbr,",
				"          Created_Date,",
				"          Last_Modified_Date,",
				"          Delete_Flag,",
				"          Active_Flag,",
				"          Created_Time,",
				"          Created_By,",
				"          Last_Modified_Time,",
				"          Last_Updated_By",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectTGT",
				"SRCprod derive(Previous_Brand_Manager_Name = toString(null()),",
				"          Current_Brand_Manager_Name = toString(null()),",
				"          Previous_Product_Manager_Name = toString(null()),",
				"          Current_Product_Manager_Name = toString(null())) ~> derivedColumn1",
				"leftjoin1 split(isNull(selectTGT@Item_Id),",
				"     (SRCprod@Item_Id == selectTGT@Item_Id) && ((Brand_Manager_Name != T_Brand_Manager_Name) || (Product_Manager_Name != T_Product_Manager_Name)),",
				"     disjoint: true) ~> split1@(InsertStream, UpdateStream)",
				"split1@UpdateStream derive(Current_Brand_Manager_Name = Brand_Manager_Name,",
				"          Previous_Brand_Manager_Name = Current_Brand_Manager_Name,",
				"          Brand_Manager_Name = T_Previous_Product_Manager_Name,",
				"          Current_Product_Manager_Name = Product_Manager_Name,",
				"          Previous_Product_Manager_Name = Current_Product_Manager_Name,",
				"          Product_Manager_Name = T_Previous_Product_Manager_Name) ~> derivedColumn2",
				"split1@InsertStream derive(Current_Brand_Manager_Name = Brand_Manager_Name) ~> derivedColumn3"
			]
		}
	}
}