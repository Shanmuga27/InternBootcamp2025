{
	"name": "DF_Region",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "Customers"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "Orders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "tgtAPAC"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "tgtEMEA"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "tgtAMER"
				}
			],
			"transformations": [
				{
					"name": "split1"
				},
				{
					"name": "CustomerID"
				},
				{
					"name": "Amount"
				},
				{
					"name": "join1"
				},
				{
					"name": "CustomerName"
				},
				{
					"name": "select1"
				},
				{
					"name": "RegionColumn"
				}
			],
			"scriptLines": [
				"parameters{",
				"     PR_Region as string[] ([\"APAC\",\"EMEA\",\"AMER\"])",
				"}",
				"source(output(",
				"          CustomerID as string,",
				"          Name as string,",
				"          Country as string,",
				"          Age as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Customers",
				"source(output(",
				"          OrderID as string,",
				"          CustomerID as string,",
				"          ProductID as string,",
				"          OrderDate as date,",
				"          Amount as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Orders",
				"RegionColumn split($PR_Region[1]==Region,",
				"     $PR_Region[2]==Region,",
				"     $PR_Region[3]==Region,",
				"     disjoint: true) ~> split1@(APAC, EMEA, AMER)",
				"split1@APAC filter(startsWith(split1@APAC@CustomerID, 'A')) ~> CustomerID",
				"split1@EMEA filter(Amount > 2000\r",
				") ~> Amount",
				"Customers, Orders join(Customers@CustomerID == Orders@CustomerID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"split1@AMER filter(contains(array(Name), \"Inc\")) ~> CustomerName",
				"CustomerID select(mapColumn(",
				"          CustomerID = split1@APAC@CustomerID,",
				"          Name,",
				"          Country,",
				"          Age,",
				"          OrderID,",
				"          ProductID,",
				"          OrderDate,",
				"          Amount,",
				"          Region",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"join1 derive(Region = iif(Country == \"India\" || Country== \"Australia\", \"APAC\", \r",
				"    iif(Country == \"UK\", \"EMEA\", \r",
				"        iif(Country == \"USA\" || Country == \"Canada\", \"AMER\", \"UNK\")))) ~> RegionColumn",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Orders_APAC'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> tgtAPAC",
				"Amount sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Orders_EMEA'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> tgtEMEA",
				"CustomerName sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Customers_AMER'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> tgtAMER"
			]
		}
	}
}