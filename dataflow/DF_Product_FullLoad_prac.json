{
	"name": "DF_Product_FullLoad_prac",
	"properties": {
		"folder": {
			"name": "Module_Practice"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "SrcProduct"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "SnkDimProductsIN1677Prac"
				}
			],
			"transformations": [
				{
					"name": "surrogateProductKey"
				},
				{
					"name": "Transformation"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ProductID as integer,",
				"          ProductName as string,",
				"          Category as string,",
				"          Price as integer,",
				"          created_date as timestamp,",
				"          {created_by  } as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcProduct",
				"SrcProduct keyGenerate(output(product_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateProductKey",
				"surrogateProductKey derive(isActive = 'Y',",
				"          start_date = currentTimestamp(),",
				"          end_date = toTimestamp(null()),",
				"          created_date = currentTimestamp(),",
				"          updated_date = toTimestamp(null()),",
				"          updated_by = toString(null()),",
				"          ProductName = initCap(ProductName)) ~> Transformation",
				"Transformation sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Dim_products_IN1677_prac'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SnkDimProductsIN1677Prac"
			]
		}
	}
}