{
	"name": "DF_Cust_SCD1",
	"properties": {
		"folder": {
			"name": "workshop/STG_DW"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "srcCUST"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "tgtCUST"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "LeftJoin"
				},
				{
					"name": "alterRowINSERT"
				},
				{
					"name": "select1"
				},
				{
					"name": "split1"
				},
				{
					"name": "alterRowUPDATE"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Customer_S_Key as integer,",
				"          Customer_Id as integer,",
				"          Company_Name as string,",
				"          Created_Date as timestamp,",
				"          Last_Modified_Date as timestamp,",
				"          Delete_Flag as string,",
				"          Active_Flag as string,",
				"          Created_Time as timestamp,",
				"          Created_By as string,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Updated_By as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcCUST",
				"source(output(",
				"          Customer_S_Key as integer,",
				"          Customer_Id as integer,",
				"          Company_Name as string,",
				"          Created_Date as timestamp,",
				"          Last_Modified_Date as timestamp,",
				"          Delete_Flag as string,",
				"          Active_Flag as string,",
				"          Created_Time as timestamp,",
				"          Created_By as string,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Updated_By as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> tgtCUST",
				"srcCUST, tgtCUST join(srcCUST@Customer_Id == tgtCUST@Customer_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> LeftJoin",
				"split1@InsertStream alterRow(insertIf(isNull(split1@InsertStream@Customer_Id))) ~> alterRowINSERT",
				"alterRowINSERT select(mapColumn(",
				"          Customer_S_Key = split1@InsertStream@Customer_S_Key,",
				"          Customer_Id = split1@InsertStream@Customer_Id,",
				"          Company_Name = split1@InsertStream@Company_Name,",
				"          Created_Date = split1@InsertStream@Created_Date,",
				"          Last_Modified_Date = split1@InsertStream@Last_Modified_Date,",
				"          Delete_Flag = split1@InsertStream@Delete_Flag,",
				"          Active_Flag = split1@InsertStream@Active_Flag,",
				"          Created_Time = split1@InsertStream@Created_Time,",
				"          Created_By = split1@InsertStream@Created_By,",
				"          Last_Modified_Time = split1@InsertStream@Last_Modified_Time,",
				"          Last_Updated_By = split1@InsertStream@Last_Updated_By",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"LeftJoin split(isNull(tgtCUST@Customer_Id),",
				"     (srcCUST@Customer_Id==tgtCUST@Customer_Id) && (srcCUST@Company_Name!=tgtCUST@Company_Name),",
				"     disjoint: true) ~> split1@(InsertStream, UpdateStream)",
				"split1@UpdateStream alterRow(updateIf((split1@UpdateStream@Customer_Id == split1@UpdateStream@Customer_Id) && (split1@UpdateStream@Company_Name != split1@UpdateStream@Company_Name))) ~> alterRowUPDATE",
				"alterRowUPDATE select(mapColumn(",
				"          Customer_S_Key = split1@UpdateStream@Customer_S_Key,",
				"          Customer_Id = split1@UpdateStream@Customer_Id,",
				"          Company_Name = split1@UpdateStream@Company_Name,",
				"          Created_Date = split1@UpdateStream@Created_Date,",
				"          Last_Modified_Date = split1@UpdateStream@Last_Modified_Date,",
				"          Delete_Flag = split1@UpdateStream@Delete_Flag,",
				"          Active_Flag = split1@UpdateStream@Active_Flag,",
				"          Created_Time = split1@UpdateStream@Created_Time,",
				"          Created_By = split1@UpdateStream@Created_By,",
				"          Last_Modified_Time = split1@UpdateStream@Last_Modified_Time,",
				"          Last_Updated_By = split1@UpdateStream@Last_Updated_By",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink2"
			]
		}
	}
}