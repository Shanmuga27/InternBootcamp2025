{
	"name": "DF_SRC_EDL_sales_rep",
	"properties": {
		"folder": {
			"name": "workshop"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sourceCUST"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1",
					"description": "Customers audit"
				},
				{
					"name": "surrogateKey1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Customer_Key as integer,",
				"          Customer_Id as integer,",
				"          Company_Name as string,",
				"          created_date as timestamp,",
				"          last_modified_date as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceCUST",
				"sourceCUST derive(Created_Date = currentTimestamp(),",
				"          Last_Modified_Date = toTimestamp('1900-01-01 00:00:00', 'dd-MM-yyyy HH:mm:ss', 'IST'),",
				"          Delete_Flag = 'N',",
				"          Active_Flag = 'Y',",
				"          Created_Time = currentTimestamp(),",
				"          Created_By = 'IN1685',",
				"          Last_Modified_Time = toTimestamp('1900-01-01 00:00:00', 'dd-MM-yyyy HH:mm:ss', 'IST'),",
				"          Last_Updated_By = toString(null())) ~> derivedColumn1",
				"derivedColumn1 keyGenerate(output(Customer_S_Key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1 select(mapColumn(",
				"          Customer_S_Key,",
				"          Customer_Id,",
				"          Company_Name,",
				"          Created_Date = derivedColumn1@Created_Date,",
				"          Last_Modified_Date = derivedColumn1@Last_Modified_Date,",
				"          Delete_Flag,",
				"          Active_Flag,",
				"          Created_Time,",
				"          Created_By,",
				"          Last_Modified_Time,",
				"          Last_Updated_By",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['EDL_Customers.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}