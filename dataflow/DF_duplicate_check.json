{
	"name": "DF_duplicate_check",
	"properties": {
		"folder": {
			"name": "QA workshop"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "SRCtgtlocation"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "SNKtgtLocations"
				}
			],
			"transformations": [
				{
					"name": "rowNumber"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     file as string",
				"}",
				"source(output(",
				"          Location_Key as short,",
				"          Location_Id as short,",
				"          Name as string,",
				"          City as string,",
				"          Country as string,",
				"          State as string,",
				"          Zipcode as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCtgtlocation",
				"SRCtgtlocation window(over(Location_Id),",
				"     asc(Location_Id, true),",
				"     r_n = rowNumber()) ~> rowNumber",
				"rowNumber split(r_n>1,",
				"     disjoint: false) ~> split1@(duplicates)",
				"split1@duplicates sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     partitionFileNames:[($file)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SNKtgtLocations"
			]
		}
	}
}