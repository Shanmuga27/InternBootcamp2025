{
	"name": "DF_ex4_2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_OnPrem_SQLServer",
						"type": "DatasetReference"
					},
					"name": "sourceORDERS"
				}
			],
			"sinks": [
				{
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "split1"
				},
				{
					"name": "union1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sourceORDERS",
				"sourceORDERS split(ERROR_FUNCTION(''),",
				"     disjoint: true) ~> split1@(RecentOrders, OldOrders)",
				"split1@OldOrders, split1@RecentOrders union(byName: true)~> union1",
				"union1 derive(column1 = ERROR_FUNCTION('')) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}