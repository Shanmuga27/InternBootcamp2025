{
	"name": "DF_ex4_2",
	"properties": {
		"folder": {
			"name": "training exercise"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sourceORDERS"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sinkBLOB"
				}
			],
			"transformations": [
				{
					"name": "splitDATE",
					"description": "Conditional split - OrderDate"
				},
				{
					"name": "derivedOLD",
					"description": "Derived column -'OrderType - Old'"
				},
				{
					"name": "derivedRECENT",
					"description": "Derived column- 'OrderType - Recent'"
				},
				{
					"name": "union1",
					"description": "Union 'derivedRECENT, derivedOLD'"
				},
				{
					"name": "window1",
					"description": "Remove duplicates - Row Number"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as string,",
				"          CustomerID as string,",
				"          ProductID as string,",
				"          OrderDate as date,",
				"          Amount as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceORDERS",
				"sourceORDERS split(OrderDate > addMonths(currentDate(), -12),",
				"     OrderDate < addMonths(currentDate(), -12),",
				"     disjoint: true) ~> splitDATE@(RecentOrders, OldOrders)",
				"splitDATE@OldOrders derive(OrderType = 'Old') ~> derivedOLD",
				"splitDATE@RecentOrders derive(OrderType = 'Recent') ~> derivedRECENT",
				"derivedRECENT, derivedOLD union(byName: true)~> union1",
				"union1 window(over(OrderID),",
				"     desc(OrderDate, true),",
				"     row = rowNumber()) ~> window1",
				"window1 filter(row==1) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['AllOrders_Unioned_IN1685.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sinkBLOB"
			]
		}
	}
}