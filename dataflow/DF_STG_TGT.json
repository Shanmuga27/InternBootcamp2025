					},
					"name": "tgtCustomers"
				}
			],
			"sinks": [],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          CustomerID as short,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Email as string,",
				"          Country as string,",
				"          CreatedDate as date,",
				"          created_date as string,",
				"          {created_by } as string,",
				"          updated_date as string,",
				"          updated_by as string,",
				"          runid as string",
