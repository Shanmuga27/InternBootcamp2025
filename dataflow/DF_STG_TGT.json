{
	"name": "DF_STG_TGT",
	"properties": {
		"folder": {
			"name": "IN1677_Mock"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Src",
						"type": "DatasetReference"
					},
					"name": "srcCustomers"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Src",
