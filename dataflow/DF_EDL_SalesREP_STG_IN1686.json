{
	"name": "DF_EDL_SalesREP_STG_IN1686",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "EDLSalesREP"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "STGSalesRep"
				}
			],
			"transformations": [
				{
					"name": "NullHandling"
				},
				{
					"name": "ModifiedColumnName"
				},
				{
					"name": "LastModifiedDate"
				},
				{
					"name": "ActiveY"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Sales_Rep_Id as short,",
				"          Sales_Rep_Name as string,",
				"          LoginAccess as string,",
				"          Email as string,",
				"          Phone as string,",
				"          Address as string,",
				"          City as string,",
				"          Country as string,",
				"          Sales_Key as short,",
				"          Delete_Flag as string,",
				"          Create_Date as date,",
				"          Date_Last_Modified as string,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as string,",
				"          Active_Flag as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> EDLSalesREP",
				"ActiveY derive(each(match(type=='string'), $$ = iif(isNull($$) || $$ == 'NULL', 'UNK', $$)),",
				"          each(match(type=='integer'), $$ = iif(isNull($$),0,$$))) ~> NullHandling",
				"NullHandling select(mapColumn(",
				"          Sales_Key,",
				"          Sales_Rep_Id,",
				"          Sales_Rep_Name,",
				"          Sales_Rep_Address = Address,",
				"          Sales_Rep_City = City,",
				"          Sales_Rep_Country = Country,",
				"          Sales_Rep_Email = Email,",
				"          Sales_Rep_LoginAccess = LoginAccess,",
				"          Sales_Rep_Phone = Phone,",
				"          Delete_Flag,",
				"          Create_Date,",
				"          Date_Last_Modified,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp,",
				"          Active_Flag",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> ModifiedColumnName",
				"EDLSalesREP derive(Create_Date = currentTimestamp(),",
				"          Date_Last_Modified = currentTimestamp(),",
				"          Created_Timestamp = currentTimestamp(),",
				"          Last_Updated_By = \"IN1686 Sanjay Komala\",",
				"          Last_Update_Timestamp = currentTimestamp()) ~> LastModifiedDate",
				"LastModifiedDate filter(toString(Active_Flag) == 'Y') ~> ActiveY",
				"ModifiedColumnName sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['W2_SaleREP_STG_IN1686.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> STGSalesRep"
			]
		}
	}
}