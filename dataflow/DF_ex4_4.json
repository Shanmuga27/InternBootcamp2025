{
	"name": "DF_ex4_4",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sourceCUST"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sourceORDERS"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "OrdersAPAC"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "OrdersEMEA"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "CustomersAMER"
				}
			],
			"transformations": [
				{
					"name": "join1",
					"description": "'sourceCUST'\nInner join \n'sourceORDERS'"
				},
				{
					"name": "split1"
				},
				{
					"name": "filterAPAC"
				},
				{
					"name": "filterEMEA"
				},
				{
					"name": "filterAMER"
				}
			],
			"scriptLines": [
				"parameters{",
				"     param_Region as string[]",
				"}",
				"source(output(",
				"          CustomerID as string,",
				"          Name as string,",
				"          Country as string,",
				"          Age as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceCUST",
				"source(output(",
				"          OrderID as string,",
				"          CustomerID as string,",
				"          ProductID as string,",
				"          OrderDate as date,",
				"          Amount as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceORDERS",
				"sourceCUST, sourceORDERS join(sourceCUST@CustomerID == sourceORDERS@CustomerID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 split($param_Region[1]=='APAC',",
				"     $param_Region[2] == 'EMEA',",
				"     $param_Region[3] == 'AMER',",
				"     disjoint: true) ~> split1@(APAC, EMEA, AMER)",
				"split1@APAC filter(( Country == 'India' || Country == 'Australia' ) && startsWith(Name, 'B')) ~> filterAPAC",
				"split1@EMEA filter(( Country == 'UK' ) && Amount > 2000) ~> filterEMEA",
				"split1@AMER filter(( Country == 'USA' || Country == 'Canada' ) && like(Name, 'Inc')) ~> filterAMER",
				"filterAPAC sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Orders_APAC.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> OrdersAPAC",
				"filterEMEA sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Orders_EMEA.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> OrdersEMEA",
				"filterAMER sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Customers_AMER.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> CustomersAMER"
			]
		}
	}
}