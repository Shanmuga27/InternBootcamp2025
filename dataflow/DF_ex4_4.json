{
	"name": "DF_ex4_4",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sourceCUST"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sourceORDERS"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "join1",
					"description": "'sourceCUST'\nInner join \n'sourceORDERS'"
				},
				{
					"name": "split1"
				},
				{
					"name": "filterAPAC"
				},
				{
					"name": "filterEMEA"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     param_Region as string",
				"}",
				"source(output(",
				"          CustomerID as string,",
				"          Name as string,",
				"          Country as string,",
				"          Age as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceCUST",
				"source(output(",
				"          OrderID as string,",
				"          CustomerID as string,",
				"          ProductID as string,",
				"          OrderDate as date,",
				"          Amount as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceORDERS",
				"sourceCUST, sourceORDERS join(sourceCUST@CustomerID == sourceORDERS@CustomerID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 split($param_Region == 'APAC',",
				"     $param_Region == 'EMEA',",
				"     $param_Region == 'AMER',",
				"     disjoint: true) ~> split1@(APAC, EMEA, AMER)",
				"split1@APAC filter(( Country == 'India' || Country == 'Australia' ) && startsWith(Name, 'A')) ~> filterAPAC",
				"split1@EMEA filter(( Country == 'UK' ) && Amount > 2000) ~> filterEMEA",
				"split1@AMER filter(( Country == 'USA' || Country == 'Canada' ) && contains(array(Name), 'Inc.')\r",
				") ~> filter1"
			]
		}
	}
}