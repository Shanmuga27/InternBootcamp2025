{
	"name": "DF_EDL_STG_SalesRep",
	"properties": {
		"folder": {
			"name": "workshop/EDL_STG"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sourceEDLSalesRep"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1",
					"description": "NULL & transf"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "select1",
					"description": "Renaming columns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Sales_S_Key as integer,",
				"          Sales_Rep_Id as integer,",
				"          Sales_Rep_Name as string,",
				"          LoginAccess as string,",
				"          Email as string,",
				"          Phone as string,",
				"          Address as string,",
				"          City as string,",
				"          Country as string,",
				"          Created_Date as timestamp,",
				"          Last_Modified_Date as timestamp,",
				"          Delete_Flag as string,",
				"          Active_Flag as string,",
				"          Created_Time as timestamp,",
				"          Created_By as string,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Updated_By as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceEDLSalesRep",
				"derivedColumn2 derive(each(match(type=='string'), $$ = replace(iifNull($$, \"UNK\"),'NULL', 'UNK')),",
				"          each(match(type=='integer'), $$ = iifNull($#, 0)),",
				"          each(match(type=='timestamp'), $$ = iifNull($$, currentTimestamp()))) ~> derivedColumn1",
				"sourceEDLSalesRep derive(Last_Modified_Time = currentTimestamp(),",
				"          Last_Updated_By = 'IN1685') ~> derivedColumn2",
				"derivedColumn1 select(mapColumn(",
				"          Sales_S_Key,",
				"          Sales_Rep_Id,",
				"          Sales_Rep_Name,",
				"          Sales_Rep_LoginAccess = LoginAccess,",
				"          Sales_Rep_Email = Email,",
				"          Sales_Rep_Phone = Phone,",
				"          Sales_Rep_Address = Address,",
				"          Sales_Rep_City = City,",
				"          Sales_Rep_Country = Country,",
				"          Created_Date,",
				"          Last_Modified_Date,",
				"          Delete_Flag,",
				"          Active_Flag,",
				"          Created_Time,",
				"          Created_By,",
				"          Last_Modified_Time,",
				"          Last_Updated_By",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['STG_SalesRep.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}