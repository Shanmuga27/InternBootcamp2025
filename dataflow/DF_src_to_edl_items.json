{
	"name": "DF_src_to_edl_items",
	"properties": {
		"folder": {
			"name": "src_to_edl"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_blob_excel",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "surrogateKey1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename as string",
				"}",
				"source(output(",
				"          Item_key as integer,",
				"          Item_Id as integer,",
				"          Generic_Description as string,",
				"          PurchaseDescription as string,",
				"          Artwork as string,",
				"          Color as string,",
				"          Package_Type as string,",
				"          Special_Requirements as string,",
				"          Case_Pack as string,",
				"          Full_Name as string,",
				"          Display_Name as string,",
				"          Account_Manager_Name as string,",
				"          Brand_Name as string,",
				"          Brand_Manager_Name as string,",
				"          Item_Status as string,",
				"          Item_Type as string,",
				"          Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Master_Carton_Rqmnts as string,",
				"          Trade_Partner_Name as string,",
				"          Part_Of_Assembly_Item as string,",
				"          Type_Name as string,",
				"          Trade_Partner_Code as string,",
				"          VendorName as string,",
				"          UPC as string,",
				"          QunatityOnHand as string,",
				"          SSCC14 as string,",
				"          Master_Carton_Markings_Item_N as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false) ~> source1",
				"select1 keyGenerate(output(Item_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L,",
				"     partitionBy('hash', 1)) ~> surrogateKey1",
				"surrogateKey1 derive(Delete_flag = \"N\",",
				"          Created_by = \"IN1680\",",
				"          Created_timestamp = currentTimestamp(),",
				"          Last_updated_by = \"IN1680\",",
				"          Last_updated_timestamp = currentTimestamp(),",
				"          Active_flag = \"Y\",",
				"          Created_date = currentTimestamp(),",
				"          Date_last_modified = currentTimestamp()) ~> derivedColumn1",
				"source1 select(mapColumn(",
				"          Item_Id,",
				"          Generic_Description,",
				"          PurchaseDescription,",
				"          Artwork,",
				"          Color,",
				"          Package_Type,",
				"          Special_Requirements,",
				"          Case_Pack,",
				"          Full_Name,",
				"          Display_Name,",
				"          Account_Manager_Name,",
				"          Brand_Name,",
				"          Brand_Manager_Name,",
				"          Item_Status,",
				"          Item_Type,",
				"          Maker_Name,",
				"          Product_Manager_Name,",
				"          Master_Carton_Rqmnts,",
				"          Trade_Partner_Name,",
				"          Part_Of_Assembly_Item,",
				"          Type_Name,",
				"          Trade_Partner_Code,",
				"          VendorName,",
				"          UPC,",
				"          QunatityOnHand,",
				"          SSCC14,",
				"          Master_Carton_Markings_Item_N",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     partitionFileNames:[($filename)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}