{
	"name": "DF_Stratification",
	"properties": {
		"folder": {
			"name": "QA"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SrcOrders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SNKOrders"
				}
			],
			"transformations": [
				{
					"name": "split1"
				},
				{
					"name": "OrderTypeRecent"
				},
				{
					"name": "OrderTypeOld"
				},
				{
					"name": "union"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as string,",
				"          CustomerID as string,",
				"          ProductID as string,",
				"          OrderDate as date,",
				"          Amount as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcOrders",
				"SrcOrders split(OrderDate > addMonths(currentDate(), -12),",
				"     disjoint: false) ~> split1@(RecentOrders, OldOrders)",
				"split1@RecentOrders derive(OrderType = \"Recent\") ~> OrderTypeRecent",
				"split1@OldOrders derive(OrderType = \"Old\") ~> OrderTypeOld",
				"OrderTypeRecent, OrderTypeOld union(byName: true,",
				"     partitionBy('hash', 1))~> union",
				"union sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Stratification'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SNKOrders"
			]
		}
	}
}