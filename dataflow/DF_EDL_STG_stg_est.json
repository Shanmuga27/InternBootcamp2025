{
	"name": "DF_EDL_STG_stg_est",
	"properties": {
		"folder": {
			"name": "workshop/EDL_STG"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sourceEDLestimate"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sourceProducts"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sourceLOCATIONS"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sourceSALESREP"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "LastModDerived",
					"description": "last modified values"
				},
				{
					"name": "NullDerived",
					"description": "NULL"
				},
				{
					"name": "ESTjoinPROD"
				},
				{
					"name": "ESTjoinLOC"
				},
				{
					"name": "ESTjoinSALESREP"
				},
				{
					"name": "selectPROD"
				},
				{
					"name": "selectLOCATIONS"
				},
				{
					"name": "selectSALESREP"
				},
				{
					"name": "select1"
				},
				{
					"name": "derived1"
				},
				{
					"name": "derived2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Estimate_S_Key as integer,",
				"          Transaction_Id as integer,",
				"          Transaction_Line_Id as integer,",
				"          Memo as string,",
				"          Sticker_Requirements as string,",
				"          Inner_Requirements as string,",
				"          Customer_Requirements as string,",
				"          Sales_Program as string,",
				"          Buyer_Dept as string,",
				"          Buyer_Confirmed_On as string,",
				"          Dept_Program as string,",
				"          Program_0 as string,",
				"          Cancelled as string,",
				"          Confidence_Factor_Id as integer,",
				"          Company_Id as integer,",
				"          Item_Id as integer,",
				"          Location_Id as integer,",
				"          Sales_Rep_Id as integer,",
				"          TranId as string,",
				"          Price_Sticker_Id as string,",
				"          Po as string,",
				"          Release_Order_Number as string,",
				"          Cntnr_ as string,",
				"          Etd_Ship_Date as timestamp,",
				"          Ship_Date_Outbound as timestamp,",
				"          Cancel_Date_Outbound as timestamp,",
				"          Expiration_Date as timestamp,",
				"          Item_Count as string,",
				"          Inner_Qty as string,",
				"          Release_Quantity as string,",
				"          Quantity_Received_In_Shipment as string,",
				"          Item_Unit_Price as string,",
				"          Amount as string,",
				"          Eta_Arrival_Date as timestamp,",
				"          Created_Date as timestamp,",
				"          Last_Modified_Date as timestamp,",
				"          Delete_Flag as string,",
				"          Created_Time as timestamp,",
				"          Created_By as string,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Modified_GMT as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceEDLestimate",
				"source(output(",
				"          Item_S_Key as integer,",
				"          Item_Id as integer,",
				"          Generic_Description as string,",
				"          PurchaseDescription as string,",
				"          Artwork as string,",
				"          Color as string,",
				"          Package_Type as string,",
				"          Special_Requirements as string,",
				"          Case_Pack as string,",
				"          Full_Name as string,",
				"          Display_Name as string,",
				"          Account_Manager_Name as string,",
				"          Brand_Name as string,",
				"          Brand_Manager_Name as string,",
				"          Item_Status as string,",
				"          Item_Type as string,",
				"          Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Master_Carton_Rqmnts as string,",
				"          Trade_Partner_Name as string,",
				"          Part_Of_Assembly_Item as string,",
				"          Type_Name as string,",
				"          Trade_Partner_Code as string,",
				"          VendorName as string,",
				"          UPC as string,",
				"          QunatityOnHand as string,",
				"          SSCC14 as string,",
				"          Master_Carton_Markings_Item_N as string,",
				"          Created_Date as timestamp,",
				"          Last_Modified_Date as timestamp,",
				"          Delete_Flag as string,",
				"          Active_Flag as string,",
				"          Created_Time as timestamp,",
				"          Created_By as string,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Updated_By as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceProducts",
				"source(output(",
				"          Locations_S_Key as integer,",
				"          Location_Id as integer,",
				"          Location_Name as string,",
				"          Location_City as string,",
				"          Location_Country as string,",
				"          Location_State as string,",
				"          Location_Zipcode as string,",
				"          Last_Modified_Date as timestamp,",
				"          Delete_Flag as boolean,",
				"          Active_Flag as boolean,",
				"          Created_Time as timestamp,",
				"          Created_By as string,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Updated_By as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceLOCATIONS",
				"source(output(",
				"          Sales_S_Key as boolean,",
				"          Sales_Rep_Id as integer,",
				"          Sales_Rep_Name as string,",
				"          Sales_Rep_LoginAccess as boolean,",
				"          Sales_Rep_Email as string,",
				"          Sales_Rep_Phone as string,",
				"          Sales_Rep_Address as string,",
				"          Sales_Rep_City as string,",
				"          Sales_Rep_Country as string,",
				"          Created_Date as timestamp,",
				"          Last_Modified_Date as timestamp,",
				"          Delete_Flag as boolean,",
				"          Active_Flag as boolean,",
				"          Created_Time as timestamp,",
				"          Created_By as string,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Updated_By as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceSALESREP",
				"sourceEDLestimate derive(Last_Modified_Date = currentTimestamp(),",
				"          Last_Modified_Time = currentTimestamp(),",
				"          Last_Modified_GMT = currentUTC(),",
				"          Last_Updated_By = 'IN1685') ~> LastModDerived",
				"LastModDerived derive(each(match(type=='string'), $$ = replace(iifNull($$, \"UNK\"),'NULL', 'UNK')),",
				"          each(match(type=='integer'), $$ = iifNull($#, 0)),",
				"          each(match(type=='timestamp'), $$ = iifNull($$, toTimestamp('1900-01-01 00:00:00', 'dd-MM-yyyy HH:mm:ss')))) ~> NullDerived",
				"NullDerived, selectPROD join(NullDerived@Item_Id == selectPROD@Item_Id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> ESTjoinPROD",
				"ESTjoinPROD, selectLOCATIONS join(NullDerived@Location_Id == selectLOCATIONS@Location_Id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> ESTjoinLOC",
				"ESTjoinLOC, selectSALESREP join(NullDerived@Sales_Rep_Id == selectSALESREP@Sales_Rep_Id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> ESTjoinSALESREP",
				"sourceProducts select(mapColumn(",
				"          Item_Id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectPROD",
				"sourceLOCATIONS select(mapColumn(",
				"          Location_Id,",
				"          Location_Name,",
				"          Location_City",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectLOCATIONS",
				"sourceSALESREP select(mapColumn(",
				"          Sales_Rep_Id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectSALESREP",
				"ESTjoinSALESREP select(mapColumn(",
				"          Estimate_S_Key,",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo,",
				"          Sticker_Requirements,",
				"          Inner_Requirements,",
				"          Customer_Requirements,",
				"          Sales_Program,",
				"          Buyer_Dept,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program,",
				"          Program_0,",
				"          Cancelled,",
				"          Confidence_Factor_Id,",
				"          Company_Id,",
				"          Item_Id = NullDerived@Item_Id,",
				"          Location_Id = NullDerived@Location_Id,",
				"          Sales_Rep_Id = NullDerived@Sales_Rep_Id,",
				"          TranId,",
				"          Price_Sticker_Id,",
				"          Po,",
				"          Release_Order_Number,",
				"          Cntnr_,",
				"          Etd_Ship_Date,",
				"          Ship_Date_Outbound,",
				"          Cancel_Date_Outbound,",
				"          Expiration_Date,",
				"          Item_Count,",
				"          Inner_Qty,",
				"          Release_Quantity,",
				"          Quantity_Received_In_Shipment,",
				"          Item_Unit_Price,",
				"          Amount,",
				"          Eta_Arrival_Date,",
				"          Created_Date,",
				"          Last_Modified_Date,",
				"          Delete_Flag,",
				"          Created_Time,",
				"          Created_By,",
				"          Last_Modified_Time,",
				"          Last_Updated_By,",
				"          Last_Modified_GMT,",
				"          Item_Id_Key = selectPROD@Item_Id,",
				"          Location_Id_Key = selectLOCATIONS@Location_Id,",
				"          Sales_Rep_Id_Key = selectSALESREP@Sales_Rep_Id",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> select1",
				"select1 derive(Sticker_Requirement_Purchase_descr = iif(Sticker_Requirements=='NULL', 'No stickers', iif(Inner_Requirements=='NULL' && Customer_Requirements=='NULL', Sticker_Requirements, Sticker_Requirements)),",
				"          Confidence_Factor_descr = iif(Confidence_Factor_Id==1, '25%', iif(Confidence_Factor_Id==2, '50%', iif(Confidence_Factor_Id==3, '75%', iif(Confidence_Factor_Id==4, '90%', iif(Confidence_Factor_Id==5, 'Dropped', iif(Confidence_Factor_Id==6, 'Actual', iif(Confidence_Factor_Id==7, '90%-Pre', iif(Confidence_Factor_Id==8, '90%-Releases', 'Invalid'))))))))) ~> derived1",
				"derived1 derive(Level_Descr = iif(Confidence_Factor_descr=='25%', '', iif(Confidence_Factor_descr=='50%', '', iif(Confidence_Factor_descr=='Dropped', '', iif(Confidence_Factor_descr=='75%', 'Pending Confirmation', iif(Confidence_Factor_descr=='90%', 'Pending Approval', iif(Confidence_Factor_descr=='Actual', 'Confirmed', iif(Confidence_Factor_descr=='90%-Pre', 'Confirmed', iif(Confidence_Factor_descr=='90%-Releases', 'Confirmed', 'Invalid')))))))),",
				"          Final_Destination_Container = concat(this, that)) ~> derived2"
			]
		}
	}
}