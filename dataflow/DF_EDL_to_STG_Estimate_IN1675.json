				"          Month_Ship_dt,",
				"          ETD_dt,",
				"          Month_ETD_dt,",
				"          MS_Domestic_Ship_Date,",
				"          MS_Domestic_Cancel_Date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(each(match(type=='string'), $$ = iif(isNull($$) || $$ == 'NULL', 'UNK', $$)),",
				"          each(match(type=='timestamp'), $$ = iifNull($$, toTimestamp('1900-01-01 00:00:00', 'dd-MM-yyyy HH:mm:ss'))),",
				"          each(match(type=='integer'), $$ = iifNull($$, 0, $$)),",
				"          each(match(type=='date'), $$ = iifNull($$, toTimestamp('1900-01-01 00:00:00', 'dd-MM-yyyy HH:mm:ss')))) ~> derivedColumn3",
				"derivedColumn3 derive(Last_Updated_By = 'IN1675',",
				"          Last_Update_Timestamp = currentTimestamp(),",
				"          Date_Last_Modified_Gmt = toTimestamp(currentDate())) ~> derivedColumn4",
				"derivedColumn4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['STG_Estimate.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> StgEstimate"
			]
		}
	}
}