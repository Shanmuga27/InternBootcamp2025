				"          Created_By = StgItems@Created_By,",
				"          Created_Timestamp = StgItems@Created_Timestamp,",
				"          Last_Updated_By = StgItems@Last_Updated_By,",
				"          Last_Update_Timestamp = StgItems@Last_Update_Timestamp,",
				"          Sales_Rep_Id = StgSalesRep@Sales_Rep_Id,",
				"          Sales_Key,",
				"          Sales_Rep_Name,",
				"          Sales_Rep_Address,",
				"          Sales_Rep_City,",
				"          Sales_Rep_Country,",
				"          Sales_Rep_Email,",
				"          Sales_Rep_LoginAccess,",
				"          Sales_Rep_Phone,",
				"          Delete_Flag = StgSalesRep@Delete_Flag,",
				"          Active_Flag = StgSalesRep@Active_Flag,",
				"          Create_Date = StgSalesRep@Create_Date,",
				"          Date_Last_Modified = StgSalesRep@Date_Last_Modified,",
				"          Created_By = StgSalesRep@Created_By,",
				"          Created_Timestamp = StgSalesRep@Created_Timestamp,",
				"          Last_Updated_By = StgSalesRep@Last_Updated_By,",
				"          Last_Update_Timestamp = StgSalesRep@Last_Update_Timestamp,",
				"          Date_last_Modified = StgSalesRep@Date_last_Modified",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select",
				"select derive(Month_Ship_dt = concat(\r",
				"  toString(year(toDate(Ship_Date_Outbound))), '-',\r",
				"  iif(month(toDate(Ship_Date_Outbound)) < 10,\r",
				"    concat('0', toString(month(toDate(Ship_Date_Outbound)))),\r",
				"    toString(month(toDate(Ship_Date_Outbound)))\r",
				"  )\r",
				")\r",
				"\r",
				",",
				"          ETD_dt = \r",
				"iif(\r",
				"    like(Location_Name,'%DotCom Distribution - Edison NJ%'), subDays(toDate(Ship_Date_Outbound,'MM/dd/yy', 'en-US'),66),\r",
				"    iif(like(Location_Name,'%Berkley%'), subDays(toDate(Ship_Date_Outbound,'MM/dd/yy', 'en-US'),59),\r",
				"    iif(like(Location_Name,'%POE China%'), subDays(toDate(Ship_Date_Outbound,'MM/dd/yy', 'en-US'),14),\r",
				"    iif(like(Location_Name,'%POE OAK%'), subDays(toDate(Ship_Date_Outbound,'MM/dd/yy', 'en-US'),59),\r",
				"    iif(like(Location_Name,'%POE Vietnam%'), subDays(toDate(Ship_Date_Outbound,'MM/dd/yy', 'en-US'),14)\r",
				"    ,subDays(toDate(Ship_Date_Outbound,'MM/dd/yy', 'en-US'),45)\r",
				"\r",
				")))))) ~> derivedColumn1",
				"derivedColumn1 derive(Month_ETD_dt = concat(   toString(year(ETD_dt)), '-',   iif(month(ETD_dt) < 10, concat('0', toString(month(ETD_dt))), toString(month(ETD_dt))) ),",
				"          MS_Domestic_Ship_Date = addDays(toDate(Etd_Ship_Date),-45),",
				"          MS_Domestic_Cancel_Date = addDays(toDate(Etd_Ship_Date),55)) ~> derivedColumn2",
				"derivedColumn2 select(mapColumn(",
				"          Sales_Estimate_Key,",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo_descr,",
				"          Sticker_Requirements_descr,",
				"          Inner_Requirements_descr,",
				"          Customer_Requirements_descr,",
				"          Sales_Program_descr,",
				"          Buyer_Dept_descr,",
