				"          Dept_Program_descr,",
				"          Program_descr,",
				"          Cancelled_descr,",
				"          Sticker_Requirement_Purchase_descr,",
				"          Confidence_Factor_descr,",
				"          Level_Descr,",
				"          Final_Destination_Container,",
				"          PRICE_STICKER_descr,",
				"          Customer_Key,",
				"          Item_Key,",
				"          Location_Key,",
				"          Document_nbr = TranId,",
				"          Price_Sticker_Id,",
				"          Po_nbr = Po,",
				"          Release_Order_Number,",
				"          Sales_Rep_Id,",
				"          Cntnr_nbr = Cntnr_,",
				"          Etd_Ship_dt = Etd_Ship_Date,",
				"          Ship_Date_Outbound,",
				"          Cancel_Date_Outbound,",
				"          Expiration_Date,",
