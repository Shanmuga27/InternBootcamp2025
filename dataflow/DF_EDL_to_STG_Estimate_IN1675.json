{
	"name": "DF_EDL_to_STG_Estimate_IN1675",
	"properties": {
		"folder": {
			"name": "Workshop_IN1675/EDL_STG_IN1675"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "EDLEstimate"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "StgLocations"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "Transformations1"
				},
				{
					"name": "Transformations2"
				},
				{
					"name": "JoinwithLocations"
				},
				{
					"name": "ColumnRemove"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Transaction_Id as integer,",
				"          Transaction_Line_Id as integer,",
				"          Memo as string,",
				"          Sticker_Requirements as string,",
				"          Inner_Requirements as string,",
				"          Customer_Requirements as string,",
				"          Sales_Program as string,",
				"          Buyer_Dept as string,",
				"          Buyer_Confirmed_On as string,",
				"          Dept_Program as string,",
				"          Program_0 as string,",
				"          Cancelled as string,",
				"          Confidence_Factor_Id as integer,",
				"          Company_Id as integer,",
				"          Item_Id as string,",
				"          Location_Id as integer,",
				"          Sales_Rep_Id as integer,",
				"          TranId as string,",
				"          Price_Sticker_Id as string,",
				"          Po as integer,",
				"          Release_Order_Number as string,",
				"          Quantity_Received_In_Shipment as string,",
				"          Cntnr_ as string,",
				"          Etd_Ship_Date as string,",
				"          Ship_Date_Outbound as string,",
				"          Cancel_Date_Outbound as string,",
				"          Expiration_Date as string,",
				"          Item_Count as integer,",
				"          Inner_Qty as string,",
				"          Release_Quantity as string,",
				"          Item_Unit_Price as string,",
				"          Amount as string,",
				"          Eta_Arrival_Date as string,",
				"          Estimate_Key as integer,",
				"          Delete_Flag as string,",
				"          Create_Date as timestamp,",
				"          Date_Created as timestamp,",
				"          Date_Last_Modified_Gmt as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> EDLEstimate",
				"source(output(",
				"          Location_ID as integer,",
				"          Location_Name as string,",
				"          Location_Country as string,",
				"          Location_City as string,",
				"          Location_State as string,",
				"          Location_Zipcode as string,",
				"          Location_Key as integer,",
				"          Delete_Flg as string,",
				"          Active_Flg as string,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> StgLocations",
				"EDLEstimate derive(Sticker_Requirement_Purchase_descr = iif(toInteger(Sticker_Requirements) == 0, 'No Stickers',\r",
				"  iif(toInteger(Inner_Requirements) == 0 && toInteger(Customer_Requirements) == 0, Sticker_Requirements,\r",
				"    iif(toInteger(Customer_Requirements) == 0, Sticker_Requirements, 'unk')\r",
				"  )\r",
				")\r",
				"\r",
				"\r",
				",",
				"          Confidence_Factor_Id = iif(Confidence_Factor_Id == 1, '25%',\r",
				"  iif(Confidence_Factor_Id == 2, '50%',\r",
				"    iif(Confidence_Factor_Id == 3, '75%',\r",
				"      iif(Confidence_Factor_Id == 4, '90%',\r",
				"        iif(Confidence_Factor_Id == 5, 'Dropped',\r",
				"          iif(Confidence_Factor_Id == 6, 'Actual',\r",
				"            iif(Confidence_Factor_Id == 7, '90%-Pre',\r",
				"              iif(Confidence_Factor_Id == 8, '90%-Releases', 'Unknown')\r",
				"            )\r",
				"          )\r",
				"        )\r",
				"      )\r",
				"    )\r",
				"  )\r",
				")\r",
				",",
				"          Level_Descr = iif(Confidence_Factor_Id == 1, '',\r",
				"  iif(Confidence_Factor_Id == 2, '',\r",
				"    iif(Confidence_Factor_Id == 3, 'Pending Confirmation',\r",
				"      iif(Confidence_Factor_Id == 4, 'Pending Approval%',\r",
				"        iif(Confidence_Factor_Id == 5, 'Confirmed',\r",
				"          iif(Confidence_Factor_Id == 6, 'Confirmed',\r",
				"            iif(Confidence_Factor_Id == 7, 'Confirmed',\r",
				"              iif(Confidence_Factor_Id == 8, 'Confirmed', 'Unknown')\r",
				"            )\r",
				"          )\r",
				"        )\r",
				"      )\r",
				"    )\r",
				"  )\r",
				")\r",
				") ~> Transformations1",
				"ColumnRemove derive(Final_Destination_Container = concat(Location_City, Location_Name),",
				"          PRICE_STICKER_descr = iif(\r",
				"  contains(Sticker_Requirement_Purchase_descr, '$') && contains(Sticker_Requirement_Purchase_descr, 'price sticker'),\r",
				"  substring(\r",
				"    Sticker_Requirement_Purchase_descr,\r",
				"    indexOf(Sticker_Requirement_Purchase_descr, '$') + 1,\r",
				"    indexOf(Sticker_Requirement_Purchase_descr, 'price sticker') - indexOf(Sticker_Requirement_Purchase_descr, '$') - 1\r",
				"  ),\r",
				"  'No Sticker'\r",
				")\r",
				") ~> Transformations2",
				"Transformations1, StgLocations join(EDLEstimate@Location_Id == StgLocations@Location_ID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinwithLocations",
				"JoinwithLocations select(mapColumn(",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo,",
				"          Sticker_Requirements,",
				"          Inner_Requirements,",
				"          Customer_Requirements,",
				"          Sales_Program,",
				"          Buyer_Dept,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program,",
				"          Program_0,",
				"          Cancelled,",
				"          Confidence_Factor_Id,",
				"          Company_Id,",
				"          Item_Id,",
				"          Location_Id = EDLEstimate@Location_Id,",
				"          Sales_Rep_Id,",
				"          TranId,",
				"          Price_Sticker_Id,",
				"          Po,",
				"          Release_Order_Number,",
				"          Quantity_Received_In_Shipment,",
				"          Cntnr_,",
				"          Etd_Ship_Date,",
				"          Ship_Date_Outbound,",
				"          Cancel_Date_Outbound,",
				"          Expiration_Date,",
				"          Item_Count,",
				"          Inner_Qty,",
				"          Release_Quantity,",
				"          Item_Unit_Price,",
				"          Amount,",
				"          Eta_Arrival_Date,",
				"          Estimate_Key,",
				"          Delete_Flag,",
				"          Create_Date,",
				"          Date_Created,",
				"          Date_Last_Modified_Gmt,",
				"          Created_By = EDLEstimate@Created_By,",
				"          Created_Timestamp = EDLEstimate@Created_Timestamp,",
				"          Last_Updated_By = EDLEstimate@Last_Updated_By,",
				"          Last_Update_Timestamp = EDLEstimate@Last_Update_Timestamp,",
				"          Sticker_Requirement_Purchase_descr,",
				"          Level_Descr,",
				"          Location_Name,",
				"          Location_Country,",
				"          Location_City,",
				"          Location_State,",
				"          Location_Zipcode,",
				"          Location_Key,",
				"          Delete_Flg,",
				"          Active_Flg,",
				"          Date_Last_Modified,",
				"          Created_By = StgLocations@Created_By,",
				"          Created_Timestamp = StgLocations@Created_Timestamp,",
				"          Last_Updated_By = StgLocations@Last_Updated_By,",
				"          Last_Update_Timestamp = StgLocations@Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> ColumnRemove"
			]
		}
	}
}