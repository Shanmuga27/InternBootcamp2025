				"          Vendor_Name,",
				"          UPC_nbr,",
				"          On_Hand_Quantity,",
				"          SSCC14_nbr,",
				"          Master_Carton_Markings_Item_Nbr,",
				"          Part_Of_Assembly_Item,",
				"          Delete_Flag = StgItems@Delete_Flag,",
				"          Active_Flag = StgItems@Active_Flag,",
