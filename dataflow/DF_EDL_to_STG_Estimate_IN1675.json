				"          Expiration_Date,",
				"          Item_Count,",
				"          Inner_Qty,",
				"          Release_Quantity,",
				"          Item_Unit_Price,",
				"          Amount,",
				"          Eta_Arrival_Date,",
				"          Delete_Flag = ColumnRemove@Delete_Flag,",
				"          Create_Date = ColumnRemove@Create_Date,",
				"          Date_Created,",
				"          Date_Last_Modified_Gmt,",
				"          Created_By = ColumnRemove@Created_By,",
				"          Created_Timestamp = ColumnRemove@Created_Timestamp,",
				"          Last_Updated_By = ColumnRemove@Last_Updated_By,",
				"          Last_Update_Timestamp = ColumnRemove@Last_Update_Timestamp,",
				"          Location_Name,",
				"          Location_Country,",
				"          Location_City,",
				"          Location_State,",
				"          Location_Zipcode,",
				"          Location_Key,",
				"          Delete_Flg,",
				"          Active_Flg,",
				"          Date_Last_Modified = ColumnRemove@Date_Last_Modified,",
				"          PRICE_STICKER_descr,",
				"          Customer_Id,",
				"          Company_Name,",
				"          Delete_Flag = StgCustomers@Delete_Flag,",
				"          Create_Date = StgCustomers@Create_Date,",
				"          Date_Last_Modified = StgCustomers@Date_Last_Modified,",
				"          Created_By = StgCustomers@Created_By,",
				"          Created_Timestamp = StgCustomers@Created_Timestamp,",
				"          Last_Updated_By = StgCustomers@Last_Updated_By,",
				"          Last_Update_Timestamp = StgCustomers@Last_Update_Timestamp,",
				"          Active_Flag = StgCustomers@Active_Flag,",
				"          Item_Id = StgItems@Item_Id,",
				"          Item_Key,",
				"          Item_Descr,",
				"          Brand_desr,",
				"          Artwork_descr,",
				"          Color_descr,",
				"          Package_Type_descr,",
				"          Special_Req_descr,",
				"          Case_Pack_desc,",
				"          Full_Name_descr,",
				"          Display_Name_descr,",
				"          Account_Manager_Name,",
				"          Brand_Name,",
				"          Brand_Manager_Name,",
				"          Item_Status_descr,",
				"          Item_Type_descr,",
				"          Maker_Name,",
