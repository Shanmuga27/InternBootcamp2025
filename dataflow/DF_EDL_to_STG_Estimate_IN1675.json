				"          Estimate_Key,",
				"          Delete_Flag,",
				"          Create_Date,",
				"          Date_Created,",
				"          Date_Last_Modified_Gmt,",
				"          Created_By = EDLEstimate@Created_By,",
				"          Created_Timestamp = EDLEstimate@Created_Timestamp,",
				"          Last_Updated_By = EDLEstimate@Last_Updated_By,",
				"          Last_Update_Timestamp = EDLEstimate@Last_Update_Timestamp,",
				"          Sticker_Requirement_Purchase_descr,",
				"          Level_Descr,",
				"          Location_Name,",
				"          Location_Country,",
				"          Location_City,",
				"          Location_State,",
				"          Location_Zipcode,",
				"          Location_Key,",
				"          Delete_Flg,",
				"          Active_Flg,",
				"          Date_Last_Modified,",
				"          Created_By = StgLocations@Created_By,",
				"          Created_Timestamp = StgLocations@Created_Timestamp,",
				"          Last_Updated_By = StgLocations@Last_Updated_By,",
				"          Last_Update_Timestamp = StgLocations@Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> ColumnRemove",
				"Transformations2, StgCustomers join(Company_Id == Customer_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinwithCustomers",
				"JoinwithCustomers, StgItems join(ColumnRemove@Item_Id == StgItems@Item_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinwithItems",
				"JoinwithItems, StgSalesRep join(ColumnRemove@Sales_Rep_Id == StgSalesRep@Sales_Rep_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinwithSalesRep",
				"JoinwithSalesRep select(mapColumn(",
				"          Sales_Estimate_Key = Estimate_Key,",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo_descr = Memo,",
				"          Sticker_Requirements_descr = Sticker_Requirements,",
				"          Inner_Requirements_descr = Inner_Requirements,",
				"          Customer_Requirements_descr = Customer_Requirements,",
				"          Sales_Program_descr = Sales_Program,",
				"          Buyer_Dept_descr = Buyer_Dept,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program_descr = Dept_Program,",
				"          Program_descr = Program_0,",
				"          Cancelled_descr = Cancelled,",
				"          Sticker_Requirement_Purchase_descr,",
				"          Confidence_Factor_descr = Confidence_Factor_Id,",
				"          Level_Descr,",
				"          Final_Destination_Container,",
				"          Customer_Key,",
				"          Company_Id,",
				"          Item_Id = ColumnRemove@Item_Id,",
				"          Location_Id,",
				"          Sales_Rep_Id = ColumnRemove@Sales_Rep_Id,",
				"          TranId,",
				"          Price_Sticker_Id,",
				"          Po,",
				"          Release_Order_Number,",
				"          Quantity_Received_In_Shipment,",
				"          Cntnr_,",
