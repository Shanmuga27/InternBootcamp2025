						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "sourceCUST"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "STGEstimate",
					"rejectedDataLinkedService": {
						"referenceName": "LS_Azure_Blob_Storage",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "LastModDerived",
					"description": "last modified values"
				},
				{
					"name": "ESTjoinPROD"
				},
				{
					"name": "ESTjoinLOC"
				},
				{
					"name": "ESTjoinSALESREP"
				},
				{
					"name": "selectPROD"
				},
				{
