				},
				{
					"name": "selectSALESREP"
				},
				{
					"name": "select1"
				},
				{
					"name": "derived1",
					"description": "derived columns tranf"
				},
				{
					"name": "derived2",
					"description": "derived columns tranf"
				},
				{
					"name": "selectCUST"
				},
				{
					"name": "ESTjoinCUST"
				},
				{
					"name": "surrogateKey1",
					"description": "Primary ID for Estimate"
				},
				{
					"name": "derivedNULL",
					"description": "NULL"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Transaction_Id as integer,",
				"          Transaction_Line_Id as short,",
				"          Memo as string,",
				"          Sticker_Requirements as string,",
				"          Inner_Requirements as string,",
				"          Customer_Requirements as string,",
				"          Sales_Program as string,",
				"          Buyer_Dept as string,",
				"          Buyer_Confirmed_On as string,",
				"          Dept_Program as string,",
				"          Program_0 as string,",
				"          Cancelled as string,",
				"          Confidence_Factor_Id as integer,",
				"          Company_Id as integer,",
				"          Item_Id as integer,",
				"          Location_Id as integer,",
				"          Sales_Rep_Id as integer,",
				"          TranId as string,",
				"          Price_Sticker_Id as string,",
				"          Po as string,",
				"          Release_Order_Number as string,",
				"          Cntnr_ as string,",
				"          Etd_Ship_Date as string,",
				"          Ship_Date_Outbound as string,",
				"          Cancel_Date_Outbound as string,",
				"          Expiration_Date as string,",
				"          Item_Count as string,",
				"          Inner_Qty as string,",
				"          Release_Quantity as string,",
				"          Quantity_Received_In_Shipment as string,",
				"          Item_Unit_Price as string,",
				"          Amount as string,",
				"          Eta_Arrival_Date as string,",
				"          Closed_Script as boolean,",
				"          Estimate_Key as short,",
				"          Delete_Flag as string,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified_Gmt as string,",
				"          Created_By as timestamp,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceEDLestimate",
				"source(output(",
				"          Item_Id as integer,",
				"          Generic_Description as string,",
				"          PurchaseDescription as string,",
				"          Artwork as string,",
				"          Color as string,",
				"          Package_Type as string,",
				"          Special_Requirements as string,",
				"          Case_Pack as string,",
				"          Full_Name as string,",
				"          Display_Name as string,",
				"          Account_Manager_Name as string,",
				"          Brand_Name as string,",
				"          Brand_Manager_Name as string,",
				"          Item_Status as string,",
				"          Item_Type as string,",
				"          Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Master_Carton_Rqmnts as string,",
				"          Trade_Partner_Name as string,",
				"          Part_Of_Assembly_Item as string,",
				"          Type_Name as string,",
				"          Trade_Partner_Code as string,",
				"          VendorName as string,",
				"          UPC as string,",
				"          QunatityOnHand as string,",
				"          SSCC14 as string,",
				"          Master_Carton_Markings_Item_N as string,",
				"          Item_Key as short,",
				"          Delete_Flag as string,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          Active_Flag as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceProducts",
				"source(output(",
				"          Location_Id as integer,",
				"          Name as string,",
				"          City as string,",
				"          Country as string,",
				"          State as string,",
				"          Zipcode as string,",
				"          Location_Key as short,",
				"          Delete_Flag as boolean,",
				"          Create_Date as date,",
				"          Date_Last_Modified as string,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as string,",
				"          Active_Flag as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceLOCATIONS",
				"source(output(",
				"          Sales_Rep_Id as short,",
				"          Sales_Rep_Name as string,",
				"          LoginAccess as boolean,",
				"          Email as string,",
				"          Phone as string,",
				"          Address as string,",
				"          City as string,",
				"          Country as string,",
				"          Sales_Key as short,",
				"          Delete_Flag as boolean,",
				"          Create_Date as date,",
				"          Date_Last_Modified as string,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as string,",
				"          Active_Flag as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceSALESREP",
				"source(output(",
				"          Customer_Id as integer,",
				"          Company_Name as string,",
				"          Customer_Key as short,",
				"          Delete_Flag as boolean,",
				"          Create_Date as date,",
				"          Date_Last_Modified as string,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as string,",
				"          Active_Flag as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceCUST",
				"sourceEDLestimate derive(Last_Modified_Date = currentTimestamp(),",
				"          Last_Modified_Time = currentTimestamp(),",
				"          Last_Modified_GMT = currentUTC(),",
				"          Last_Updated_By = 'IN1686 Sanjay Komala') ~> LastModDerived",
				"LastModDerived, selectPROD join(sourceEDLestimate@Item_Id == selectPROD@Item_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> ESTjoinPROD",
				"ESTjoinPROD, selectLOCATIONS join(sourceEDLestimate@Location_Id == selectLOCATIONS@Location_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> ESTjoinLOC",
				"ESTjoinLOC, selectSALESREP join(sourceEDLestimate@Sales_Rep_Id == selectSALESREP@Sales_Rep_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> ESTjoinSALESREP",
				"sourceProducts select(mapColumn(",
				"          Item_Id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectPROD",
				"sourceLOCATIONS select(mapColumn(",
				"          Location_Id,",
				"          Location_Name = Name,",
				"          Location_City = City",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectLOCATIONS",
				"sourceSALESREP select(mapColumn(",
				"          Sales_Rep_Id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectSALESREP",
				"ESTjoinCUST select(mapColumn(",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo_descr = Memo,",
				"          Sticker_Requirements_Descr = Sticker_Requirements,",
				"          Inner_Requirements_Descr = Inner_Requirements,",
				"          Customer_Requirements_Descr = Customer_Requirements,",
				"          Sales_Program_Descr = Sales_Program,",
				"          Buyer_Dept_Descr = Buyer_Dept,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program_Descr = Dept_Program,",
				"          Program_Descr = Program_0,",
				"          Cancelled_Descr = Cancelled,",
				"          Confidence_Factor_Id,",
				"          Company_Id,",
				"          Item_Id = sourceEDLestimate@Item_Id,",
				"          Location_Id = sourceEDLestimate@Location_Id,",
				"          Sales_Rep_Id = sourceEDLestimate@Sales_Rep_Id,",
				"          Document_Nbr = TranId,",
				"          Price_Sticker_Id,",
				"          PO_Nbr = Po,",
				"          Release_Order_Nbr = Release_Order_Number,",
				"          CNTNR_Nbr = Cntnr_,",
				"          ETD_Ship_Date = Etd_Ship_Date,",
				"          Ship_Date_Outbound_Date = Ship_Date_Outbound,",
				"          Cancel_Date_Outbound_Date = Cancel_Date_Outbound,",
				"          Expiration_Date,",
				"          ETA_Arrival_Date = Eta_Arrival_Date,",
				"          Item_Qty = Item_Count,",
				"          Inner_Qty,",
				"          Release_Qty = Release_Quantity,",
				"          Quantity_Received_In_Shipment,",
				"          Item_Unit_Price,",
				"          Amount,",
				"          Created_Date = Create_Date,",
				"          Last_Modified_Date,",
				"          Delete_Flag,",
				"          Created_Time = Created_Timestamp,",
				"          Created_By,",
				"          Last_Modified_Time,",
				"          Last_Updated_By,",
				"          Last_Modified_GMT,",
				"          Customer_Id_KEY = Customer_Id_Key,",
				"          Sales_Rep_Id_KEY = sourceEDLestimate@Sales_Rep_Id,",
				"          Item_Id_KEY = selectPROD@Item_Id,",
				"          Location_Id_KEY = sourceEDLestimate@Location_Id,",
				"          Location_Name,",
				"          Location_City",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> select1",
				"select1 derive(Sticker_Requirement_Purchase_descr = iif(Sticker_Requirements_Descr=='NULL' || Sticker_Requirements_Descr=='0', 'No stickers', iif(Inner_Requirements_Descr=='NULL' && Customer_Requirements_Descr=='NULL', Sticker_Requirements_Descr, Sticker_Requirements_Descr)),",
				"          Confidence_Factor_descr = toString(iif(Confidence_Factor_Id==1, '25%', iif(Confidence_Factor_Id==2, '50%', iif(Confidence_Factor_Id==3, '75%', iif(Confidence_Factor_Id==4, '90%', iif(Confidence_Factor_Id==5, 'Dropped', iif(Confidence_Factor_Id==6, 'Actual', iif(Confidence_Factor_Id==7, '90%-Pre', iif(Confidence_Factor_Id==8, '90%-Releases', 'Invalid'))))))))),",
				"          Final_Destination_Container = concat(Location_Name, Location_City),",
				"          PRICE_STICKER_descr = case(like(Sticker_Requirements_Descr,'price sticker'), concat(Sticker_Requirements_Descr ,'$',Price_Sticker_Id), 'No sticker'),",
				"          Month_Ship_Date = concat(toString(year(toTimestamp(Ship_Date_Outbound_Date))),'-',toString(month(toTimestamp(Ship_Date_Outbound_Date)))),",
				"          ETD_date = iif(\r",
				"    like(Location_Name,'%DotCom Distribution - Edison NJ%'), subDays(toDate(Ship_Date_Outbound_Date),66),\r",
				"    iif(like(Location_Name,'%Berkley%'), subDays(toDate(Ship_Date_Outbound_Date),59),\r",
				"    iif(like(Location_Name,'%POE China%'), subDays(toDate(Ship_Date_Outbound_Date),14),\r",
				"    iif(like(Location_Name,'%POE OAK%'), subDays(toDate(Ship_Date_Outbound_Date),59),\r",
				"    iif(like(Location_Name,'%POE Vietnam%'), subDays(toDate(Ship_Date_Outbound_Date),14),\r",
				"    subDays(toDate(Ship_Date_Outbound_Date),45)\r",
				"))))),",
				"          MS_Domestic_Ship_Date = subDays(toTimestamp(ETD_Ship_Date),45),",
				"          MS_Domestic_Cancel_Date = addDays(toTimestamp(ETD_Ship_Date), 55)) ~> derived1",
				"derived1 derive(Level_Descr = iif(Confidence_Factor_descr=='25%', '', iif(Confidence_Factor_descr=='50%', '', iif(Confidence_Factor_descr=='Dropped', '', iif(Confidence_Factor_descr=='75%', 'Pending Confirmation', iif(Confidence_Factor_descr=='90%', 'Pending Approval', iif(Confidence_Factor_descr=='Actual', 'Confirmed', iif(Confidence_Factor_descr=='90%-Pre', 'Confirmed', iif(Confidence_Factor_descr=='90%-Releases', 'Confirmed', 'Invalid')))))))),",
				"          Month_ETD_date = toTimestamp(concat(toString(year(ETD_date)),'-',toString(month(ETD_date))))) ~> derived2",
				"sourceCUST select(mapColumn(",
				"          Customer_Id_Key = Customer_Id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectCUST",
				"ESTjoinSALESREP, selectCUST join(Company_Id == Customer_Id_Key,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> ESTjoinCUST",
				"derived2 keyGenerate(output(Sales_Estimate_Key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1 derive(each(match(type=='string'), $$ = replace(iifNull($$, \"UNK\"),'NULL', 'UNK')),",
				"          each(match(type=='integer'), $$ = iifNull($#, 0)),",
				"          each(match(type=='timestamp'), $$ = iifNull($$, toTimestamp('1900-01-01 00:00:00', 'yyyy-MM-dd HH:mm:ss'))),",
				"          each(match(type=='date'), $$ = iifNull($$, toDate('1900-01-01', 'yyyy-MM-dd')))) ~> derivedNULL",
				"derivedNULL sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['W2_Estimate_STG_IN1686.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> STGEstimate"
			]
		}
	}
}