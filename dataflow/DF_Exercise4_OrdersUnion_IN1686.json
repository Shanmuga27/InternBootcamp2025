{
	"name": "DF_Exercise4_OrdersUnion_IN1686",
	"properties": {
		"folder": {
			"name": "EXERCISE"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "SrcOrders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "AllOrdersUnionedIN1686"
				}
			],
			"transformations": [
				{
					"name": "RecentOrders"
				},
				{
					"name": "OrderTypeRecent"
				},
				{
					"name": "OrderTypeOld"
				},
				{
					"name": "UnionOldRecentOrders"
				},
				{
					"name": "Dedupliacte"
				},
				{
					"name": "latestOrderDateperOrderID"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename as string",
				"}",
				"source(output(",
				"          OrderID as string,",
				"          CustomerID as string,",
				"          ProductID as string,",
				"          OrderDate as date,",
				"          Amount as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcOrders",
				"SrcOrders split(OrderDate >= addMonths(currentDate(), -12),",
				"     OrderDate <  addMonths(currentDate(), -12),",
				"     disjoint: false) ~> RecentOrders@(RecentOrders, OldOrders)",
				"RecentOrders@RecentOrders derive(OrderType = \"Recent\") ~> OrderTypeRecent",
				"RecentOrders@OldOrders derive(OrderType = \"Old\") ~> OrderTypeOld",
				"OrderTypeRecent, OrderTypeOld union(byName: true)~> UnionOldRecentOrders",
				"UnionOldRecentOrders window(over(OrderID),",
				"     desc(OrderDate, true),",
				"     Row_Column = rowNumber()) ~> Dedupliacte",
				"Dedupliacte filter(Row_Column == 1) ~> latestOrderDateperOrderID",
				"latestOrderDateperOrderID sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:[($filename)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> AllOrdersUnionedIN1686"
			]
		}
	}
}