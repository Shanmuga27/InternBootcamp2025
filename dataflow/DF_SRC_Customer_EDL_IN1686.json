{
	"name": "DF_SRC_Customer_EDL_IN1686",
	"properties": {
		"folder": {
			"name": "workshop/SRC_EDL"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Excel_IN1686",
						"type": "DatasetReference"
					},
					"name": "SrcCustomers"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "W2CustomersEDLIN1686"
				}
			],
			"transformations": [
				{
					"name": "AduitColumn"
				},
				{
					"name": "select1"
				},
				{
					"name": "CustomerKey"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename1 as string",
				"}",
				"source(output(",
				"          Customer_Key as integer,",
				"          Customer_Id as integer,",
				"          Company_Name as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcCustomers",
				"CustomerKey derive(Delete_Flag = \"N\",",
				"          Create_Date = currentDate(),",
				"          Date_Last_Modified = toTimestamp(\"1990-01-01\", \"dd-MM-yyyy hh:mm:ss\"),",
				"          Created_By = \"IN1868_Sanjay_Komala\",",
				"          Created_Timestamp = currentTimestamp(),",
				"          Last_Updated_By = toString(null()),",
				"          Last_Update_Timestamp = toTimestamp(\"1990-01-01\"),",
				"          Active_Flag = \"Y\") ~> AduitColumn",
				"SrcCustomers select(mapColumn(",
				"          Customer_Id,",
				"          Company_Name",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 keyGenerate(output(Customer_Key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> CustomerKey",
				"AduitColumn sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:[($filename1)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> W2CustomersEDLIN1686"
			]
		}
	}
}