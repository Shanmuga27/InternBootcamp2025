{
	"name": "DF_referential_integrity",
	"properties": {
		"folder": {
			"name": "QA workshop"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "SRCdimorders"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "SRCFactOrders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "SNKInvalidRecords"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCdimorders",
				"source(output(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCFactOrders",
				"SRCdimorders sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SNKInvalidRecords"
			]
		}
	}
}