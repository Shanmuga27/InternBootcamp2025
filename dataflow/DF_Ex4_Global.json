{
	"name": "DF_Ex4_Global",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "Customers"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "Orders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "TgtAPAC"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "TgtEMEA"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "TgtAMER"
				}
			],
			"transformations": [
				{
					"name": "RegionColumn"
				},
				{
					"name": "split1"
				},
				{
					"name": "CustomerAndOrders"
				},
				{
					"name": "CustomerID"
				},
				{
					"name": "Amount"
				},
				{
					"name": "Name"
				}
			],
			"scriptLines": [
				"parameters{",
				"     pRegion as string[] ([\"APAC\",\"EMEA\",\"AMER\"])",
				"}",
				"source(output(",
				"          CustomerID as string,",
				"          Name as string,",
				"          Country as string,",
				"          Age as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Customers",
				"source(output(",
				"          OrderID as string,",
				"          CustomerID as string,",
				"          ProductID as string,",
				"          OrderDate as date,",
				"          Amount as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Orders",
				"CustomerAndOrders derive(Region = iif(\r",
				"   Country == 'India' || Country == 'Australia', 'APAC',\r",
				"   iif(\r",
				"      Country == 'UK', 'EMEA',\r",
				"      iif(\r",
				"         Country == 'USA' || Country == 'Canada', 'AMER',\r",
				"         'UNK'\r",
				"      )\r",
				"   )\r",
				")\r",
				" ) ~> RegionColumn",
				"RegionColumn split($pRegion[1]==Region,",
				"     $pRegion[2]==Region,",
				"     $pRegion[3]==Region,",
				"     disjoint: false) ~> split1@(APAC, EMEA, AMER)",
				"Customers, Orders join(Customers@CustomerID == Orders@CustomerID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> CustomerAndOrders",
				"split1@APAC filter(startsWith(split1@APAC@CustomerID, 'A')) ~> CustomerID",
				"split1@EMEA filter(Amount>2000 ) ~> Amount",
				"split1@AMER filter(regexMatch(Name, 'Inc')) ~> Name",
				"CustomerID sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Orders_APAC.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> TgtAPAC",
				"Amount sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Orders_EMEA.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> TgtEMEA",
				"Name sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Customers_AMER.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> TgtAMER"
			]
		}
	}
}