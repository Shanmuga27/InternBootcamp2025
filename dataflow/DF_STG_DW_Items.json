				}
			],
			"scriptLines": [
				"source(output(",
				"          Item_Id as integer,",
				"          Item_Key as integer,",
				"          Item_Descr as string,",
				"          Brand_desr as string,",
				"          Artwork_descr as string,",
				"          Color_descr as string,",
				"          Package_Type_descr as string,",
				"          Special_Req_descr as string,",
				"          Case_Pack_desc as string,",
				"          Full_Name_descr as string,",
				"          Display_Name_descr as string,",
				"          Account_Manager_Name as string,",
				"          Brand_Name as string,",
				"          Brand_Manager_Name as string,",
				"          Item_Status_descr as string,",
				"          Item_Type_descr as string,",
				"          Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Master_Carton_Req_descr as string,",
				"          Trade_Partner_Name as string,",
				"          Type_Name as string,",
				"          Trade_Partner_Code as string,",
				"          Vendor_Name as string,",
				"          UPC_nbr as string,",
				"          On_Hand_Quantity as integer,",
				"          SSCC14_nbr as integer,",
				"          Master_Carton_Markings_Item_Nbr as integer,",
				"          Part_Of_Assembly_Item as string,",
				"          Delete_Flag as string,",
				"          Active_Flag as string,",
				"          Create_Date as timestamp,",
				"          Date_last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcItems",
				"source(output(",
				"          Item_key as integer,",
				"          Item_ID as integer,",
				"          Item_Descr as string,",
				"          Brand_Descr as string,",
				"          Artwork_Descr as string,",
				"          Color_Descr as string,",
				"          Package_Type_Descr as string,",
				"          Special_Req_Descr as string,",
				"          Case_Pack_Descr as string,",
				"          Full_Name_Descr as string,",
				"          Display_name_Descr as string,",
				"          Account_Manager_Name as string,",
				"          Brand_Name as string,",
				"          Brand_Manager_Name as string,",
				"          Item_Status_Descr as string,",
				"          Item_Type_Descr as string,",
				"          Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Master_Carton_Req_Descr as string,",
				"          Trade_Partner_Name as string,",
				"          Type_Name as string,",
				"          Trade_Partner_Cd as string,",
				"          Vendor_Name as string,",
				"          UPC_Nbr as string,",
				"          On_Hand_Quantity as integer,",
				"          SSCC14_Nbr as integer,",
				"          Master_Carton_Item_Nbr as integer,",
				"          Create_Date as string,",
				"          Date_Last_Modified as timestamp,",
				"          Delete_Flag as string,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          prev_brand_manager_name as string,",
				"          prev_producr_manager_name as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TgtItems",
				"SrcItems, TgtItems join(SrcItems@Item_Id == TgtItems@Item_ID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"derivedColumn1 select(mapColumn(",
				"          Item_Id = split1@NewRows@Item_Id,",
				"          Item_Key = split1@NewRows@Item_Key,",
				"          Item_Descr = split1@NewRows@Item_Descr,",
				"          Brand_desr,",
				"          Artwork_descr = split1@NewRows@Artwork_descr,",
				"          Color_descr = split1@NewRows@Color_descr,",
				"          Package_Type_descr = split1@NewRows@Package_Type_descr,",
				"          Special_Req_descr = split1@NewRows@Special_Req_descr,",
				"          Case_Pack_desc,",
				"          Full_Name_descr = split1@NewRows@Full_Name_descr,",
				"          Display_Name_descr = split1@NewRows@Display_Name_descr,",
				"          Account_Manager_Name = split1@NewRows@Account_Manager_Name,",
				"          Brand_Name = split1@NewRows@Brand_Name,",
				"          Brand_Manager_Name = split1@NewRows@Brand_Manager_Name,",
				"          Item_Status_descr = split1@NewRows@Item_Status_descr,",
				"          Item_Type_descr = split1@NewRows@Item_Type_descr,",
				"          Maker_Name = split1@NewRows@Maker_Name,",
				"          Product_Manager_Name = split1@NewRows@Product_Manager_Name,",
				"          Master_Carton_Req_descr = split1@NewRows@Master_Carton_Req_descr,",
				"          Trade_Partner_Name = split1@NewRows@Trade_Partner_Name,",
				"          Type_Name = split1@NewRows@Type_Name,",
				"          Trade_Partner_Code,",
				"          Vendor_Name = split1@NewRows@Vendor_Name,",
				"          UPC_nbr = split1@NewRows@UPC_nbr,",
				"          On_Hand_Quantity = split1@NewRows@On_Hand_Quantity,",
				"          SSCC14_nbr = split1@NewRows@SSCC14_nbr,",
				"          Master_Carton_Markings_Item_Nbr,",
				"          prev_brand_manager_name,",
				"          prev_producr_manager_name,",
				"          Delete_Flag = split1@NewRows@Delete_Flag,",
				"          Create_Date,",
				"          Date_last_Modified = derivedColumn1@Date_last_Modified,",
				"          Created_By,",
				"          Created_Timestamp = split1@NewRows@Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"join1 split(isNull(TgtItems@Item_ID),",
				"     !isNull(TgtItems@Item_ID) && SrcItems@Brand_Manager_Name != TgtItems@Brand_Manager_Name,",
				"     !isNull(TgtItems@Item_ID) && TgtItems@Product_Manager_Name != SrcItems@Product_Manager_Name",
				",",
				"     disjoint: false) ~> split1@(NewRows, BrandChanged, ProductChanged)",
				"split1@NewRows derive(prev_brand_manager_name = 'unk',",
				"          prev_producr_manager_name = 'unk',",
				"          Create_Date = toTimestamp(currentDate()),",
				"          Created_By = 'IN1675',",
				"          Date_last_Modified = toTimestamp(currentDate()),",
				"          Last_Updated_By = 'IN1675',",
				"          Last_Update_Timestamp = currentTimestamp()) ~> derivedColumn1",
				"split1@BrandChanged derive(Brand_Manager_Name = split1@BrandChanged@Brand_Manager_Name,",
				"          prev_brand_manager_name = split1@BrandChanged@Brand_Manager_Name,",
				"          Date_Last_Modified = toTimestamp(currentDate()),",
				"          Last_Updated_By = 'IN1675',",
				"          Last_Update_Timestamp = currentTimestamp(),",
				"          Delete_Flag = 'Y') ~> derivedColumn2",
				"split1@ProductChanged derive(Product_Manager_Name = split1@ProductChanged@Product_Manager_Name,",
				"          prev_producr_manager_name = split1@ProductChanged@Product_Manager_Name,",
				"          Last_Updated_By = 'IN1675',",
				"          Date_last_Modified = toTimestamp(currentDate()),",
				"          Last_Update_Timestamp = currentTimestamp()\r",
				",",
				"          Delete_Flag = 'Y') ~> derivedColumn3",
				"derivedColumn2 select(mapColumn(",
				"          Item_Id = split1@BrandChanged@Item_Id,",
				"          Item_Key = split1@BrandChanged@Item_Key,",
				"          Item_Descr = split1@BrandChanged@Item_Descr,",
				"          Brand_desr,",
				"          Artwork_descr = split1@BrandChanged@Artwork_descr,",
				"          Color_descr = split1@BrandChanged@Color_descr,",
				"          Package_Type_descr = split1@BrandChanged@Package_Type_descr,",
				"          Special_Req_descr = split1@BrandChanged@Special_Req_descr,",
				"          Case_Pack_desc,",
				"          Full_Name_descr = split1@BrandChanged@Full_Name_descr,",
				"          Display_Name_descr = split1@BrandChanged@Display_Name_descr,",
				"          Account_Manager_Name = split1@BrandChanged@Account_Manager_Name,",
				"          Brand_Name = split1@BrandChanged@Brand_Name,",
				"          Brand_Manager_Name,",
				"          Item_Status_descr = split1@BrandChanged@Item_Status_descr,",
				"          Item_Type_descr = split1@BrandChanged@Item_Type_descr,",
				"          Maker_Name = split1@BrandChanged@Maker_Name,",
				"          Product_Manager_Name = split1@BrandChanged@Product_Manager_Name,",
				"          Master_Carton_Req_descr = split1@BrandChanged@Master_Carton_Req_descr,",
				"          Trade_Partner_Name = split1@BrandChanged@Trade_Partner_Name,",
				"          Type_Name = split1@BrandChanged@Type_Name,",
				"          Trade_Partner_Code,",
				"          Vendor_Name = split1@BrandChanged@Vendor_Name,",
				"          UPC_nbr = split1@BrandChanged@UPC_nbr,",
				"          On_Hand_Quantity = split1@BrandChanged@On_Hand_Quantity,",
				"          SSCC14_nbr = split1@BrandChanged@SSCC14_nbr,",
				"          Master_Carton_Markings_Item_Nbr,",
				"          prev_brand_manager_name,",
				"          prev_producr_manager_name,",
				"          Delete_Flag,",
				"          Create_Date = split1@BrandChanged@Create_Date,",
				"          Date_last_Modified = split1@BrandChanged@Date_last_Modified,",
				"          Created_By = split1@BrandChanged@Created_By,",
				"          Created_Timestamp = split1@BrandChanged@Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"derivedColumn3 select(mapColumn(",
				"          Item_Id = split1@ProductChanged@Item_Id,",
				"          Item_Key = split1@ProductChanged@Item_Key,",
				"          Item_Descr = split1@ProductChanged@Item_Descr,",
				"          Brand_desr,",
				"          Artwork_descr = split1@ProductChanged@Artwork_descr,",
				"          Color_descr = split1@ProductChanged@Color_descr,",
				"          Package_Type_descr = split1@ProductChanged@Package_Type_descr,",
				"          Special_Req_descr = split1@ProductChanged@Special_Req_descr,",
				"          Case_Pack_desc,",
				"          Full_Name_descr = split1@ProductChanged@Full_Name_descr,",
				"          Display_Name_descr = split1@ProductChanged@Display_Name_descr,",
				"          Account_Manager_Name = split1@ProductChanged@Account_Manager_Name,",
				"          Brand_Name = split1@ProductChanged@Brand_Name,",
				"          Brand_Manager_Name = split1@ProductChanged@Brand_Manager_Name,",
				"          Item_Status_descr = split1@ProductChanged@Item_Status_descr,",
				"          Item_Type_descr = split1@ProductChanged@Item_Type_descr,",
				"          Maker_Name = split1@ProductChanged@Maker_Name,",
				"          Product_Manager_Name,",
				"          Master_Carton_Req_descr = split1@ProductChanged@Master_Carton_Req_descr,",
				"          Trade_Partner_Name = split1@ProductChanged@Trade_Partner_Name,",
				"          Type_Name = split1@ProductChanged@Type_Name,",
				"          Trade_Partner_Code,",
				"          Vendor_Name = split1@ProductChanged@Vendor_Name,",
				"          UPC_nbr = split1@ProductChanged@UPC_nbr,",
				"          On_Hand_Quantity = split1@ProductChanged@On_Hand_Quantity,",
				"          SSCC14_nbr = split1@ProductChanged@SSCC14_nbr,",
				"          Master_Carton_Markings_Item_Nbr,",
				"          Delete_Flag,",
				"          Create_Date = split1@ProductChanged@Create_Date,",
				"          Date_last_Modified = derivedColumn3@Date_last_Modified,",
				"          Created_By = split1@ProductChanged@Created_By,",
				"          Created_Timestamp = split1@ProductChanged@Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp,",
				"          prev_brand_manager_name,",
				"          prev_producr_manager_name",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1, select2, select3 union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['DW_Product.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> DWItems"
			]
		}
	}
