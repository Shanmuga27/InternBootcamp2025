{
	"name": "DF_STG_DW_Items",
	"properties": {
		"folder": {
			"name": "Workshop_IN1675/STG_DW_IN1675"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "SrcItems"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "TgtItems"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "select2"
				},
				{
					"name": "union1"
				},
				{
					"name": "select4"
				},
				{
					"name": "select5"
				}
			],
			"scriptLines": [
				"source(output(",
				"          emp_id as integer,",
				"          {name } as string,",
				"          phone as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcItems",
				"source(output(",
				"          emp_id as short,",
				"          {name } as string,",
				"          phone as short,",
				"          isactive as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TgtItems",
				"select4, select5 join(srcemp_id == tgtemp_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"derivedColumn1 select(mapColumn(",
				"          emp_id = srcemp_id,",
				"          {name } = {srcname },",
				"          phone = srcphone,",
				"          Create_Date,",
				"          Created_By,",
				"          Date_last_Modified,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"join1 split(isNull(tgtemp_id),",
				"     !isNull(tgtemp_id) && srcphone != tgtphone,",
				"     disjoint: false) ~> split1@(NewRows, Phone)",
				"split1@NewRows derive(Create_Date = toTimestamp(currentDate()),",
				"          Created_By = 'IN1675',",
				"          Date_last_Modified = toTimestamp(currentDate()),",
				"          Last_Updated_By = 'IN1675',",
				"          Last_Update_Timestamp = currentTimestamp()) ~> derivedColumn1",
				"split1@Phone derive(tgtphone = srcphone,",
				"          prev_phone = tgtphone,",
				"          Date_Last_Modified = toTimestamp(currentDate()),",
				"          Last_Updated_By = 'IN1675',",
				"          Last_Update_Timestamp = currentTimestamp()) ~> derivedColumn2",
				"derivedColumn2 select(mapColumn(",
				"          emp_id = srcemp_id,",
				"          {name } = {srcname },",
				"          phone = srcphone,",
				"          prev_phone,",
				"          Date_Last_Modified,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select1, select2 union(byName: true)~> union1",
				"SrcItems select(mapColumn(",
				"          each(match(true()),",
				"               'src'+$$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"TgtItems select(mapColumn(",
				"          each(match(true()),",
				"               'tgt'+$$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select5"
			]
		}
	}
}