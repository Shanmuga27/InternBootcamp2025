{
	"name": "DF_DistinctCountCheck",
	"properties": {
		"folder": {
			"name": "Module_Practice/Testing"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "DimCustomers"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "DVCustomer"
				}
			],
			"transformations": [
				{
					"name": "windowFunction"
				},
				{
					"name": "filterRn"
				}
			],
			"scriptLines": [
				"source(output(",
				"          customer_id as integer,",
				"          customer_key as short,",
				"          first_name as string,",
				"          last_name as string,",
				"          customer_name as string,",
				"          email as string,",
				"          country as string,",
				"          isActive as boolean,",
				"          start_date as timestamp,",
				"          end_date as string,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as string,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DimCustomers",
				"DimCustomers window(over(customer_id),",
				"     asc(customer_id, true),",
				"     rn = rowNumber()) ~> windowFunction",
				"windowFunction filter(rn==1) ~> filterRn",
				"filterRn sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Valid_Distinct_Customers'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> DVCustomer"
			]
		}
	}
}