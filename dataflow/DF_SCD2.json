{
	"name": "DF_SCD2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "split1"
				},
				{
					"name": "select1"
				},
				{
					"name": "union1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "alterRow2"
				},
				{
					"name": "select4"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "alterRow3"
				},
				{
					"name": "select5"
				},
				{
					"name": "select6"
				}
			],
			"scriptLines": [
				"source(output(",
				"          emp_id as integer,",
				"          {name } as string,",
				"          phone as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          emp_id as integer,",
				"          {name } as string,",
				"          phone as integer,",
				"          isactive as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"source1, source2 join(source1@emp_id == source2@emp_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 split(isNull(source2@emp_id),",
				"     !isNull(source2@emp_id) && source1@phone!=source2@phone,",
				"     !isNull(source2@emp_id) && source1@phone==source2@phone,",
				"     disjoint: false) ~> split1@(Insert, Update, Existing)",
				"alterRow1 select(mapColumn(",
				"          emp_id = split1@Insert@emp_id,",
				"          {name } = split1@Insert@{name },",
				"          phone = split1@Insert@phone,",
				"          isactive",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, select5, select4, select6 union(byName: true)~> union1",
				"split1@Insert derive(isactive = 1) ~> derivedColumn1",
				"split1@Update derive(isactive = 1) ~> derivedColumn4",
				"derivedColumn1 alterRow(insertIf(true())) ~> alterRow1",
				"derivedColumn4 alterRow(insertIf(true())) ~> alterRow2",
				"alterRow2 select(mapColumn(",
				"          emp_id = split1@Update@emp_id,",
				"          {name } = split1@Update@{name },",
				"          phone = split1@Update@phone,",
				"          isactive",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"split1@Update derive(isactive = 0) ~> derivedColumn5",
				"derivedColumn5 alterRow(updateIf(true())) ~> alterRow3",
				"alterRow3 select(mapColumn(",
				"          emp_id = split1@Update@emp_id,",
				"          {name } = split1@Update@{name },",
				"          phone = split1@Update@phone,",
				"          isactive",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select5",
				"split1@Existing select(mapColumn(",
				"          emp_id = split1@Existing@emp_id,",
				"          {name } = split1@Existing@{name },",
				"          phone = split1@Existing@phone,",
				"          isactive",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select6"
			]
		}
	}
}