{
	"name": "DF_Orders_incre",
	"properties": {
		"folder": {
			"name": "IN1677_Mock"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Src",
						"type": "DatasetReference"
					},
					"name": "srcOrders"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Src",
						"type": "DatasetReference"
					},
					"name": "tgtOrders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Src",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "surrogateKey1"
				},
				{
					"name": "split1"
				},
				{
					"name": "join1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as integer,",
				"          CustomerID as integer,",
				"          OrderAmount as integer,",
				"          OrderDate as string,",
				"          Status as string,",
				"          created_date as timestamp,",
				"          {created_by } as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcOrders",
				"source(output(",
				"          OrderID as integer,",
				"          CustomerID as integer,",
				"          OrderAmount as string,",
				"          OrderDate as string,",
				"          Status as string,",
				"          created_date as timestamp,",
				"          {created_by } as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string,",
				"          order_key as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> tgtOrders",
				"srcOrders keyGenerate(output(order_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"join1 split(srcOrders@OrderDate > tgtOrders@OrderDate,",
				"     disjoint: false) ~> split1@(insert)",
				"surrogateKey1, tgtOrders join(srcOrders@OrderID == tgtOrders@OrderID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"split1@insert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Fact_orders_IN1677'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}