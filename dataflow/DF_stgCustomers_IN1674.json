{
	"name": "DF_stgCustomers_IN1674",
	"properties": {
		"folder": {
			"name": "MockTest/STG_to_TRG"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "cus"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "surrogateKey1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				},
				{
					"name": "split1"
				},
				{
					"name": "join1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          customer_id as short,",
				"          first_name as string,",
				"          last_name as string,",
				"          email as string,",
				"          country as string,",
				"          {created date} as date,",
				"          {created by } as string,",
				"          {updated date} as date,",
				"          {updated by} as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> cus",
				"cus keyGenerate(output(customer_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1 derive(customer_name = first_name,",
				"          email = concat(first_name, last_name),",
				"          isActive = \"Y/N\",",
				"          start_date = currentDate(),",
				"          end_date = \"1990-01-01\",",
				"          current_country = \"updated\") ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          customer_id,",
				"          first_name,",
				"          last_name,",
				"          email,",
				"          country,",
				"          {created date},",
				"          {created by },",
				"          {updated date},",
				"          {updated by},",
				"          runid,",
				"          customer_key,",
				"          customer_name,",
				"          isActive,",
				"          start_date,",
				"          end_date,",
				"          current_country",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 split(customer_id,",
				"     disjoint: false) ~> split1@(currentcountry, new)",
				"split1@currentcountry, split1@new join(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}