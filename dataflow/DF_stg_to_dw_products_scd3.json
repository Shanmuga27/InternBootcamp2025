{
	"name": "DF_stg_to_dw_products_scd3",
	"properties": {
		"folder": {
			"name": "stg_to_dw"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "join1"
				},
				{
					"name": "split1"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "alterRow2"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename as string",
				"}",
				"source(output(",
				"          Sales_Rep_Id as integer,",
				"          Sales_Rep_Name as string,",
				"          Sales_Rep_LoginAccess as string,",
				"          Sales_Rep_Email as string,",
				"          Sales_Rep_Phone as string,",
				"          Sales_Rep_Address as string,",
				"          Sales_Rep_City as string,",
				"          Sales_Rep_Country as string,",
				"          Sales_key as integer,",
				"          Delete_flag as string,",
				"          Created_by as string,",
				"          Created_timestamp as timestamp,",
				"          Last_updated_by as string,",
				"          Last_updated_timestamp as timestamp,",
				"          Active_flag as string,",
				"          Created_date as timestamp,",
				"          Date_last_modified as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          Sales_Rep_Id as integer,",
				"          Sales_Rep_Name as string,",
				"          Sales_Rep_LoginAccess as string,",
				"          Sales_Rep_Email as string,",
				"          Sales_Rep_Phone as string,",
				"          Sales_Rep_Address as string,",
				"          Sales_Rep_City as string,",
				"          Sales_Rep_Country as string,",
				"          Sales_key as string,",
				"          Delete_flag as string,",
				"          Created_by as string,",
				"          Created_timestamp as timestamp,",
				"          Last_updated_by as string,",
				"          Last_updated_timestamp as timestamp,",
				"          Active_flag as string,",
				"          Created_date as timestamp,",
				"          Date_last_modified as timestamp,",
				"          previous_Sales_Rep_City as string,",
				"          previous_Sales_Rep_Country as string,",
				"          current_Sales_Rep_Country as string,",
				"          current_Sales_Rep_City as string,",
				"          current_Sales_Rep_Phone as string,",
				"          previous_Sales_Rep_Phone as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"source1 select(mapColumn(",
				"          src_Sales_Rep_Id = Sales_Rep_Id,",
				"          src_Sales_Rep_Name = Sales_Rep_Name,",
				"          src_Sales_Rep_LoginAccess = Sales_Rep_LoginAccess,",
				"          src_Sales_Rep_Email = Sales_Rep_Email,",
				"          src_Sales_Rep_Phone = Sales_Rep_Phone,",
				"          src_Sales_Rep_Address = Sales_Rep_Address,",
				"          src_Sales_Rep_City = Sales_Rep_City,",
				"          src_Sales_Rep_Country = Sales_Rep_Country,",
				"          src_Sales_key = Sales_key,",
				"          src_Delete_flag = Delete_flag,",
				"          src_Created_by = Created_by,",
				"          src_Created_timestamp = Created_timestamp,",
				"          src_Last_updated_by = Last_updated_by,",
				"          src_Last_updated_timestamp = Last_updated_timestamp,",
				"          src_Active_flag = Active_flag,",
				"          src_Created_date = Created_date,",
				"          src_Date_last_modified = Date_last_modified",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, source2 join(src_Sales_Rep_Id == Sales_Rep_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 split(isNull(Sales_Rep_Id),",
				"     !isNull(Sales_Rep_Id) && ( current_Sales_Rep_Country!=src_Sales_Rep_Country || current_Sales_Rep_Phone!=src_Sales_Rep_Phone || current_Sales_Rep_City!=src_Sales_Rep_City),",
				"     disjoint: false) ~> split1@(insert, update)",
				"split1@insert select(mapColumn(",
				"          Sales_Rep_Id = src_Sales_Rep_Id,",
				"          Sales_Rep_Name = src_Sales_Rep_Name,",
				"          Sales_Rep_LoginAccess = src_Sales_Rep_LoginAccess,",
				"          Sales_Rep_Email = src_Sales_Rep_Email,",
				"          Sales_Rep_Phone = src_Sales_Rep_Phone,",
				"          Sales_Rep_Address = src_Sales_Rep_Address,",
				"          Sales_Rep_City = src_Sales_Rep_City,",
				"          Sales_Rep_Country = src_Sales_Rep_Country,",
				"          Sales_key = src_Sales_key,",
				"          Delete_flag = src_Delete_flag,",
				"          Created_by = src_Created_by,",
				"          Created_timestamp = src_Created_timestamp,",
				"          Last_updated_by = src_Last_updated_by,",
				"          Last_updated_timestamp = src_Last_updated_timestamp,",
				"          Active_flag = src_Active_flag,",
				"          Created_date = src_Created_date,",
				"          Date_last_modified = src_Date_last_modified,",
				"          current_Sales_Rep_Country = src_Sales_Rep_Country,",
				"          current_Sales_Rep_City = src_Sales_Rep_City,",
				"          current_Sales_Rep_Phone = src_Sales_Rep_Phone",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"split1@update select(mapColumn(",
				"          src_Sales_Rep_Id,",
				"          src_Sales_Rep_Name,",
				"          src_Sales_Rep_LoginAccess,",
				"          src_Sales_Rep_Email,",
				"          src_Sales_Rep_Phone,",
				"          src_Sales_Rep_Address,",
				"          src_Sales_Rep_City,",
				"          src_Sales_Rep_Country,",
				"          src_Sales_key,",
				"          src_Delete_flag,",
				"          src_Created_by,",
				"          src_Created_timestamp,",
				"          src_Last_updated_by,",
				"          src_Last_updated_timestamp,",
				"          src_Active_flag,",
				"          src_Created_date,",
				"          src_Date_last_modified,",
				"          Sales_Rep_Id,",
				"          Sales_Rep_Name,",
				"          Sales_Rep_LoginAccess,",
				"          Sales_Rep_Email,",
				"          Sales_Rep_Phone,",
				"          Sales_Rep_Address,",
				"          Sales_Rep_City,",
				"          Sales_Rep_Country,",
				"          Sales_key,",
				"          Delete_flag,",
				"          Created_by,",
				"          Created_timestamp,",
				"          Last_updated_by,",
				"          Last_updated_timestamp,",
				"          Active_flag,",
				"          Created_date,",
				"          Date_last_modified,",
				"          previous_Sales_Rep_City = current_Sales_Rep_City,",
				"          previous_Sales_Rep_Country = current_Sales_Rep_Country,",
				"          previous_Sales_Rep_Phone = current_Sales_Rep_Phone",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3 alterRow(updateIf(true())) ~> alterRow1",
				"select2 alterRow(insertIf(true())) ~> alterRow2",
				"alterRow2, alterRow1 union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     partitionFileNames:[($filename)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}