{
	"name": "DF_customers",
	"properties": {
		"folder": {
			"name": "practice/STG to TGT"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SRCcustomers"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SRCDimCustomers"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SNKTgtCustomers"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "join1"
				},
				{
					"name": "split1"
				},
				{
					"name": "alterInsert"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select3"
				},
				{
					"name": "union1"
				},
				{
					"name": "select4"
				},
				{
					"name": "surrogateCustomerKey"
				},
				{
					"name": "alterExisiting"
				},
				{
					"name": "select5"
				},
				{
					"name": "select6"
				},
				{
					"name": "alterUpsert"
				},
				{
					"name": "alterUpdate"
				},
				{
					"name": "select7"
				},
				{
					"name": "transformation2"
				},
				{
					"name": "transformation"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CustomerID as integer,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Email as string,",
				"          Country as string,",
				"          CreatedDate as date,",
				"          {created date} as date,",
				"          {created by} as string,",
				"          {updated date} as date,",
				"          {updated by} as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCcustomers",
				"source(output(",
				"          customer_id as integer,",
				"          customer_key as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          customer_name as string,",
				"          email as string,",
				"          country as string,",
				"          isActive as string,",
				"          start_date as date,",
				"          end_date as date,",
				"          {created date} as date,",
				"          {created by} as string,",
				"          {updated date} as date,",
				"          {updated by} as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCDimCustomers",
				"SRCcustomers select(mapColumn(",
				"          each(match(true()),",
				"               \"SRC_\"+$$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"SRCDimCustomers select(mapColumn(",
				"          each(match(true()),",
				"               \"TGT_\"+$$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"surrogateCustomerKey, select2 join(SRC_CustomerID == TGT_customer_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 split(isNull(TGT_customer_id),",
				"     SRC_CustomerID==TGT_customer_id && (SRC_Country!=TGT_country),",
				"     SRC_CustomerID==TGT_customer_id && (SRC_Country==TGT_country),",
				"     disjoint: false) ~> split1@(Insert, upsert, existing)",
				"split1@Insert alterRow(insertIf(true())) ~> alterInsert",
				"alterInsert derive({SRC_created date} = currentDate(),",
				"          {SRC_created by} = {TGT_created by},",
				"          {TGT_updated date} = currentDate(),",
				"          {TGT_updated by} = {TGT_created by}) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          customer_id = SRC_CustomerID,",
				"          customer_key = Customer_Key,",
				"          first_name = SRC_FirstName,",
				"          last_name = SRC_LastName,",
				"          customer_name,",
				"          email = SRC_Email,",
				"          country = SRC_Country,",
				"          isActive,",
				"          start_date,",
				"          end_date,",
				"          {created date} = {SRC_created date},",
				"          {created by} = {SRC_created by},",
				"          {updated date} = {SRC_updated date},",
				"          {updated by} = {SRC_updated by},",
				"          runid = SRC_runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3, select5, select6, select7 union(byName: true)~> union1",
				"union1 select(mapColumn(",
				"          customer_id,",
				"          customer_key,",
				"          first_name,",
				"          last_name,",
				"          customer_name,",
				"          email,",
				"          country,",
				"          isActive,",
				"          start_date,",
				"          end_date,",
				"          {created date},",
				"          {created by},",
				"          {updated date},",
				"          {updated by},",
				"          runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"derivedColumn2 keyGenerate(output(Customer_Key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateCustomerKey",
				"split1@existing alterRow(insertIf(true())) ~> alterExisiting",
				"alterExisiting select(mapColumn(",
				"          customer_id = TGT_customer_id,",
				"          customer_key = TGT_customer_key,",
				"          first_name = TGT_first_name,",
				"          last_name = TGT_last_name,",
				"          customer_name = TGT_customer_name,",
				"          email = TGT_email,",
				"          country = TGT_country,",
				"          isActive = TGT_isActive,",
				"          start_date = TGT_start_date,",
				"          end_date = TGT_end_date,",
				"          {created date} = {TGT_created date},",
				"          {created by} = {TGT_created by},",
				"          {updated date} = {TGT_updated date},",
				"          {updated by} = {TGT_updated by},",
				"          runid = TGT_runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select5",
				"alterUpsert select(mapColumn(",
				"          customer_id = TGT_customer_id,",
				"          customer_key = TGT_customer_key,",
				"          first_name = TGT_first_name,",
				"          last_name = TGT_last_name,",
				"          customer_name = TGT_customer_name,",
				"          email = TGT_email,",
				"          country = TGT_country,",
				"          isActive = TGT_isActive,",
				"          start_date = TGT_start_date,",
				"          end_date = TGT_end_date,",
				"          {created date} = {TGT_created date},",
				"          {created by} = {TGT_created by},",
				"          {updated date} = {TGT_updated date},",
				"          {updated by} = {TGT_updated by},",
				"          runid = TGT_runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select6",
				"transformation alterRow(updateIf(true())) ~> alterUpsert",
				"transformation2 alterRow(insertIf(true())) ~> alterUpdate",
				"alterUpdate select(mapColumn(",
				"          customer_id = TGT_customer_id,",
				"          customer_key = Customer_Key,",
				"          first_name = TGT_first_name,",
				"          last_name = TGT_last_name,",
				"          customer_name = TGT_customer_name,",
				"          country = SRC_Country,",
				"          email = TGT_email,",
				"          isActive,",
				"          start_date,",
				"          end_date,",
				"          {created date} = {TGT_created date},",
				"          {created by} = {TGT_created by},",
				"          {updated date} = {SRC_updated date},",
				"          {updated by} = {SRC_updated by},",
				"          runid = TGT_runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select7",
				"split1@upsert derive(isActive = \"Y\",",
				"          {SRC_updated date} = currentDate(),",
				"          {SRC_updated by} = {SRC_created by}) ~> transformation2",
				"split1@upsert derive(TGT_isActive = \"N\",",
				"          TGT_end_date = start_date,",
				"          {TGT_updated date} = currentDate(),",
				"          {TGT_updated by} = {TGT_updated by}) ~> transformation",
				"select1 derive(isActive = \"Y\",",
				"          start_date = currentDate(),",
				"          end_date = toString(null())) ~> derivedColumn2",
				"select4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Dim_customers'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SNKTgtCustomers"
			]
		}
	}
}