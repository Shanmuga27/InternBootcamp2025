{
	"name": "DF_STG_CUST_DW_IN1686",
	"properties": {
		"folder": {
			"name": "workshop/STG_DW"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "srcCUST"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "tgtCUST"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "LeftJoin"
				},
				{
					"name": "alterRowINSERT"
				},
				{
					"name": "select1"
				},
				{
					"name": "split1"
				},
				{
					"name": "alterRowUPDATE"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Customer_Id as integer,",
				"          Customer_Key as short,",
				"          Company_Name as string,",
				"          Delete_Flag as boolean,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          Active_Flag as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcCUST",
				"source(output(",
				"          Customer_key as integer,",
				"          Customer_ID as integer,",
				"          Company_Name as string,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          Delete_Flg as string,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> tgtCUST",
				"srcCUST, tgtCUST join(srcCUST@Customer_Id == tgtCUST@Customer_ID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> LeftJoin",
				"split1@InsertStream alterRow(insertIf(true())) ~> alterRowINSERT",
				"alterRowINSERT select(mapColumn(",
				"          Customer_Id = split1@InsertStream@Customer_Id,",
				"          Customer_Key = split1@InsertStream@Customer_Key,",
				"          Company_Name = split1@InsertStream@Company_Name,",
				"          Delete_Flag,",
				"          Create_Date = split1@InsertStream@Create_Date,",
				"          Date_Last_Modified = split1@InsertStream@Date_Last_Modified,",
				"          Created_By = split1@InsertStream@Created_By,",
				"          Created_Timestamp = split1@InsertStream@Created_Timestamp,",
				"          Last_Updated_By = split1@InsertStream@Last_Updated_By,",
				"          Last_Update_Timestamp = split1@InsertStream@Last_Update_Timestamp,",
				"          Active_Flag,",
				"          Customer_key = split1@InsertStream@Customer_key,",
				"          Customer_ID = split1@InsertStream@Customer_ID,",
				"          Company_Name = split1@InsertStream@Company_Name,",
				"          Create_Date = split1@InsertStream@Create_Date,",
				"          Date_Last_Modified = split1@InsertStream@Date_Last_Modified,",
				"          Delete_Flg,",
				"          Created_By = split1@InsertStream@Created_By,",
				"          Created_Timestamp = split1@InsertStream@Created_Timestamp,",
				"          Last_Updated_By = split1@InsertStream@Last_Updated_By,",
				"          Last_Update_Timestamp = split1@InsertStream@Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"LeftJoin split(isNull(tgtCUST@Customer_ID),",
				"     (srcCUST@Customer_Id==tgtCUST@Customer_ID) && (srcCUST@Company_Name!=tgtCUST@Company_Name),",
				"     disjoint: true) ~> split1@(InsertStream, UpdateStream)",
				"split1@UpdateStream alterRow(updateIf(true())) ~> alterRowUPDATE",
				"alterRowUPDATE select(mapColumn(",
				"          Customer_Id = split1@UpdateStream@Customer_Id,",
				"          Customer_Key = split1@UpdateStream@Customer_Key,",
				"          Company_Name = split1@UpdateStream@Company_Name,",
				"          Delete_Flag,",
				"          Create_Date = split1@UpdateStream@Create_Date,",
				"          Date_Last_Modified = split1@UpdateStream@Date_Last_Modified,",
				"          Created_By = split1@UpdateStream@Created_By,",
				"          Created_Timestamp = split1@UpdateStream@Created_Timestamp,",
				"          Last_Updated_By = split1@UpdateStream@Last_Updated_By,",
				"          Last_Update_Timestamp = split1@UpdateStream@Last_Update_Timestamp,",
				"          Active_Flag,",
				"          Customer_key = split1@UpdateStream@Customer_key,",
				"          Customer_ID = split1@UpdateStream@Customer_ID,",
				"          Company_Name = split1@UpdateStream@Company_Name,",
				"          Create_Date = split1@UpdateStream@Create_Date,",
				"          Date_Last_Modified = split1@UpdateStream@Date_Last_Modified,",
				"          Delete_Flg,",
				"          Created_By = split1@UpdateStream@Created_By,",
				"          Created_Timestamp = split1@UpdateStream@Created_Timestamp,",
				"          Last_Updated_By = split1@UpdateStream@Last_Updated_By,",
				"          Last_Update_Timestamp = split1@UpdateStream@Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['SCD1_Customers.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['SCD1_Customers2.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink2"
			]
		}
	}
}