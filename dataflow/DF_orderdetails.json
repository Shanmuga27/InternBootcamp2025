{
	"name": "DF_orderdetails",
	"properties": {
		"folder": {
			"name": "practice/STG to TGT"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SRCOrderdetails"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "TGTOrderdetails"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SNKOrderdetails"
				}
			],
			"transformations": [
				{
					"name": "surrogateOrderdetails"
				},
				{
					"name": "select1"
				},
				{
					"name": "join1"
				},
				{
					"name": "split1"
				},
				{
					"name": "alterinsert"
				},
				{
					"name": "select2"
				},
				{
					"name": "transformation2"
				},
				{
					"name": "union1"
				},
				{
					"name": "select3"
				},
				{
					"name": "select4"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "alterupdate"
				},
				{
					"name": "transformation1"
				},
				{
					"name": "select6"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderDetailID as integer,",
				"          OrderID as integer,",
				"          ProductID as integer,",
				"          Quantity as integer,",
				"          {created date} as date,",
				"          {created by} as string,",
				"          {updated date} as date,",
				"          {updated by} as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCOrderdetails",
				"source(output(",
				"          orderdetail_id as integer,",
				"          orderdetail_key as integer,",
				"          order_id as integer,",
				"          product_id as integer,",
				"          quantity as integer,",
				"          {created date} as date,",
				"          {created by} as string,",
				"          {updated date} as date,",
				"          {updated by} as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TGTOrderdetails",
				"SRCOrderdetails keyGenerate(output(orderdetail_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateOrderdetails",
				"surrogateOrderdetails select(mapColumn(",
				"          orderdetail_id = OrderDetailID,",
				"          orderdetail_key,",
				"          order_id = OrderID,",
				"          product_id = ProductID,",
				"          quantity = Quantity,",
				"          {created date},",
				"          {created by},",
				"          {updated date},",
				"          {updated by},",
				"          runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select4, aggregate1 join(SRC_orderdetail_id == orderdetail_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 split(isNull(orderdetail_id),",
				"     SRC_order_id > order_id,",
				"     disjoint: false) ~> split1@(insert, update)",
				"split1@insert alterRow(insertIf(true())) ~> alterinsert",
				"transformation2 select(mapColumn(",
				"          orderdetail_id = SRC_orderdetail_id,",
				"          orderdetail_key = SRC_orderdetail_key,",
				"          order_id = SRC_order_id,",
				"          product_id = SRC_product_id,",
				"          quantity = SRC_quantity,",
				"          {created date} = {SRC_created date},",
				"          {created by} = {SRC_created by},",
				"          {updated date} = {SRC_updated date},",
				"          {updated by} = {SRC_updated by},",
				"          runid = SRC_runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"alterinsert derive({SRC_created date} = currentDate(),",
				"          {SRC_created by} = {SRC_created by},",
				"          {SRC_updated date} = currentDate(),",
				"          {SRC_updated by} = {SRC_updated by}) ~> transformation2",
				"select2, select6 union(byName: true)~> union1",
				"union1 select(mapColumn(",
				"          orderdetail_id,",
				"          orderdetail_key,",
				"          order_id,",
				"          product_id,",
				"          quantity,",
				"          {created date},",
				"          {created by},",
				"          {updated date},",
				"          {updated by},",
				"          runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1 select(mapColumn(",
				"          each(match(true()),",
				"               \"SRC_\"+$$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"TGTOrderdetails aggregate(groupBy(orderdetail_id),",
				"     order_id = max(order_id)) ~> aggregate1",
				"split1@update alterRow(updateIf(true())) ~> alterupdate",
				"alterupdate derive({SRC_created date} = currentDate(),",
				"          {SRC_created by} = {SRC_created by},",
				"          {SRC_updated date} = currentDate(),",
				"          {SRC_updated by} = {SRC_updated by}) ~> transformation1",
				"transformation1 select(mapColumn(",
				"          orderdetail_id,",
				"          orderdetail_key = SRC_orderdetail_key,",
				"          order_id,",
				"          product_id = SRC_product_id,",
				"          quantity = SRC_quantity,",
				"          {created date} = {SRC_created date},",
				"          {created by} = {SRC_created by},",
				"          {updated date} = {SRC_updated date},",
				"          {updated by} = {SRC_updated by},",
				"          runid = SRC_runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select6",
				"select3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['fact_orderdetails'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SNKOrderdetails"
			]
		}
	}
}