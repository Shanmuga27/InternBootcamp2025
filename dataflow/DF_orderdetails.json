{
	"name": "DF_orderdetails",
	"properties": {
		"folder": {
			"name": "practice/STG to TGT"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SRCOrderdetails"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "TGTOrderdetails"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SNKOrderdetails"
				}
			],
			"transformations": [
				{
					"name": "surrogateOrderdetails"
				},
				{
					"name": "select1"
				},
				{
					"name": "join1"
				},
				{
					"name": "split1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "select2"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "union1"
				},
				{
					"name": "select3"
				},
				{
					"name": "select4"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "alterRow2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "select6"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as integer,",
				"          CustomerID as string,",
				"          OrderAmount as string,",
				"          OrderDate as string,",
				"          Status as integer,",
				"          {created date} as date,",
				"          {created by} as string,",
				"          {updated date} as date,",
				"          {updated by} as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCOrderdetails",
				"source(output(",
				"          order_id as integer,",
				"          order_key as integer,",
				"          customer_id as string,",
				"          order_amount as string,",
				"          order_date as string,",
				"          status as integer,",
				"          {created date} as date,",
				"          {created by} as string,",
				"          {updated date} as date,",
				"          {updated by} as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TGTOrderdetails",
				"SRCOrderdetails keyGenerate(output(order_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateOrderdetails",
				"surrogateOrderdetails select(mapColumn(",
				"          order_id = OrderID,",
				"          order_key,",
				"          customer_id = CustomerID,",
				"          order_amount = OrderAmount,",
				"          order_date = OrderDate,",
				"          status = Status,",
				"          {created date},",
				"          {created by},",
				"          {updated date},",
				"          {updated by},",
				"          runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select4, aggregate1 join(SRC_order_id == order_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 split(isNull(order_id),",
				"     SRC_order_id > order_id,",
				"     disjoint: false) ~> split1@(insert, update)",
				"split1@insert alterRow() ~> alterRow1",
				"derivedColumn2 select(mapColumn(",
				"          {undefined}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"alterRow1 derive() ~> derivedColumn2",
				"select2, select6 union(byName: true)~> union1",
				"union1 select(mapColumn(",
				"          {undefined}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1 select(mapColumn(",
				"          each(match(true()),",
				"               \"SRC_\"+$$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"TGTOrderdetails aggregate(groupBy(order_id),",
				"     order_date = max(order_id)) ~> aggregate1",
				"split1@update alterRow() ~> alterRow2",
				"alterRow2 derive() ~> derivedColumn3",
				"derivedColumn3 select(mapColumn(",
				"          SRC_order_id,",
				"          SRC_order_key,",
				"          SRC_customer_id,",
				"          SRC_order_amount,",
				"          SRC_order_date,",
				"          SRC_status,",
				"          {SRC_created date},",
				"          {SRC_created by},",
				"          {SRC_updated date},",
				"          {SRC_updated by},",
				"          SRC_runid,",
				"          order_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select6",
				"select3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SNKOrderdetails"
			]
		}
	}
}