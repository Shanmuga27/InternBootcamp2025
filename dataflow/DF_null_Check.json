{
	"name": "DF_null_Check",
	"properties": {
		"folder": {
			"name": "QA"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SRCtgtProducts"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SNKtgtproducts"
				}
			],
			"transformations": [
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          product_id as short,",
				"          product_key as short,",
				"          product_name as string,",
				"          category as string,",
				"          price as integer,",
				"          isActive as boolean,",
				"          start_date as date,",
				"          end_date as string,",
				"          {created date} as string,",
				"          {created by} as string,",
				"          {updated date} as string,",
				"          {updated by} as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCtgtProducts",
				"SRCtgtProducts split(isNull(product_id),",
				"     disjoint: false) ~> split1@(null)",
				"split1@null sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['tgtproducts'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SNKtgtproducts"
			]
		}
	}
}