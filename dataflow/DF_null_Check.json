{
	"name": "DF_null_Check",
	"properties": {
		"folder": {
			"name": "QA"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SRCtgtProducts"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SNKtgtproducts"
				}
			],
			"transformations": [
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCtgtProducts",
				"SRCtgtProducts split(isNull(product_id),",
				"     disjoint: false) ~> split1@(null)",
				"split1@null sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['tgtproducts'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SNKtgtproducts"
			]
		}
	}
}