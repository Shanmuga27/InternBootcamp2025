{
	"name": "DF_Fact_SalesSummary_prac",
	"properties": {
		"folder": {
			"name": "Module_Practice"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "DimCustomer"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "DimProduct"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "FactOrderDetails"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "FactOrder"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "SrcCustomer"
				},
				{
					"name": "join1"
				},
				{
					"name": "SrcOrders"
				},
				{
					"name": "join2"
				},
				{
					"name": "SrcOrderDetails"
				},
				{
					"name": "join3"
				},
				{
					"name": "SrcProduct"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          customer_id as integer,",
				"          customer_key as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          customer_name as string,",
				"          email as string,",
				"          country as string,",
				"          isActive as string,",
				"          start_date as timestamp,",
				"          end_date as string,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DimCustomer",
				"source(output(",
				"          ProductID as integer,",
				"          ProductName as string,",
				"          Category as string,",
				"          Price as integer,",
				"          created_date as timestamp,",
				"          {created_by  } as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string,",
				"          product_key as integer,",
				"          isActive as string,",
				"          start_date as timestamp,",
				"          end_date as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DimProduct",
				"source(output(",
				"          orderdetail_id as integer,",
				"          orderdetail_key as integer,",
				"          order_id as integer,",
				"          product_id as integer,",
				"          quantity as integer,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> FactOrderDetails",
				"source(output(",
				"          order_id as integer,",
				"          order_key as integer,",
				"          customer_id as integer,",
				"          order_amount as integer,",
				"          order_date as date,",
				"          status as string,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> FactOrder",
				"DimCustomer select(mapColumn(",
				"          customer_id,",
				"          customer_name = country",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SrcCustomer",
				"SrcCustomer, SrcOrders join(SrcCustomer@customer_id == SrcOrders@customer_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"FactOrder select(mapColumn(",
				"          order_id,",
				"          customer_id,",
				"          order_date,",
				"          status",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SrcOrders",
				"join1, SrcOrderDetails join(SrcOrders@order_id == SrcOrderDetails@order_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"FactOrderDetails select(mapColumn(",
				"          order_id,",
				"          product_id,",
				"          quantity",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SrcOrderDetails",
				"join2, SrcProduct join(SrcOrderDetails@product_id == SrcProduct@product_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"DimProduct select(mapColumn(",
				"          product_id = ProductID,",
				"          category = Category,",
				"          price = Price",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SrcProduct",
				"join3 derive(order_date = toDate(toString(order_date),'yyyy-MM')) ~> derivedColumn1",
				"derivedColumn1 filter(lower(status)=='completed') ~> filter1",
				"filter1 aggregate(groupBy(category,",
				"          {} = ERROR_FUNCTION(''),",
				"          order_date),",
				"     Sales = sum(price*quantity)) ~> aggregate1"
			]
		}
	}
}