{
	"name": "DF_Fact_SalesSummary_prac",
	"properties": {
		"folder": {
			"name": "Module_Practice"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "DimCustomer"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "DimProduct"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "FactOrderDetails"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "FactOrder"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "SnkFactSalesSummary"
				}
			],
			"transformations": [
				{
					"name": "SrcCustomer"
				},
				{
					"name": "joinCusomerOrders"
				},
				{
					"name": "SrcOrders"
				},
				{
					"name": "joinOrderdetails"
				},
				{
					"name": "SrcOrderDetails"
				},
				{
					"name": "joinOrders"
				},
				{
					"name": "SrcProduct"
				},
				{
					"name": "Transformations"
				},
				{
					"name": "filterStatus"
				},
				{
					"name": "aggregateSalary"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          customer_id as integer,",
				"          customer_key as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          customer_name as string,",
				"          email as string,",
				"          country as string,",
				"          isActive as string,",
				"          start_date as timestamp,",
				"          end_date as string,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DimCustomer",
				"source(output(",
				"          ProductID as integer,",
				"          ProductName as string,",
				"          Category as string,",
				"          Price as integer,",
				"          created_date as timestamp,",
				"          {created_by  } as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string,",
				"          product_key as integer,",
				"          isActive as string,",
				"          start_date as timestamp,",
				"          end_date as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DimProduct",
				"source(output(",
				"          orderdetail_id as integer,",
				"          orderdetail_key as integer,",
				"          order_id as integer,",
				"          product_id as integer,",
				"          quantity as integer,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> FactOrderDetails",
				"source(output(",
				"          order_id as integer,",
				"          order_key as integer,",
				"          customer_id as integer,",
				"          order_amount as integer,",
				"          order_date as date,",
				"          status as string,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> FactOrder",
				"DimCustomer select(mapColumn(",
				"          customer_id,",
				"          customer_name = country",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SrcCustomer",
				"SrcCustomer, SrcOrders join(SrcCustomer@customer_id == SrcOrders@customer_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinCusomerOrders",
				"FactOrder select(mapColumn(",
				"          order_id,",
				"          customer_id,",
				"          order_date,",
				"          status",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SrcOrders",
				"joinCusomerOrders, SrcOrderDetails join(SrcOrders@order_id == SrcOrderDetails@order_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinOrderdetails",
				"FactOrderDetails select(mapColumn(",
				"          order_id,",
				"          product_id,",
				"          quantity",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SrcOrderDetails",
				"joinOrderdetails, SrcProduct join(SrcOrderDetails@product_id == SrcProduct@product_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinOrders",
				"DimProduct select(mapColumn(",
				"          product_id = ProductID,",
				"          category = Category,",
				"          price = Price",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SrcProduct",
				"select1 derive(order_date = toDate(toString(order_date),'yyyy-MM')) ~> Transformations",
				"Transformations filter(lower(status)=='completed') ~> filterStatus",
				"filterStatus aggregate(groupBy(category,",
				"          Country,",
				"          order_date),",
				"     Sales = sum(price*quantity)) ~> aggregateSalary",
				"joinOrders select(mapColumn(",
				"          customer_id = SrcCustomer@customer_id,",
				"          Country = customer_name,",
				"          order_id = SrcOrders@order_id,",
				"          customer_id = SrcOrders@customer_id,",
				"          order_date,",
				"          status,",
				"          order_id = SrcOrderDetails@order_id,",
				"          product_id = SrcOrderDetails@product_id,",
				"          quantity,",
				"          product_id = SrcProduct@product_id,",
				"          category,",
				"          price",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"aggregateSalary sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Fact_SalesSummary_IN1677_prac'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SnkFactSalesSummary"
			]
		}
	}
}