{
	"name": "DF_order",
	"properties": {
		"folder": {
			"name": "practice/STG to TGT"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SRCOrder"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "TGTOrder"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference"
					},
					"name": "SNKOrder"
				}
			],
			"transformations": [
				{
					"name": "surrogateOrder"
				},
				{
					"name": "select1"
				},
				{
					"name": "join1"
				},
				{
					"name": "split1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "select2"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "union1"
				},
				{
					"name": "select3"
				},
				{
					"name": "select4"
				},
				{
					"name": "select5"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as integer,",
				"          CustomerID as string,",
				"          OrderAmount as string,",
				"          OrderDate as string,",
				"          Status as integer,",
				"          {created date} as date,",
				"          {created by} as string,",
				"          {updated date} as date,",
				"          {updated by} as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCOrder",
				"source(output(",
				"          order_id as integer,",
				"          order_key as integer,",
				"          customer_id as string,",
				"          order_amount as string,",
				"          order_date as string,",
				"          status as integer,",
				"          {created date} as date,",
				"          {created by} as string,",
				"          {updated date} as date,",
				"          {updated by} as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TGTOrder",
				"SRCOrder keyGenerate(output(order_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateOrder",
				"surrogateOrder select(mapColumn(",
				"          order_id = OrderID,",
				"          order_key,",
				"          customer_id = CustomerID,",
				"          order_amount = OrderAmount,",
				"          order_date = OrderDate,",
				"          status = Status,",
				"          {created date},",
				"          {created by},",
				"          {updated date},",
				"          {updated by},",
				"          runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select4, select5 join(SRC_order_id == TGT_order_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 split(isNull(TGT_order_id),",
				"     SRC_order_id==TGT_order_id && greater(),",
				"     disjoint: false) ~> split1@(insert, update)",
				"split1@insert alterRow() ~> alterRow1",
				"derivedColumn2 select(mapColumn(",
				"          {undefined}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"alterRow1 derive() ~> derivedColumn2",
				"select2 union(byName: true)~> union1",
				"union1 select(mapColumn(",
				"          {undefined}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1 select(mapColumn(",
				"          each(match(true()),",
				"               \"SRC_\"+$$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"aggregate1 select(mapColumn(",
				"          order_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select5",
				"TGTOrder aggregate(order_date = max(order_date)) ~> aggregate1",
				"select3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SNKOrder"
			]
		}
	}
}