{
	"name": "OrdersUnionDF",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ORDERS_TABLE",
						"type": "DatasetReference"
					},
					"name": "ORDERS"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText2",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "DCrecent"
				},
				{
					"name": "split1"
				},
				{
					"name": "DCOld"
				},
				{
					"name": "union1"
				},
				{
					"name": "windowRemoveDuplicates"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as string,",
				"          CustomerID as string,",
				"          ProductID as string,",
				"          OrderDate as date,",
				"          Amount as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> ORDERS",
				"split1@RecentOrders derive(OrderType = 'Recent') ~> DCrecent",
				"ORDERS split(OrderDate>=addMonths(currentDate(), -12),",
				"     disjoint: false) ~> split1@(RecentOrders, OldOrders)",
				"split1@OldOrders derive(OrderType = 'Old') ~> DCOld",
				"DCrecent, DCOld union(byName: true)~> union1",
				"union1 window(over(OrderID),",
				"     desc(OrderDate, false),",
				"     rowNum = rowNumber()) ~> windowRemoveDuplicates",
				"windowRemoveDuplicates filter(rowNum == 1) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}