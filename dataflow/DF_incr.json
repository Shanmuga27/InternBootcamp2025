{
	"name": "DF_incr",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sourceAUG"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "tgt"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1",
					"description": " 'sourceAUG' \nRight join\n'tgt'"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as short,",
				"          car_id as string,",
				"          customer_id as string,",
				"          order_start_dt as date,",
				"          order_close_dt as date,",
				"          status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceAUG",
				"source(output(",
				"          order_id as string,",
				"          car_id as string,",
				"          customer_id as string,",
				"          order_start_dt as string,",
				"          order_close_dt as string,",
				"          status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> tgt",
				"sourceAUG, tgt join(sourceAUG@order_id == toInteger(tgt@order_id),",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 alterRow(insertIf(sourceAUG@order_start_dt>toDate(tgt@order_start_dt))) ~> alterRow1",
				"alterRow1 select(mapColumn(",
				"          order_id = sourceAUG@order_id,",
				"          car_id = sourceAUG@car_id,",
				"          customer_id = sourceAUG@customer_id,",
				"          order_start_dt = sourceAUG@order_start_dt,",
				"          order_close_dt = sourceAUG@order_close_dt,",
				"          status = sourceAUG@status",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:[''],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}