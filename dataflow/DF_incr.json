{
	"name": "DF_incr",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sourceAUG"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as short,",
				"          car_id as string,",
				"          customer_id as string,",
				"          order_start_dt as date,",
				"          order_close_dt as date,",
				"          status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceAUG",
				"sourceAUG derive(order_start_dt = toString(order_start_dt, 'dd-MMMM-yyyy'),",
				"          status = initCap(status),",
				"          order_close_dt = toString(order_start_dt, 'dd-MMMM-yyyy')) ~> derivedColumn1"
			]
		}
	}
}