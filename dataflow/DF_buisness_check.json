{
	"name": "DF_buisness_check",
	"properties": {
		"folder": {
			"name": "QA workshop"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "SRCdimOrders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "SNKdimOrdersbuisnessscenenotmatch"
				}
			],
			"transformations": [
				{
					"name": "rowNumber"
				},
				{
					"name": "activeRecords"
				}
			],
			"scriptLines": [
				"source(output(",
				"          customer_id as short,",
				"          first_name as string,",
				"          last_name as string,",
				"          email as string,",
				"          country as string,",
				"          created_date as string,",
				"          {created_by } as string,",
				"          updated_date as string,",
				"          updated_by as string,",
				"          runid as string,",
				"          customer_key as short,",
				"          customer_name as string,",
				"          isActive as boolean,",
				"          start_date as timestamp,",
				"          end_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCdimOrders",
				"SRCdimOrders window(over(customer_id),",
				"     desc(start_date, true),",
				"     r_n = rowNumber()) ~> rowNumber",
				"rowNumber split(r_n==1 && isActive == 'Y',",
				"     disjoint: false) ~> activeRecords@(isActiveCheck)",
				"activeRecords@isActiveCheck sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SNKdimOrdersbuisnessscenenotmatch"
			]
		}
	}
}