				},
				{
					"dataset": {
						"referenceName": "DS_IN1689",
						"type": "DatasetReference"
					},
					"name": "STGSalesRep"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_IN1689",
						"type": "DatasetReference"
					},
					"name": "STGEstimate"
				}
			],
			"transformations": [
				{
					"name": "DerivedColumn"
				},
				{
					"name": "transformation1"
				},
				{
					"name": "join1"
				},
				{
					"name": "select"
				},
				{
					"name": "join2"
				},
				{
					"name": "join3"
				},
				{
					"name": "select1"
				},
				{
					"name": "join4"
				},
				{
					"name": "transformation2"
				},
				{
					"name": "transformation3"
				},
				{
					"name": "Active"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Transaction_Id as integer,",
				"          Transaction_Line_Id as integer,",
				"          Memo as string,",
				"          Sticker_Requirements as string,",
				"          Inner_Requirements as string,",
				"          Customer_Requirements as string,",
				"          Sales_Program as string,",
				"          Buyer_Dept as string,",
				"          Buyer_Confirmed_On as string,",
				"          Dept_Program as string,",
				"          Program_0 as string,",
				"          Cancelled as string,",
				"          Confidence_Factor_Id as short,",
				"          Company_Id as integer,",
				"          Item_Id as integer,",
				"          Location_Id as short,",
				"          Sales_Rep_Id as integer,",
				"          TranId as string,",
				"          Price_Sticker_Id as string,",
				"          Po as string,",
				"          Release_Order_Number as string,",
				"          Cntnr_ as string,",
				"          Etd_Ship_Date as string,",
				"          Ship_Date_Outbound as string,",
				"          Cancel_Date_Outbound as string,",
				"          Expiration_Date as string,",
				"          Item_Count as integer,",
				"          Inner_Qty as string,",
				"          Release_Quantity as string,",
				"          Quantity_Received_In_Shipment as short,",
				"          Item_Unit_Price as string,",
				"          Amount as string,",
				"          Eta_Arrival_Date as string,",
				"          Closed_Script as boolean,",
				"          Estimate_Key as short,",
				"          Delete_Flg as string,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> EDLEstimate",
				"source(output(",
				"          Location_Id as integer,",
				"          Name as string,",
				"          City as string,",
				"          Country as string,",
				"          State as string,",
				"          Zipcode as string,",
				"          Location_key as short,",
				"          Delete_Flg as boolean,",
				"          Active_Flag as boolean,",
				"          Date_Last_Modified as string,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> STGLocation",
				"source(output(",
				"          Customer_Id as integer,",
				"          Company_Name as string,",
				"          Customer_key as short,",
				"          Delete_Flg as boolean,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as string,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as string,",
				"          Active_Flag as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> STGCustomer",
				"source(output(",
				"          Item_Id as integer,",
				"          Generic_Description as string,",
				"          PurchaseDescription as string,",
				"          Artwork as string,",
				"          Color as string,",
				"          Package_Type as string,",
				"          Special_Requirements as string,",
				"          Case_Pack as string,",
				"          Full_Name as string,",
				"          Display_Name as string,",
				"          Account_Manager_Name as string,",
				"          Brand_Name as string,",
				"          Brand_Manager_Name as string,",
				"          Item_Status as string,",
				"          Item_Type as string,",
				"          Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Master_Carton_Rqmnts as string,",
				"          Trade_Partner_Name as string,",
				"          Part_Of_Assembly_Item as string,",
				"          Type_Name as string,",
				"          Trade_Partner_Code as string,",
				"          VendorName as string,",
				"          UPC as string,",
				"          QunatityOnHand as boolean,",
				"          SSCC14 as string,",
				"          Master_Carton_Markings_Item_N as integer,",
				"          Item_Key as short,",
				"          Delete_Flg as boolean,",
				"          Active_Flag as boolean,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> STGProduct",
				"source(output(",
				"          Sales_Rep_Id as integer,",
				"          Sales_Rep_Name as string,",
				"          LoginAccess as boolean,",
				"          Email as string,",
				"          Phone as string,",
				"          Address as string,",
				"          City as string,",
				"          Country as string,",
				"          Sales_key as integer,",
				"          Delete_Flg as boolean,",
				"          Active_Flag as boolean,",
				"          Date_Last_Modified as string,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> STGSalesRep",
				"EDLEstimate derive(Sticker_Requirement_Purchase_descr = case(Sticker_Requirements=='NULL' || Sticker_Requirements == '0','No Stickers' ,\r",
				"    (Inner_Requirements=='NULL' || Inner_Requirements == '0') && (Customer_Requirements=='NULL' || Customer_Requirements == '0'),Sticker_Requirements ,\r",
				"        Customer_Requirements=='NULL' || Customer_Requirements == '0', Sticker_Requirements, 'unk'),",
				"          Confidence_Factor_Id = toString( case(Confidence_Factor_Id == 1, '25%',\r",
				"    Confidence_Factor_Id == 2, '50%',\r",
				"        Confidence_Factor_Id == 3, '75%',\r",
				"            Confidence_Factor_Id == 4, '90%',\r",
				"                Confidence_Factor_Id == 5, 'Dropped',\r",
				"                    Confidence_Factor_Id == 6, 'Actual',\r",
				"                        Confidence_Factor_Id == 7, '90%-Pre',\r",
				"                            Confidence_Factor_Id == 8, '90%-Releases', 'unk')),",
				"          Date_Last_Modified_Gmt = toTimestamp(currentDate()),",
				"          Last_Updated_By = \"IN1689\",",
				"          Last_Update_Timestamp = currentTimestamp()) ~> DerivedColumn",
				"select3 derive(Level_Descr = case(Confidence_Factor_Id == '25%','',\r",
				"    Confidence_Factor_Id == '50%','',\r",
				"    Confidence_Factor_Id == 'Dropped','',\r",
				"    Confidence_Factor_Id == '75%', 'Pending Confirmation',\r",
				"    Confidence_Factor_Id == '90%','Pending Approval%',\r",
				"    Confidence_Factor_Id == 'Actual', 'Confirmed',\r",
				"    Confidence_Factor_Id == '90%-Pre', 'Confirmed',\r",
				"    Confidence_Factor_Id == '90%-Releases','Confirmed'),",
				"          Final_Destination_Container = concat(Location_City,Location_Name),",
				"          PRICE_STICKER_descr = case(\r",
				"  like(Sticker_Requirements, '%$%price sticker%'),\r",
				"  regexExtract(Sticker_Requirements, '\\\\$.*?price sticker', 0),\r",
				"  'No Sticker'\r",
				")) ~> transformation1",
				"DerivedColumn, STGLocation join(EDLEstimate@Location_Id == STGLocation@Location_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          each(match(/* All input columns */ true()),",
				"               /* Input name */ $$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select",
				"transformation1, STGCustomer join(Company_Id == Customer_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2, STGProduct join(select3@Item_Id == STGProduct@Item_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join4 select(mapColumn(",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo,",
				"          Sticker_Requirements,",
				"          Inner_Requirements,",
				"          Customer_Requirements,",
				"          Sales_Program,",
				"          Buyer_Dept,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program,",
				"          Program_0,",
				"          Cancelled,",
				"          Confidence_Factor_Id,",
				"          Company_Id,",
				"          Location_Id,",
				"          TranId,",
				"          Price_Sticker_Id,",
				"          Po,",
				"          Release_Order_Number,",
				"          Cntnr_,",
				"          Etd_Ship_Date,",
				"          Ship_Date_Outbound,",
				"          Cancel_Date_Outbound,",
				"          Expiration_Date,",
				"          Item_Count,",
				"          Inner_Qty,",
				"          Release_Quantity,",
				"          Quantity_Received_In_Shipment,",
				"          Item_Unit_Price,",
				"          Amount,",
				"          Eta_Arrival_Date,",
				"          Closed_Script,",
				"          Estimate_Key,",
				"          Sticker_Requirement_Purchase_descr,",
				"          Date_Last_Modified_Gmt,",
				"          Location_Name,",
				"          Location_City,",
				"          Location_Country,",
				"          Location_State,",
				"          Location_Zipcode,",
				"          Location_key,",
				"          Level_Descr,",
				"          Final_Destination_Container,",
				"          PRICE_STICKER_descr,",
				"          Customer_Id,",
				"          Company_Name,",
				"          Customer_key,",
				"          Delete_Flg = STGCustomer@Delete_Flg,",
				"          Create_Date,",
				"          Date_Last_Modified = STGCustomer@Date_Last_Modified,",
				"          Created_By = STGCustomer@Created_By,",
				"          Created_Timestamp = STGCustomer@Created_Timestamp,",
				"          Last_Updated_By = STGCustomer@Last_Updated_By,",
				"          Last_Update_Timestamp = STGCustomer@Last_Update_Timestamp,",
				"          Active_Flag = STGCustomer@Active_Flag,",
				"          Item_Id = STGProduct@Item_Id,",
				"          Generic_Description,",
				"          PurchaseDescription,",
				"          Artwork,",
				"          Color,",
				"          Package_Type,",
				"          Special_Requirements,",
				"          Case_Pack,",
				"          Full_Name,",
				"          Display_Name,",
				"          Account_Manager_Name,",
				"          Brand_Name,",
				"          Brand_Manager_Name,",
				"          Item_Status,",
				"          Item_Type,",
				"          Maker_Name,",
				"          Product_Manager_Name,",
				"          Master_Carton_Rqmnts,",
				"          Trade_Partner_Name,",
				"          Part_Of_Assembly_Item,",
				"          Type_Name,",
				"          Trade_Partner_Code,",
				"          VendorName,",
				"          UPC,",
				"          QunatityOnHand,",
				"          SSCC14,",
				"          Master_Carton_Markings_Item_N,",
				"          Item_Key,",
				"          Sales_Rep_Id = STGSalesRep@Sales_Rep_Id,",
				"          Sales_Rep_Name,",
				"          LoginAccess,",
				"          Email,",
				"          Phone,",
				"          Address,",
				"          City,",
				"          Country,",
				"          Sales_key",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> select1",
				"join3, STGSalesRep join(select3@Sales_Rep_Id == STGSalesRep@Sales_Rep_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join4",
				"select1 derive(Month_Ship_dt = toTimestamp(concat(toString(year(toTimestamp(Ship_Date_Outbound))),'-',toString(month(toTimestamp(Ship_Date_Outbound))))),",
				"          ETD_dt = iif(    \r",
				"    like(Location_Name,'%DotCom Distribution - Edison NJ%'), subDays(toTimestamp(Ship_Date_Outbound),66),    \r",
				"    iif(like(Location_Name,'%Berkley%'), subDays(toTimestamp(Ship_Date_Outbound),59),    \r",
				"    iif(like(Location_Name,'%POE China%'), subDays(toTimestamp(Ship_Date_Outbound),14),    \r",
				"    iif(like(Location_Name,'%POE OAK%'), subDays(toTimestamp(Ship_Date_Outbound),59),    \r",
				"    iif(like(Location_Name,'%POE Vietnam%'), subDays(toTimestamp(Ship_Date_Outbound),14),\r",
				"    subDays(toTimestamp(Ship_Date_Outbound),45))))))) ~> transformation2",
				"transformation2 derive(Month_ETD_dt = toTimestamp(concat(toString(year(ETD_dt)),'-',toString(month(ETD_dt)))),",
				"          MS_Domestic_Ship_Date = toTimestamp(subDays(toDate(Etd_Ship_Date), 45)),",
				"          MS_Domestic_Cancel_Date = toTimestamp(addDays(toDate(Etd_Ship_Date),55)),",
				"          each(match(type=='string'), $$ = iif(isNull($$) || $$ == 'NULL', 'UNK', $$)),",
				"          each(match(type=='integer'), trim($$) = iifNull($$, 0)),",
				"          each(match(type=='timestamp'), $$ = iifNull($$, toTimestamp('1900-01-01 00:00:00', 'dd-MM-yyyy HH:mm:ss')))) ~> transformation3",
				"transformation3 filter(Active_Flag) ~> Active",
				"STGLocation select(mapColumn(",
				"          Location_Id,",
				"          Location_Name = Name,",
				"          Location_City = City,",
				"          Location_Country = Country,",
				"          Location_State = State,",
				"          Location_Zipcode = Zipcode,",
				"          Location_key,",
				"          Delete_Flg,",
				"          Active_Flag,",
				"          Date_Last_Modified,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select select(mapColumn(",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo,",
				"          Sticker_Requirements,",
				"          Inner_Requirements,",
				"          Customer_Requirements,",
				"          Sales_Program,",
				"          Buyer_Dept,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program,",
				"          Program_0,",
				"          Cancelled,",
				"          Confidence_Factor_Id,",
				"          Company_Id,",
				"          Item_Id,",
				"          Location_Id,",
				"          Sales_Rep_Id,",
				"          TranId,",
				"          Price_Sticker_Id,",
				"          Po,",
				"          Release_Order_Number,",
				"          Cntnr_,",
				"          Etd_Ship_Date,",
				"          Ship_Date_Outbound,",
				"          Cancel_Date_Outbound,",
				"          Expiration_Date,",
				"          Item_Count,",
				"          Inner_Qty,",
				"          Release_Quantity,",
				"          Quantity_Received_In_Shipment,",
				"          Item_Unit_Price,",
				"          Amount,",
				"          Eta_Arrival_Date,",
				"          Closed_Script,",
				"          Estimate_Key,",
				"          Delete_Flg,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp,",
				"          Sticker_Requirement_Purchase_descr,",
				"          Date_Last_Modified_Gmt,",
				"          Location_Name = Name,",
				"          Location_City = City,",
				"          Location_Country = Country,",
				"          Location_State = State,",
				"          Location_Zipcode = Zipcode,",
				"          Location_key,",
				"          Active_Flag,",
				"          Date_Last_Modified",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"Active sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['STG_Estimate'],",
				"     mapColumn(",
				"          Sales_Estimate_Key,",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo_descr,",
				"          Sticker_Requirements_descr,",
				"          Inner_Requirements_descr,",
				"          Customer_Requirements_descr,",
				"          Sales_Program_descr,",
				"          Buyer_Dept_descr,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program_descr,",
				"          Program_descr,",
				"          Cancelled_descr,",
				"          Sticker_Requirement_Purchase_descr,",
				"          Confidence_Factor_descr,",
				"          Level_Descr,",
				"          Final_Destination_Container,",
				"          PRICE_STICKER_descr,",
				"          Customer_key,",
				"          Item_Key,",
				"          Sales_Rep_key = Sales_key,",
				"          Location_key,",
				"          Document_nbr = TranId,",
				"          Price_Sticker_ID = Price_Sticker_Id,",
				"          Po_nbr = Po,",
				"          Release_Order_nbr = Release_Order_Number,",
				"          CNTNR_nbr = Cntnr_,",
				"          Etd_Ship_Date,",
				"          Ship_Date_Outbound,",
				"          Cancel_Date_Outbound,",
				"          Expiration_Date,",
				"          Eta_Arrival_Date,",
				"          Month_Ship_dt,",
				"          ETD_dt,",
				"          Month_ETD_dt,",
				"          MS_Domestic_Ship_Date,",
				"          MS_Domestic_Cancel_Date,",
				"          Item_qty = Item_Count,",
				"          Inner_qty = Inner_Qty,",
				"          Release_qty = Release_Quantity,",
				"          Quantity_Received_In_Shipment,",
				"          Item_unit_price = Item_Unit_Price,",
				"          Amount,",
				"          Delete_Flg,",
				"          Active_Flag,",
				"          Create_Date,",
				"          Date_Created,",
				"          Date_Last_Modified_Gmt,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     partitionBy('hash', 1)) ~> STGEstimate"
			]
		}
	}
}