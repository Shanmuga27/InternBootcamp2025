				}
			],
			"scriptLines": [
				"source(output(",
				"          Transaction_Id as integer,",
				"          Transaction_Line_Id as integer,",
				"          Memo as string,",
				"          Sticker_Requirements as string,",
				"          Inner_Requirements as string,",
				"          Customer_Requirements as string,",
				"          Sales_Program as string,",
				"          Buyer_Dept as string,",
				"          Buyer_Confirmed_On as string,",
				"          Dept_Program as string,",
				"          Program_0 as string,",
				"          Cancelled as string,",
				"          Confidence_Factor_Id as integer,",
				"          Company_Id as integer,",
				"          Item_Id as integer,",
				"          Location_Id as integer,",
				"          Sales_Rep_Id as integer,",
				"          TranId as string,",
				"          Price_Sticker_Id as short,",
				"          Po as string,",
				"          Release_Order_Number as string,",
				"          Cntnr_ as string,",
				"          Etd_Ship_Date as string,",
				"          Ship_Date_Outbound as string,",
				"          Cancel_Date_Outbound as string,",
				"          Expiration_Date as string,",
				"          Item_Count as integer,",
				"          Inner_Qty as string,",
				"          Release_Quantity as string,",
				"          Quantity_Received_In_Shipment as short,",
				"          Item_Unit_Price as string,",
				"          Amount as string,",
				"          Eta_Arrival_Date as string,",
				"          Closed_Script as string,",
				"          Estimate_Key as short,",
				"          Delete_Flg as string,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCestimate",
				"source(output(",
				"          Customer_Id as integer,",
				"          Company_Name as string,",
				"          Customer_key as integer,",
				"          Delete_Flg as string,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as string,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as string,",
				"          Active_Flag as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCcustomers",
				"source(output(",
				"          Location_Id as integer,",
				"          Location_Name as string,",
				"          Location_City as string,",
				"          Location_Country as string,",
				"          Location_State as string,",
				"          Location_Zipcode as string,",
				"          Location_key as integer,",
				"          Delete_Flg as string,",
				"          Active_Flag as boolean,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRClocations",
				"source(output(",
				"          Item_Id as integer,",
				"          item_Descr as string,",
				"          Brand_descr as string,",
				"          Artwork_descr as string,",
				"          Color_descr as string,",
				"          Package_Type_descr as string,",
				"          Special_Req_descr as string,",
				"          Case_Pack_descr as string,",
				"          Full_Name_descr as string,",
				"          Display_name_descr as string,",
				"          Account_manager_name as string,",
				"          Brand_name as string,",
				"          brand_manager_name as string,",
				"          Item_status_descr as string,",
				"          item_type_descr as string,",
				"          maker_name as string,",
				"          product_manager_name as string,",
				"          Master_Carton_req_descr as string,",
				"          Trade_partner_Name as string,",
				"          Part_Of_Assembly_Item as string,",
				"          Type_Name as string,",
				"          Trade_partner_CD as string,",
				"          Vendor_Name as string,",
				"          UPC_nbr as string,",
				"          On_Hand_Quantity as boolean,",
				"          SSCC14_nbr as string,",
				"          Master_Carton_Item_nbr as short,",
				"          Item_Key as short,",
				"          Delete_Flg as boolean,",
				"          Active_Flag as boolean,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          Date_Last_Modified as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCproducts",
				"source(output(",
				"          Sales_Rep_Id as integer,",
				"          Sales_Rep_Name as string,",
				"          LoginAccess as string,",
				"          Email as string,",
				"          Phone as string,",
				"          Address as string,",
				"          City as string,",
				"          Country as string,",
				"          Sales_key as integer,",
				"          Delete_Flg as boolean,",
				"          Active_Flag as boolean,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCsalesReps",
				"SRCestimate derive(Last_Updated_By = 'IN1689',",
				"          Last_Update_Timestamp = currentTimestamp()) ~> derivedColumn1",
				"derivedColumn1, SRClocations join(SRCestimate@Location_Id == SRClocations@Location_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          each(match(/* All input columns */ true()),",
				"               /* Input name */ $$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 select(mapColumn(",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo,",
				"          Sticker_Requirements,",
				"          Inner_Requirements,",
				"          Customer_Requirements,",
				"          Sales_Program,",
				"          Buyer_Dept,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program,",
				"          Program_0,",
				"          Cancelled,",
				"          Confidence_Factor_Id,",
				"          Company_Id,",
				"          Item_Id,",
				"          Location_Id,",
				"          Sales_Rep_Id,",
				"          TranId,",
				"          Price_Sticker_Id,",
				"          Po,",
				"          Release_Order_Number,",
				"          Cntnr_,",
				"          Etd_Ship_Date,",
				"          Ship_Date_Outbound,",
				"          Cancel_Date_Outbound,",
				"          Expiration_Date,",
				"          Item_Count,",
				"          Inner_Qty,",
				"          Release_Quantity,",
				"          Quantity_Received_In_Shipment,",
				"          Item_Unit_Price,",
				"          Amount,",
				"          Eta_Arrival_Date,",
				"          Closed_Script,",
				"          Estimate_Key,",
				"          Delete_Flg,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp,",
				"          Location_Name,",
				"          Location_City,",
				"          Location_Country,",
				"          Location_State,",
				"          Location_Zipcode,",
				"          Location_key,",
				"          Active_Flag,",
				"          Date_Last_Modified",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2, SRCcustomers join(Company_Id == Customer_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2, SRCproducts join(select2@Item_Id == SRCproducts@Item_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join3, SRCsalesReps join(select2@Sales_Rep_Id == SRCsalesReps@Sales_Rep_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join4",
				"join4 select(mapColumn(",
				"          each(match(/* All input columns */ true()),",
				"               /* Input name */ $$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3 derive(Month_Ship_dt = toTimestamp(concat(toString(year(toTimestamp(Ship_Date_Outbound))),'-',toString(month(toTimestamp(Ship_Date_Outbound))))),",
				"          ETD_dt = iif(like(Location_Name,'%DotCom Distribution - Edison NJ%'), subDays(toTimestamp(Ship_Date_Outbound),66),    iif(like(Location_Name,'%Berkley%'), subDays(toTimestamp(Ship_Date_Outbound),59),        iif(like(Location_Name,'%POE China%'), subDays(toTimestamp(Ship_Date_Outbound),14),        iif(like(Location_Name,'%POE OAK%'), subDays(toTimestamp(Ship_Date_Outbound),59),        iif(like(Location_Name,'%POE Vietnam%'), subDays(toTimestamp(Ship_Date_Outbound),14),    subDays(toTimestamp(Ship_Date_Outbound),45))))))) ~> derivedColumn2",
				"derivedColumn2 derive(Month_ETD_dt = toTimestamp(concat(toString(year(ETD_dt)),'-',toString(month(ETD_dt)))),",
				"          MS_Domestic_Ship_Date = toTimestamp(subDays(toDate(Etd_Ship_Date), 45)),",
				"          MS_Domestic_Cancel_Date = toTimestamp(addDays(toDate(Etd_Ship_Date),55)),",
				"          each(match(type=='string'), $$ = iif(isNull($$) || $$ == 'NULL', 'UNK', $$)),",
				"          each(match(type=='integer'), trim($$) = iifNull($$, 0)),",
				"          each(match(type=='timestamp'), $$ = iifNull($$, toTimestamp('1900-01-01 00:00:00', 'dd-MM-yyyy HH:mm:ss')))) ~> derivedColumn3",
				"derivedColumn3 select(mapColumn(",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo_descr = Memo,",
				"          Sticker_Requirement_descr = Sticker_Requirements,",
				"          Inner_Requirement_descr = Inner_Requirements,",
				"          Customer_Requirement_descr = Customer_Requirements,",
				"          Sales_Program_descr = Sales_Program,",
				"          Buyer_Dept_descr = Buyer_Dept,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program_descr = Dept_Program,",
				"          Program_descr = Program_0,",
				"          Cancelled_descr = Cancelled,",
				"          Confidence_Factor_descr = Confidence_Factor_Id,",
				"          Price_Sticker_Id,",
				"          Po_nbr = Po,",
				"          Release_Order_Number,",
				"          Cntnr_,",
				"          Etd_Ship_Date,",
				"          Ship_Date_Outbound,",
				"          Cancel_Date_Outbound,",
				"          Expiration_Date,",
				"          Item_qty = Item_Count,",
				"          Inner_qty = Inner_Qty,",
				"          Release_qty = Release_Quantity,",
				"          Quantity_Received_In_Shipment,",
				"          Item_Unit_Price,",
				"          Amount,",
				"          Eta_Arrival_Date,",
				"          Delete_Flg,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp,",
				"          Location_key,",
				"          Date_Last_Modified,",
				"          Customer_key,",
				"          Create_Date,",
				"          Trade_partner_CD,",
				"          On_Hand_Quantity,",
				"          SSCC14_nbr,",
				"          Master_Carton_Item_nbr,",
				"          Item_Key,",
				"          Sales_Rep_Name,",
				"          Sales_key,",
				"          Month_Ship_dt,",
				"          ETD_dt,",
				"          Month_ETD_dt,",
				"          MS_Domestic_Ship_Date,",
				"          MS_Domestic_Cancel_Date,",
				"          Sticker_Requirement_Purchase_descr = Sticker_Requirements",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['STG_Purchaseorder.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}