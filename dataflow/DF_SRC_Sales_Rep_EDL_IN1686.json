{
	"name": "DF_SRC_Sales_Rep_EDL_IN1686",
	"properties": {
		"folder": {
			"name": "workshop/SRC_EDL"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Excel_IN1686",
						"type": "DatasetReference"
					},
					"name": "SrcSalesRep"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV1_IN1686",
						"type": "DatasetReference"
					},
					"name": "W2LocationEDLIN1686"
				}
			],
			"transformations": [
				{
					"name": "AduitColumn"
				},
				{
					"name": "select1"
				},
				{
					"name": "SalesKey"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename4 as string",
				"}",
				"source(output(",
				"          Sales_Key as short,",
				"          Sales_Rep_Id as short,",
				"          Sales_Rep_Name as string,",
				"          LoginAccess as boolean,",
				"          Email as string,",
				"          Phone as string,",
				"          Address as string,",
				"          City as string,",
				"          Country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcSalesRep",
				"SalesKey derive(Delete_Flag = \"N\",",
				"          Create_Date = currentDate(),",
				"          Date_Last_Modified = toTimestamp(\"1990-01-01\", \"dd-MM-yyyy hh:mm:ss\"),",
				"          Created_By = \"IN1868_Sanjay_Komala\",",
				"          Created_Timestamp = currentTimestamp(),",
				"          Last_Updated_By = toString(null()),",
				"          Last_Update_Timestamp = toTimestamp(\"1990-01-01\", \"dd-MM-yyyy hh:mm:ss\"),",
				"          Active_Flag = \"Y\") ~> AduitColumn",
				"SrcSalesRep select(mapColumn(",
				"          Sales_Rep_Id,",
				"          Sales_Rep_Name,",
				"          LoginAccess,",
				"          Email,",
				"          Phone,",
				"          Address,",
				"          City,",
				"          Country",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 keyGenerate(output(Sales_Key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> SalesKey",
				"AduitColumn sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:[($filename4)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> W2LocationEDLIN1686"
			]
		}
	}
}