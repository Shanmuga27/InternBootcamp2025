{
	"name": "DF_Products",
	"properties": {
		"folder": {
			"name": "MOCK/STG_DW"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference"
					},
					"name": "sourcePROD"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "surrogateKey1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ProductID as short,",
				"          ProductName as string,",
				"          Category as string,",
				"          Price as integer,",
				"          created_date as timestamp 'MM/dd/yyyy HH:mm:ss',",
				"          created_by as string,",
				"          updated_date as timestamp 'MM/dd/yyyy HH:mm:ss',",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourcePROD",
				"sourcePROD derive(start_date = currentTimestamp(),",
				"          end_date = toTimestamp(null()),",
				"          isActive = 'Y',",
				"          ProductName = initCap(ProductName)) ~> derivedColumn1",
				"derivedColumn1 keyGenerate(output(Product_Key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1"
			]
		}
	}
}