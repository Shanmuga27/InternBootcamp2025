{
	"name": "DF_edl_to_stg_estimate",
	"properties": {
		"folder": {
			"name": "edl_to_stg"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename as string",
				"}",
				"source(output(",
				"          Transaction_Id as integer,",
				"          Transaction_Line_Id as integer,",
				"          Memo as string,",
				"          Sticker_Requirements as string,",
				"          Inner_Requirements as string,",
				"          Customer_Requirements as string,",
				"          Sales_Program as string,",
				"          Buyer_Dept as string,",
				"          Buyer_Confirmed_On as string,",
				"          Dept_Program as string,",
				"          Program_0 as string,",
				"          Cancelled as string,",
				"          Confidence_Factor_Id as string,",
				"          Company_Id as integer,",
				"          Item_Id as string,",
				"          Location_Id as string,",
				"          Sales_Rep_Id as string,",
				"          TranId as string,",
				"          Price_Sticker_Id as string,",
				"          Po as string,",
				"          Release_Order_Number as string,",
				"          Cntnr_ as string,",
				"          Etd_Ship_Date as string,",
				"          Ship_Date_Outbound as string,",
				"          Cancel_Date_Outbound as string,",
				"          Expiration_Date as string,",
				"          Item_Count as string,",
				"          Inner_Qty as string,",
				"          Release_Quantity as string,",
				"          Quantity_Received_In_Shipment as string,",
				"          Item_Unit_Price as string,",
				"          Amount as string,",
				"          Eta_Arrival_Date as string,",
				"          Closed_Script as boolean,",
				"          Estimate_key as integer,",
				"          Delete_flag as boolean,",
				"          Created_by as string,",
				"          Created_timestamp as timestamp,",
				"          Last_updated_by as string,",
				"          Last_updated_timestamp as timestamp,",
				"          Created_date as timestamp,",
				"          Date_created as timestamp,",
				"          Date_last_modified_gmt as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(each(match(type == 'string'), $$ = replace(iifNull($$, \"UNK\"),'NULL','UNK')),",
				"          each(match(type=='integer'), $$ = iifNull($$, 0)),",
				"          each(match(type=='timestamp'), $$ = iifNull($$, toTimestamp('1900-01-01', 'yyyy-MM-dd')))) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo,",
				"          Sticker_Requirements,",
				"          Inner_Requirements,",
				"          Customer_Requirements,",
				"          Sales_Program,",
				"          Buyer_Dept,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program,",
				"          Program_0,",
				"          Cancelled,",
				"          Confidence_Factor_Id,",
				"          Company_Id,",
				"          Item_Id,",
				"          Location_Id,",
				"          Sales_Rep_Id,",
				"          TranId,",
				"          Price_Sticker_Id,",
				"          Po,",
				"          Release_Order_Number,",
				"          Cntnr_,",
				"          Etd_Ship_Date,",
				"          Ship_Date_Outbound,",
				"          Cancel_Date_Outbound,",
				"          Expiration_Date,",
				"          Item_Count,",
				"          Inner_Qty,",
				"          Release_Quantity,",
				"          Quantity_Received_In_Shipment,",
				"          Item_Unit_Price,",
				"          Amount,",
				"          Eta_Arrival_Date,",
				"          Closed_Script,",
				"          Estimate_key,",
				"          Delete_flag,",
				"          Created_by,",
				"          Created_timestamp,",
				"          Last_updated_by,",
				"          Last_updated_timestamp,",
				"          Created_date,",
				"          Date_created,",
				"          Date_last_modified_gmt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     partitionFileNames:[($filename)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}