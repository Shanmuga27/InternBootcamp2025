{
	"name": "DF_STG_DW_SalesRep",
	"properties": {
		"folder": {
			"name": "Workshop_IN1675/STG_DW_IN1675"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "SrcItems"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "TgtItems"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "union1"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "select4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Sales_Rep_Id as integer,",
				"          Sales_Key as integer,",
				"          Sales_Rep_Name as string,",
				"          Sales_Rep_Address as string,",
				"          Sales_Rep_City as string,",
				"          Sales_Rep_Country as string,",
				"          Sales_Rep_Email as string,",
				"          Sales_Rep_LoginAccess as string,",
				"          Sales_Rep_Phone as string,",
				"          Delete_Flag as string,",
				"          Active_Flag as string,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          Date_last_Modified as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcItems",
				"source(output(",
				"          Sales_Rep_key as integer,",
				"          Sales_Rep_ID as integer,",
				"          Sales_Rep_Name as string,",
				"          Sales_Rep_Address as string,",
				"          Sales_Rep_City as string,",
				"          Sales_Rep_Country as string,",
				"          Sales_Rep_Email as string,",
				"          Sales_Rep_Loginaccess as string,",
				"          Sales_Rep_Phone as string,",
				"          Delete_Flg as string,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          prev_city as string,",
				"          prev_country as string,",
				"          prev_phone as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TgtItems",
				"SrcItems, TgtItems join(SrcItems@Sales_Rep_Id == TgtItems@Sales_Rep_ID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"derivedColumn1 select(mapColumn(",
				"          Sales_Rep_Id = split1@NewRows@Sales_Rep_Id,",
				"          Sales_Key,",
				"          Sales_Rep_Name = split1@NewRows@Sales_Rep_Name,",
				"          Sales_Rep_Address = split1@NewRows@Sales_Rep_Address,",
				"          Sales_Rep_City = split1@NewRows@Sales_Rep_City,",
				"          Sales_Rep_Country = split1@NewRows@Sales_Rep_Country,",
				"          Sales_Rep_Email = split1@NewRows@Sales_Rep_Email,",
				"          Sales_Rep_LoginAccess = split1@NewRows@Sales_Rep_LoginAccess,",
				"          Sales_Rep_Phone = split1@NewRows@Sales_Rep_Phone,",
				"          prev_city,",
				"          prev_country,",
				"          prev_phone,",
				"          Delete_Flg,",
				"          Create_Date,",
				"          Date_Last_Modified = split1@NewRows@Date_Last_Modified,",
				"          Created_By,",
				"          Created_Timestamp = split1@NewRows@Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"join1 split(isNull(TgtItems@Sales_Rep_ID),",
				"     !isNull(TgtItems@Sales_Rep_ID) && SrcItems@Sales_Rep_City != TgtItems@Sales_Rep_City,",
				"     !isNull(TgtItems@Sales_Rep_ID) && TgtItems@Sales_Rep_Country != SrcItems@Sales_Rep_Country",
				",",
				"     !isNull(TgtItems@Sales_Rep_ID) && TgtItems@Sales_Rep_Phone != SrcItems@Sales_Rep_Phone,",
				"     disjoint: false) ~> split1@(NewRows, CityChanged, CountryChanged, PhoneChanged)",
				"split1@NewRows derive(prev_city = 'unk',",
				"          prev_country = 'unk',",
				"          prev_phone = 'unk',",
				"          Create_Date = toTimestamp(currentDate()),",
				"          Created_By = 'IN1675',",
				"          Date_last_Modified = toTimestamp(currentDate()),",
				"          Last_Updated_By = 'IN1675',",
				"          Last_Update_Timestamp = currentTimestamp()) ~> derivedColumn1",
				"split1@CityChanged derive(prev_city = split1@CityChanged@Sales_Rep_City,",
				"          Sales_Rep_City = split1@CityChanged@Sales_Rep_City,",
				"          Date_Last_Modified = toTimestamp(currentDate()),",
				"          Last_Updated_By = 'IN1675',",
				"          Last_Update_Timestamp = currentTimestamp(),",
				"          Delete_Flag = 'Y') ~> derivedColumn2",
				"split1@CountryChanged derive(prev_country = split1@CountryChanged@Sales_Rep_Country,",
				"          Sales_Rep_Country = split1@CountryChanged@Sales_Rep_City,",
				"          Last_Updated_By = 'IN1675',",
				"          Date_last_Modified = toTimestamp(currentDate()),",
				"          Last_Update_Timestamp = currentTimestamp()\r",
				",",
				"          Delete_Flag = 'Y') ~> derivedColumn3",
				"derivedColumn2 select(mapColumn(",
				"          Sales_Rep_Id = split1@CityChanged@Sales_Rep_Id,",
				"          Sales_Key,",
				"          Sales_Rep_Name = split1@CityChanged@Sales_Rep_Name,",
				"          Sales_Rep_Address = split1@CityChanged@Sales_Rep_Address,",
				"          Sales_Rep_City,",
				"          Sales_Rep_Country = split1@CityChanged@Sales_Rep_Country,",
				"          Sales_Rep_Email = split1@CityChanged@Sales_Rep_Email,",
				"          Sales_Rep_LoginAccess = split1@CityChanged@Sales_Rep_LoginAccess,",
				"          Sales_Rep_Phone = split1@CityChanged@Sales_Rep_Phone,",
				"          prev_city,",
				"          prev_country,",
				"          prev_phone,",
				"          Create_Date = split1@CityChanged@Create_Date,",
				"          Date_Last_Modified = derivedColumn2@Date_Last_Modified,",
				"          Created_By = split1@CityChanged@Created_By,",
				"          Created_Timestamp = split1@CityChanged@Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp,",
				"          Delete_Flag",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"derivedColumn3 select(mapColumn(",
				"          Sales_Rep_Id = split1@CountryChanged@Sales_Rep_Id,",
				"          Sales_Key,",
				"          Sales_Rep_Name = split1@CountryChanged@Sales_Rep_Name,",
				"          Sales_Rep_Address = split1@CountryChanged@Sales_Rep_Address,",
				"          Sales_Rep_City = split1@CountryChanged@Sales_Rep_City,",
				"          Sales_Rep_Country,",
				"          Sales_Rep_Email = split1@CountryChanged@Sales_Rep_Email,",
				"          Sales_Rep_LoginAccess = split1@CountryChanged@Sales_Rep_LoginAccess,",
				"          Sales_Rep_Phone = split1@CountryChanged@Sales_Rep_Phone,",
				"          prev_city,",
				"          prev_country,",
				"          prev_phone,",
				"          Delete_Flag,",
				"          Create_Date = split1@CountryChanged@Create_Date,",
				"          Date_Last_Modified = split1@CountryChanged@Date_Last_Modified,",
				"          Created_By = split1@CountryChanged@Created_By,",
				"          Created_Timestamp = split1@CountryChanged@Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1, select3, select2, select4 union(byName: true)~> union1",
				"split1@PhoneChanged derive(prev_phone = split1@PhoneChanged@Sales_Rep_Phone,",
				"          Sales_Rep_Phone = split1@PhoneChanged@Sales_Rep_Phone,",
				"          Last_Updated_By = 'IN1675',",
				"          Date_Last_Modified = toTimestamp(currentDate()),",
				"          Last_Update_Timestamp = currentTimestamp(),",
				"          Delete_Flag = 'Y') ~> derivedColumn4",
				"derivedColumn4 select(mapColumn(",
				"          Sales_Rep_Id = split1@PhoneChanged@Sales_Rep_Id,",
				"          Sales_Key,",
				"          Sales_Rep_Name = split1@PhoneChanged@Sales_Rep_Name,",
				"          Sales_Rep_Address = split1@PhoneChanged@Sales_Rep_Address,",
				"          Sales_Rep_City = split1@PhoneChanged@Sales_Rep_City,",
				"          Sales_Rep_Country = split1@PhoneChanged@Sales_Rep_Country,",
				"          Sales_Rep_Email = split1@PhoneChanged@Sales_Rep_Email,",
				"          Sales_Rep_LoginAccess = split1@PhoneChanged@Sales_Rep_LoginAccess,",
				"          Sales_Rep_Phone,",
				"          prev_city,",
				"          prev_country,",
				"          prev_phone,",
				"          Delete_Flag,",
				"          Create_Date = split1@PhoneChanged@Create_Date,",
				"          Date_Last_Modified = derivedColumn4@Date_Last_Modified,",
				"          Created_By = split1@PhoneChanged@Created_By,",
				"          Created_Timestamp = split1@PhoneChanged@Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4"
			]
		}
	}
}