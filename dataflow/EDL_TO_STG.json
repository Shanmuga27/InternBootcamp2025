{
	"name": "EDL_TO_STG",
	"properties": {
		"folder": {
			"name": "Workshop_answers"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "STGCustomer"
				},
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "STGestimate"
				},
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "locationsource"
				},
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "customersrc"
				},
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "productsrc"
				},
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "locationsrc"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "STGSINKcus"
				},
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "estsink"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "join1"
				},
				{
					"name": "select2"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "join2"
				},
				{
					"name": "select3"
				},
				{
					"name": "select4"
				},
				{
					"name": "join3"
				},
				{
					"name": "select5"
				},
				{
					"name": "join4"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename as string",
				"}",
				"source(output(",
				"          Customer_Id as integer,",
				"          Company_Name as string,",
				"          Customer_Key as short,",
				"          Delete_Flag as string,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          {Created_By } as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          Active_Flag as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> STGCustomer",
				"source(output(",
				"          Transaction_Id as integer,",
				"          Transaction_Line_Id as integer,",
				"          Memo as string,",
				"          Sticker_Requirements as string,",
				"          Inner_Requirements as string,",
				"          Customer_Requirements as string,",
				"          Sales_Program as string,",
				"          Buyer_Dept as string,",
				"          Buyer_Confirmed_On as string,",
				"          Dept_Program as timestamp,",
				"          Program_0 as string,",
				"          Cancelled as string,",
				"          Confidence_Factor_Id as string,",
				"          Company_Id as integer,",
				"          Item_Id as integer,",
				"          Location_Id as integer,",
				"          Sales_Rep_Id as integer,",
				"          TranId as string,",
				"          Price_Sticker_Id as string,",
				"          Po as integer,",
				"          Release_Order_Number as string,",
				"          Cntnr_ as string,",
				"          Etd_Ship_Date as date,",
				"          Ship_Date_Outbound as string,",
				"          Cancel_Date_Outbound as string,",
				"          Expiration_Date as string,",
				"          Item_Count as string,",
				"          Inner_Qty as string,",
				"          Release_Quantity as string,",
				"          Quantity_Received_In_Shipment as string,",
				"          Item_Unit_Price as string,",
				"          Amount as string,",
				"          Eta_Arrival_Date as string,",
				"          Closed_Script as string,",
				"          Estimate_key as short,",
				"          Delete_Flag as string,",
				"          Create_Date as timestamp,",
				"          Date_Created as timestamp,",
				"          Date_Last_Modified_Gmt as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> STGestimate",
				"source(output(",
				"          Location_Id as string,",
				"          Name as string,",
				"          City as string,",
				"          Country as string,",
				"          State as string,",
				"          Zipcode as string,",
				"          Location_key as short,",
				"          Delete_Flg as boolean,",
				"          Active_Flag as boolean,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> locationsource",
				"source(output(",
				"          Customer_Id as integer,",
				"          Company_Name as string,",
				"          Customer_Key as short,",
				"          Delete_Flag as boolean,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          {Created_By } as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          Active_Flag as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> customersrc",
				"source(output(",
				"          Item_Id as string,",
				"          Generic_Description as string,",
				"          PurchaseDescription as string,",
				"          Artwork as string,",
				"          Color as string,",
				"          Package_Type as string,",
				"          Special_Requirements as string,",
				"          Case_Pack as string,",
				"          Full_Name as string,",
				"          Display_Name as string,",
				"          Account_Manager_Name as string,",
				"          Brand_Name as string,",
				"          Brand_Manager_Name as string,",
				"          Item_Status as string,",
				"          Item_Type as string,",
				"          Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Master_Carton_Rqmnts as string,",
				"          Trade_Partner_Name as string,",
				"          Part_Of_Assembly_Item as string,",
				"          Type_Name as string,",
				"          Trade_Partner_Code as string,",
				"          VendorName as string,",
				"          UPC as string,",
				"          QunatityOnHand as string,",
				"          SSCC14 as string,",
				"          Master_Carton_Markings_Item_N as string,",
				"          Item_key as short,",
				"          Delete_flg as boolean,",
				"          Active_Flag as boolean,",
				"          Create_Date as timestamp,",
				"          Date_last_modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> productsrc",
				"source(output(",
				"          Location_Id as string,",
				"          Name as string,",
				"          City as string,",
				"          Country as string,",
				"          State as string,",
				"          Zipcode as string,",
				"          Location_key as short,",
				"          Delete_Flg as boolean,",
				"          Active_Flag as boolean,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> locationsrc",
				"STGCustomer filter(Active_Flag == 'Y') ~> filter1",
				"STGestimate select(mapColumn(",
				"          Transaction_ID = Transaction_Id,",
				"          Transaction_Line_ID = Transaction_Line_Id,",
				"          Memo_descr = Memo,",
				"          Sticker_Requirement_descr = Sticker_Requirements,",
				"          Inner_Requirement_descr = Inner_Requirements,",
				"          Customer_Requirement_descr = Customer_Requirements,",
				"          Sales_Program_descr = Sales_Program,",
				"          Buyer_Dept_descr = Buyer_Dept,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program_descr = Dept_Program,",
				"          Program_descr = Program_0,",
				"          Cancelled_descr = Cancelled,",
				"          Confidence_Factor_descr = Confidence_Factor_Id,",
				"          Company_Id,",
				"          Item_Id,",
				"          Location_Id,",
				"          Sales_Rep_Id,",
				"          Document_nbr = TranId,",
				"          Price_Sticker_descr = Price_Sticker_Id,",
				"          PO_nbr = Po,",
				"          Release_Order_nbr = Release_Order_Number,",
				"          CNTNR_nbr = Cntnr_,",
				"          ETD_Ship_dt = Etd_Ship_Date,",
				"          Ship_Outbound_dt = Ship_Date_Outbound,",
				"          Cancel_Outbound_dt = Cancel_Date_Outbound,",
				"          Expiration_dt = Expiration_Date,",
				"          Item_qty = Item_Count,",
				"          Inner_qty = Inner_Qty,",
				"          Release_qty = Release_Quantity,",
				"          Quantity_Received_In_Shipment,",
				"          Item_unit_price = Item_Unit_Price,",
				"          Amount,",
				"          ETA_Arrival_Date = Eta_Arrival_Date,",
				"          Closed_Script,",
				"          Estimate_key,",
				"          Delete_Flg = Delete_Flag,",
				"          Create_date = Create_Date,",
				"          date_created = Date_Created,",
				"          date_last_modified_gmt = Date_Last_Modified_Gmt,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Uodated_By = Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(Sticker_Requirement_Purchase_descr = iif(\r",
				"  Sticker_Requirement_descr == '0', \r",
				"  'No Stickers', \r",
				"  iif(\r",
				"    Inner_Requirement_descr == '0' && Customer_Requirement_descr == '0', \r",
				"    toString(Sticker_Requirement_descr), \r",
				"    iif(\r",
				"      Customer_Requirement_descr == '0', \r",
				"      toString(Sticker_Requirement_descr), \r",
				"      ''\r",
				"    )\r",
				"  )\r",
				"),",
				"          Confidence_Factor_descr = iif(Confidence_Factor_descr == '1', '25%',\r",
				"iif(Confidence_Factor_descr == '2', '50%',\r",
				"iif(Confidence_Factor_descr == '3', '75%',\r",
				"iif(Confidence_Factor_descr == '4', '90%',\r",
				"iif(Confidence_Factor_descr == '5', 'Dropped',\r",
				"iif(Confidence_Factor_descr == '6', 'Actual',\r",
				"iif(Confidence_Factor_descr == '7', '90%-Pre',\r",
				"iif(Confidence_Factor_descr == '8', '90%-Releases', 'Unknown')))))))),",
				"          Level_Descr = iif(Confidence_Factor_descr == '25%', '',\r",
				"iif(Confidence_Factor_descr == '50%', '',\r",
				"iif(Confidence_Factor_descr == 'Dropped', '',\r",
				"iif(Confidence_Factor_descr == '75%', 'Pending Confirmation',\r",
				"iif(Confidence_Factor_descr == '90%', 'Pending Approval%',\r",
				"iif(Confidence_Factor_descr == 'Actual', 'Confirmed',\r",
				"iif(Confidence_Factor_descr == '90%-Pre', 'Confirmed',\r",
				"iif(Confidence_Factor_descr == '90%-Releases', 'Confirmed', '')))))))),",
				"          Month_Ship_dt = concat(\r",
				"  toString(year(toDate(Ship_Outbound_dt))),\r",
				"  '-',\r",
				"  toString(month(toDate(Ship_Outbound_dt)))\r",
				")\r",
				") ~> derivedColumn1",
				"derivedColumn1, select2 join(Location_Id == Location_key,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"locationsource select(mapColumn(",
				"          Location_key = Location_Id,",
				"          Location_Name = Name,",
				"          Loaction_City = City",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"join1 derive(Final_Destination_Container = concat(Loaction_City, ' - ',Location_Name),",
				"          Price_Sticker_descr = case(like(Sticker_Requirement_descr,'%$%price sticker'),replace(replace(Sticker_Requirement_descr,'$',''),' price sticker',''), 'No Sticker'),",
				"          ETD_dt = iif(\r",
				"  like(Location_Name, '%DotCom Distribution - Edison NJ%'),\r",
				"  subDays(toDate(Ship_Outbound_dt, 'MM/dd/yy', 'en-US'), 66),\r",
				"  iif(\r",
				"    like(Location_Name, '%Berkley%'),\r",
				"    subDays(toDate(Ship_Outbound_dt, 'MM/dd/yy', 'en-US'), 59),\r",
				"    iif(\r",
				"      like(Location_Name, '%POE China%'),\r",
				"      subDays(toDate(Ship_Outbound_dt, 'MM/dd/yy', 'en-US'), 14),\r",
				"      iif(\r",
				"        like(Location_Name, '%POE OAK%'),\r",
				"        subDays(toDate(Ship_Outbound_dt, 'MM/dd/yy', 'en-US'), 59),\r",
				"        iif(\r",
				"          like(Location_Name, '%POE Vietnam%'),\r",
				"          subDays(toDate(Ship_Outbound_dt, 'MM/dd/yy', 'en-US'), 14),\r",
				"          subDays(toDate(Ship_Outbound_dt, 'MM/dd/yy', 'en-US'), 45)\r",
				"        )\r",
				"      )\r",
				"    )\r",
				"  )\r",
				")\r",
				",",
				"          Month_ETD_dt = concat(toString(year(ETD_Ship_dt)),'-',toString(month(ETD_Ship_dt))),",
				"          MS_Domestic_Ship_Date = subDays(ETD_Ship_dt,45),",
				"          MS_Domestic_Cancel_Date = addDays(ETD_Ship_dt, 55)) ~> derivedColumn2",
				"derivedColumn2, select3 join(Company_Id == Customer_Key,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"customersrc select(mapColumn(",
				"          Customer_Key = Customer_Id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"productsrc select(mapColumn(",
				"          Item_Key = Item_Id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"join2, select4 join(Item_Id == Item_Key,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"locationsrc select(mapColumn(",
				"          Location_Key = Location_Id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select5",
				"join3, select5 join(Location_Id == select5@Location_Key,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join4",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:[($filename)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> STGSINKcus",
				"join4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:[($filename)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> estsink"
			]
		}
	}
}