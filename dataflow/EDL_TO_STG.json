{
	"name": "EDL_TO_STG",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "STGCustomer"
				},
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "STGestimate"
				},
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "locationsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "STGSINKcus"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "join1"
				},
				{
					"name": "select2"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename as string",
				"}",
				"source(output(",
				"          Customer_Id as integer,",
				"          Company_Name as string,",
				"          Customer_Key as short,",
				"          Delete_Flag as string,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          {Created_By } as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          Active_Flag as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> STGCustomer",
				"source(output(",
				"          Transaction_Id as integer,",
				"          Transaction_Line_Id as short,",
				"          Memo as string,",
				"          Sticker_Requirements as string,",
				"          Inner_Requirements as string,",
				"          Customer_Requirements as string,",
				"          Sales_Program as string,",
				"          Buyer_Dept as string,",
				"          Buyer_Confirmed_On as string,",
				"          Dept_Program as string,",
				"          Program_0 as string,",
				"          Cancelled as string,",
				"          Confidence_Factor_Id as string,",
				"          Company_Id as integer,",
				"          Item_Id as string,",
				"          Location_Id as string,",
				"          Sales_Rep_Id as string,",
				"          TranId as string,",
				"          Price_Sticker_Id as string,",
				"          Po as string,",
				"          Release_Order_Number as string,",
				"          Cntnr_ as string,",
				"          Etd_Ship_Date as string,",
				"          Ship_Date_Outbound as string,",
				"          Cancel_Date_Outbound as string,",
				"          Expiration_Date as string,",
				"          Item_Count as string,",
				"          Inner_Qty as string,",
				"          Release_Quantity as string,",
				"          Quantity_Received_In_Shipment as string,",
				"          Item_Unit_Price as string,",
				"          Amount as string,",
				"          Eta_Arrival_Date as string,",
				"          Closed_Script as string,",
				"          Estimate_key as short,",
				"          Delete_Flag as string,",
				"          Create_Date as timestamp,",
				"          Date_Created as string,",
				"          Date_Last_Modified_Gmt as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> STGestimate",
				"source(output(",
				"          Location_Id as string,",
				"          Name as string,",
				"          City as string,",
				"          Country as string,",
				"          State as string,",
				"          Zipcode as string,",
				"          Location_key as short,",
				"          Delete_Flg as boolean,",
				"          Active_Flag as boolean,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> locationsource",
				"STGCustomer filter(Active_Flag == 'Y') ~> filter1",
				"STGestimate select(mapColumn(",
				"          Transaction_ID = Transaction_Id,",
				"          Transaction_Line_ID = Transaction_Line_Id,",
				"          Memo_descr = Memo,",
				"          Sticker_Requirement_descr = Sticker_Requirements,",
				"          Inner_Requirement_descr = Inner_Requirements,",
				"          Customer_Requirement_descr = Customer_Requirements,",
				"          Sales_Program_descr = Sales_Program,",
				"          Buyer_Dept_descr = Buyer_Dept,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program_descr = Dept_Program,",
				"          Program_descr = Program_0,",
				"          Cancelled_descr = Cancelled,",
				"          Confidence_Factor_descr = Confidence_Factor_Id,",
				"          Company_Id,",
				"          Item_Id,",
				"          Location_Id,",
				"          Sales_Rep_Id,",
				"          TranId,",
				"          Price_Sticker_descr = Price_Sticker_Id,",
				"          Po,",
				"          Release_Order_Number,",
				"          Cntnr_,",
				"          Etd_Ship_Date,",
				"          Ship_Date_Outbound,",
				"          Cancel_Date_Outbound,",
				"          Expiration_Date,",
				"          Item_Count,",
				"          Inner_Qty,",
				"          Release_Quantity,",
				"          Quantity_Received_In_Shipment,",
				"          Item_Unit_Price,",
				"          Amount,",
				"          Eta_Arrival_Date,",
				"          Closed_Script,",
				"          Estimate_key,",
				"          Delete_Flag,",
				"          Create_Date,",
				"          Date_Created,",
				"          Date_Last_Modified_Gmt,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(Sticker_Requirement_Purchase_descr = iif(\r",
				"  Sticker_Requirement_descr == '0', \r",
				"  'No Stickers', \r",
				"  iif(\r",
				"    Inner_Requirement_descr == '0' && Customer_Requirement_descr == '0', \r",
				"    toString(Sticker_Requirement_descr), \r",
				"    iif(\r",
				"      Customer_Requirement_descr == '0', \r",
				"      toString(Sticker_Requirement_descr), \r",
				"      ''\r",
				"    )\r",
				"  )\r",
				")\r",
				",",
				"          Confidence_Factor_descr = iif(Confidence_Factor_descr == '1', '25%',\r",
				"iif(Confidence_Factor_descr == '2', '50%',\r",
				"iif(Confidence_Factor_descr == '3', '75%',\r",
				"iif(Confidence_Factor_descr == '4', '90%',\r",
				"iif(Confidence_Factor_descr == '5', 'Dropped',\r",
				"iif(Confidence_Factor_descr == '6', 'Actual',\r",
				"iif(Confidence_Factor_descr == '7', '90%-Pre',\r",
				"iif(Confidence_Factor_descr == '8', '90%-Releases', 'Unknown')))))))),",
				"          Level_Descr = iif(Confidence_Factor_descr == '25%', '',\r",
				"iif(Confidence_Factor_descr == '50%', '',\r",
				"iif(Confidence_Factor_descr == 'Dropped', '',\r",
				"iif(Confidence_Factor_descr == '75%', 'Pending Confirmation',\r",
				"iif(Confidence_Factor_descr == '90%', 'Pending Approval%',\r",
				"iif(Confidence_Factor_descr == 'Actual', 'Confirmed',\r",
				"iif(Confidence_Factor_descr == '90%-Pre', 'Confirmed',\r",
				"iif(Confidence_Factor_descr == '90%-Releases', 'Confirmed', ''))))))))\r",
				") ~> derivedColumn1",
				"derivedColumn1, select2 join(Location_Id == Location_key,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"locationsource select(mapColumn(",
				"          Location_key = Location_Id,",
				"          Location_Name = Name,",
				"          Loaction_City = City",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"join1 derive(Final_Destination_Container = concat(Loaction_City, ' - ',Location_Name)\r",
				",",
				"          Price_Sticker_descr = case(like(Sticker_Requirement_descr,'%$%price sticker'),replace(replace(Sticker_Requirement_descr,'$',''),' price sticker',''), 'No Sticker')) ~> derivedColumn2",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:[($filename)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> STGSINKcus"
			]
		}
	}
}