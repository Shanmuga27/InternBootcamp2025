{
	"name": "DF_stg_to_products_IN1680",
	"properties": {
		"folder": {
			"name": "DFmock_stg_tgt"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "SRCproducts"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "SNKproducts"
				}
			],
			"transformations": [
				{
					"name": "surrogateproduct"
				},
				{
					"name": "derivedInit"
				},
				{
					"name": "selectFinal"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename as string",
				"}",
				"source(output(",
				"          ProductID as short,",
				"          ProductName as string,",
				"          Category as string,",
				"          Price as integer,",
				"          {created date} as string,",
				"          {created by } as string,",
				"          {updated date} as string,",
				"          {updated by} as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCproducts",
				"SRCproducts keyGenerate(output(product_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateproduct",
				"surrogateproduct derive(ProductName_init = initCap(ProductName),",
				"          isActive = 'Y',",
				"          start_date = currentTimestamp(),",
				"          end_date = currentTimestamp()) ~> derivedInit",
				"derivedInit select(mapColumn(",
				"          ProductID,",
				"          Category,",
				"          Price,",
				"          {created date},",
				"          {created by },",
				"          {updated date},",
				"          {updated by},",
				"          runid,",
				"          product_key,",
				"          ProductName = ProductName_init,",
				"          isActive,",
				"          start_date,",
				"          end_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectFinal",
				"selectFinal sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     partitionFileNames:[($filename)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SNKproducts"
			]
		}
	}
}