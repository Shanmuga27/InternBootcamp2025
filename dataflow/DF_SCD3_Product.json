{
	"name": "DF_SCD3_Product",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Src",
						"type": "DatasetReference"
					},
					"name": "SrcProduct"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "TgtProduct"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "join1"
				},
				{
					"name": "split1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "alterRow2"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Item_Id as integer,",
				"          Item_key as integer,",
				"          Items_Descr as string,",
				"          Brand_descr as string,",
				"          Artwork_descr as string,",
				"          Color_descr as string,",
				"          Package_Type_descr as string,",
				"          Special_Req_descr as string,",
				"          Case_Pack_descr as string,",
				"          Full_Name_descr as string,",
				"          Display_Name_descr as string,",
				"          Account_Manager_Name as string,",
				"          Brand_Name as string,",
				"          Brand_Manager_Name as string,",
				"          Item_Status_descr as string,",
				"          Item_Type_descr as string,",
				"          Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Master_Carton_req_descr as string,",
				"          Trade_Partner_Name as string,",
				"          Type_Name as string,",
				"          Trade_Partner_Code as string,",
				"          VendorName as string,",
				"          UPC_nbr as string,",
				"          ON_Hand_Quality as integer,",
				"          SSCC14_nbr as integer,",
				"          Master_Carton_Item_nbr as integer,",
				"          Part_Of_Assembly_Item as string,",
				"          Delete_flg as string,",
				"          Active_Flag as string,",
				"          Create_Date as timestamp,",
				"          Date_last_modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcProduct",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TgtProduct",
				"SrcProduct select(mapColumn(",
				"          Item_key,",
				"          Item_Id,",
				"          Item_Descr = Items_Descr,",
				"          Brand_descr,",
				"          Artwork_descr,",
				"          Color_descr,",
				"          Package_Type_descr,",
				"          Special_Req_descr,",
				"          Case_Pack_descr,",
				"          Full_Name_descr,",
				"          Display_Name_descr,",
				"          Account_Manager_Name,",
				"          Brand_Name,",
				"          Brand_Manager_Name,",
				"          Item_Status_descr,",
				"          Item_Type_descr,",
				"          Maker_Name,",
				"          Product_Manager_Name,",
				"          Master_Carton_req_descr,",
				"          Trade_Partner_Name,",
				"          Type_Name,",
				"          Trade_Partner_Cd = Trade_Partner_Code,",
				"          VendorName,",
				"          UPC_nbr,",
				"          ON_Hand_Quality,",
				"          SSCC14_nbr,",
				"          Master_Carton_Item_nbr,",
				"          Create_Date,",
				"          Date_last_modified,",
				"          Delete_flg,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 join(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 split(ERROR_FUNCTION(''),",
				"     disjoint: false) ~> split1@(, )",
				"split1 alterRow() ~> alterRow1",
				"split1 alterRow() ~> alterRow2",
				"alterRow1 union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Dm_Product'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}