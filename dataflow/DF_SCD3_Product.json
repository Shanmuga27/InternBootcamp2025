{
	"name": "DF_SCD3_Product",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Src",
						"type": "DatasetReference"
					},
					"name": "SrcProduct"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "TgtProduct"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "Srcprd"
				},
				{
					"name": "SrcTgtJoin"
				},
				{
					"name": "split1"
				},
				{
					"name": "insert"
				},
				{
					"name": "union1"
				},
				{
					"name": "update"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "tgtprd"
				},
				{
					"name": "select3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Item_Id as integer,",
				"          Item_key as integer,",
				"          Items_Descr as string,",
				"          Brand_descr as string,",
				"          Artwork_descr as string,",
				"          Color_descr as string,",
				"          Package_Type_descr as string,",
				"          Special_Req_descr as string,",
				"          Case_Pack_descr as string,",
				"          Full_Name_descr as string,",
				"          Display_Name_descr as string,",
				"          Account_Manager_Name as string,",
				"          Brand_Name as string,",
				"          Brand_Manager_Name as string,",
				"          Item_Status_descr as string,",
				"          Item_Type_descr as string,",
				"          Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Master_Carton_req_descr as string,",
				"          Trade_Partner_Name as string,",
				"          Type_Name as string,",
				"          Trade_Partner_Code as string,",
				"          VendorName as string,",
				"          UPC_nbr as string,",
				"          ON_Hand_Quality as integer,",
				"          SSCC14_nbr as integer,",
				"          Master_Carton_Item_nbr as integer,",
				"          Part_Of_Assembly_Item as string,",
				"          Delete_flg as string,",
				"          Active_Flag as string,",
				"          Create_Date as timestamp,",
				"          Date_last_modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcProduct",
				"source(output(",
				"          Item_key as integer,",
				"          Item_Id as integer,",
				"          Item_Descr as string,",
				"          Brand_descr as string,",
				"          Artwork_descr as string,",
				"          Color_descr as string,",
				"          Package_Type_descr as string,",
				"          Special_Req_descr as string,",
				"          Case_Pack_descr as string,",
				"          Full_Name_descr as string,",
				"          Display_Name_descr as string,",
				"          Account_Manager_Name as string,",
				"          Brand_Name as string,",
				"          Prev_Brand_Name as string,",
				"          Brand_Manager_Name as string,",
				"          Item_Status_descr as string,",
				"          Item_Type_descr as string,",
				"          Maker_Name as string,",
				"          Prev_Maker_Name as string,",
				"          Product_Manager_Name as string,",
				"          Master_Carton_req_descr as string,",
				"          Trade_Partner_Name as string,",
				"          Type_Name as string,",
				"          Trade_Partner_Cd as string,",
				"          VendorName as string,",
				"          UPC_nbr as string,",
				"          ON_Hand_Quality as integer,",
				"          SSCC14_nbr as integer,",
				"          Master_Carton_Item_nbr as integer,",
				"          Create_Date as timestamp,",
				"          Date_last_modified as timestamp,",
				"          Delete_flg as string,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TgtProduct",
				"SrcProduct select(mapColumn(",
				"          each(match(true()),",
				"               $$ +'_src' = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Srcprd",
				"select3, tgtprd join(Item_Id_src == Item_Id_tgt,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> SrcTgtJoin",
				"SrcTgtJoin split(isNull(Item_Id_tgt),",
				"     (Item_Id_src==Item_Id_tgt) && (Brand_Name_src!=Brand_Name_tgt || Maker_Name_src!=Maker_Name_tgt),",
				"     disjoint: false) ~> split1@(insert, update)",
				"split1@insert alterRow(insertIf(true())) ~> insert",
				"select1 union(byName: true)~> union1",
				"split1@update alterRow(updateIf(true())) ~> update",
				"insert derive(Brand_Name = Brand_Name_src,",
				"          Prev_Brand_Name = toString(null()),",
				"          Maker_Name = Maker_Name_src,",
				"          Prev_Maker_Name = toString(null()),",
				"          Create_Date_src = currentTimestamp(),",
				"          Date_last_modified_src = toTimestamp(null()),",
				"          Delete_flg_src = 'N',",
				"          Created_By_src = 'IN1677',",
				"          Created_Timestamp_src = currentTimestamp(),",
				"          Last_Updated_By_src = toString(null()),",
				"          Last_Update_Timestamp_src = toTimestamp(null())) ~> derivedColumn1",
				"update derive(Brand_Name = Brand_Name_src,",
				"          Prev_Brand_Name = Brand_Name_tgt,",
				"          Maker_Name = Maker_Name_src,",
				"          Prev_Maker_Name = Maker_Name_tgt,",
				"          Date_last_modified_src = currentTimestamp(),",
				"          Delete_flg_src = 'Y',",
				"          Last_Updated_By_src = 'IN1677',",
				"          Last_Update_Timestamp_src = currentTimestamp()) ~> derivedColumn2",
				"derivedColumn1 select(mapColumn(",
				"          each(match(/* All input columns */ true()),",
				"               /* Input name */ $$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumn2 select(mapColumn(",
				"          each(match(/* All input columns */ true()),",
				"               /* Input name */ $$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"TgtProduct select(mapColumn(",
				"          each(match(true()),",
				"               $$ +'_tgt' = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> tgtprd",
				"Srcprd select(mapColumn(",
				"          Item_key_src,",
				"          Item_Id_src,",
				"          Items_Descr_src,",
				"          Brand_descr_src,",
				"          Artwork_descr_src,",
				"          Color_descr_src,",
				"          Package_Type_descr_src,",
				"          Special_Req_descr_src,",
				"          Case_Pack_descr_src,",
				"          Full_Name_descr_src,",
				"          Display_Name_descr_src,",
				"          Account_Manager_Name_src,",
				"          Brand_Name_src,",
				"          Brand_Manager_Name_src,",
				"          Item_Status_descr_src,",
				"          Item_Type_descr_src,",
				"          Maker_Name_src,",
				"          Product_Manager_Name_src,",
				"          Master_Carton_req_descr_src,",
				"          Trade_Partner_Name_src,",
				"          Type_Name_src,",
				"          Trade_Partner_Code_src,",
				"          VendorName_src,",
				"          UPC_nbr_src,",
				"          ON_Hand_Quality_src,",
				"          SSCC14_nbr_src,",
				"          Master_Carton_Item_nbr_src,",
				"          Create_Date_src,",
				"          Date_last_modified_src,",
				"          Delete_flg_src,",
				"          Created_By_src,",
				"          Created_Timestamp_src,",
				"          Last_Updated_By_src,",
				"          Last_Update_Timestamp_src",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Dm_Product'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}