{
	"name": "DF_src_to_edl_sales_rep",
	"properties": {
		"folder": {
			"name": "src_to_edl"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_blob_excel_IN1680",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "surrogateKey1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename as string",
				"}",
				"source(output(",
				"          Sales_Key as short,",
				"          Sales_Rep_Id as short,",
				"          Sales_Rep_Name as string,",
				"          LoginAccess as boolean,",
				"          Email as string,",
				"          Phone as string,",
				"          Address as string,",
				"          City as string,",
				"          Country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false) ~> source1",
				"select1 keyGenerate(output(Sales_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L,",
				"     partitionBy('hash', 1)) ~> surrogateKey1",
				"surrogateKey1 derive(Delete_flag = \"N\",",
				"          Created_by = \"IN1680\",",
				"          Created_timestamp = currentTimestamp(),",
				"          Last_updated_by = \"IN1680\",",
				"          Last_updated_timestamp = currentTimestamp(),",
				"          Active_flag = \"Y\",",
				"          Created_date = currentTimestamp(),",
				"          Date_last_modified = currentTimestamp()) ~> derivedColumn1",
				"source1 select(mapColumn(",
				"          Sales_Rep_Id,",
				"          Sales_Rep_Name,",
				"          LoginAccess,",
				"          Email,",
				"          Phone,",
				"          Address,",
				"          City,",
				"          Country",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     partitionFileNames:[($filename)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}