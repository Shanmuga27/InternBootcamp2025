{
	"name": "DF_STG_DW_Locations_IN1675",
	"properties": {
		"folder": {
			"name": "Workshop_IN1675/STG_DW_IN1675"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "SrcLocations"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "TgtLocations"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "Transformations1"
				},
				{
					"name": "Transformations2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Location_ID as integer,",
				"          Location_Name as string,",
				"          Location_Country as string,",
				"          Location_City as string,",
				"          Location_State as string,",
				"          Location_Zipcode as string,",
				"          Location_Key as integer,",
				"          Delete_Flg as string,",
				"          Active_Flg as string,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcLocations",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TgtLocations",
				"SrcLocations derive(Location_Zipcode = regexReplace(Location_Zipcode, '[^0-9]', '')) ~> Transformations1",
				"Transformations1 derive(Location_Zipcode = iif(length(regexReplace(Location_Zipcode,'[^0-9]','')) > 6,     substring(regexReplace(Location_Zipcode,'[^0-9]',''),0,6),     right(concat(regexReplace(Location_Zipcode,'[^0-9]',''),'000000'),6) )) ~> Transformations2"
			]
		}
	}
}