{
	"name": "LocationsSCD2",
	"properties": {
		"folder": {
			"name": "stg_to_dw"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "source2"
				},
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "source3"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "split1"
				},
				{
					"name": "select2"
				},
				{
					"name": "join2"
				},
				{
					"name": "split2"
				},
				{
					"name": "select3"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select4"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "alterRow2"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename as string",
				"}",
				"source(output(",
				"          Location_Id as string,",
				"          Name as string,",
				"          City as string,",
				"          Country as string,",
				"          State as string,",
				"          Zipcode as string,",
				"          Location_key as short,",
				"          Delete_Flg as boolean,",
				"          Active_Flag as boolean,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          Location_key as string,",
				"          Location_ID as string,",
				"          Location_Name as string,",
				"          Location_Country as string,",
				"          Location_City as string,",
				"          Location_State as string,",
				"          Location_Zipcode as string,",
				"          Create_Date as string,",
				"          Date_Last_Modified as string,",
				"          Delete_Flg as string,",
				"          Created_By as string,",
				"          Created_Timestamp as string,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"source(output(",
				"          Location_Id as string,",
				"          Name as string,",
				"          City as string,",
				"          Country as string,",
				"          State as string,",
				"          Zipcode as string,",
				"          Location_key as short,",
				"          Delete_Flg as boolean,",
				"          Active_Flag as boolean,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Modified_Date as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source3",
				"select1, source2 join(select1@Location_Id == select1@Location_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"source1 select(mapColumn(",
				"          Location_Id,",
				"          Name,",
				"          City,",
				"          Country,",
				"          State,",
				"          Zipcode,",
				"          Location_key,",
				"          Delete_Flg,",
				"          Active_Flag,",
				"          Date_Last_Modified,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"join1 split(isNull(select1@Location_Id) || !isNull(select1@Location_Id) && (Location_Country!=Location_Country || Location_City!=Location_City) ,",
				"     disjoint: false) ~> split1@(insert)",
				"source3 select(mapColumn(",
				"          Location_Id,",
				"          Name,",
				"          City,",
				"          Country,",
				"          State,",
				"          Zipcode,",
				"          Location_key,",
				"          Delete_Flg,",
				"          Active_Flag,",
				"          Date_Last_Modified,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp,",
				"          Last_Modified_Time,",
				"          Last_Modified_Date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2, source2 join(select2@Location_Id == source2@Location_ID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2 split(!isNull(select2@Location_Id) && (Location_Country!=Location_Country || Location_City!=Location_City),",
				"     disjoint: false) ~> split2@(updateOldRecord)",
				"split1@insert select(mapColumn(",
				"          Location_Id,",
				"          Name,",
				"          City,",
				"          Country,",
				"          State,",
				"          Zipcode,",
				"          Location_key = split1@Location_key,",
				"          Delete_Flg = split1@Delete_Flg,",
				"          Active_Flag,",
				"          Date_Last_Modified = split1@Date_Last_Modified,",
				"          Created_By = split1@Created_By,",
				"          Created_Timestamp = split1@Created_Timestamp,",
				"          Last_Updated_By = split1@Last_Updated_By,",
				"          Last_Update_Timestamp = split1@Last_Update_Timestamp,",
				"          Location_key = split1@Location_key,",
				"          Location_ID,",
				"          Location_Name,",
				"          Location_Country,",
				"          Location_City,",
				"          Location_State,",
				"          Location_Zipcode,",
				"          Create_Date,",
				"          Date_Last_Modified = split1@Date_Last_Modified,",
				"          Delete_Flg = split1@Delete_Flg,",
				"          Created_By = split1@Created_By,",
				"          Created_Timestamp = split1@Created_Timestamp,",
				"          Last_Updated_By = split1@Last_Updated_By,",
				"          Last_Update_Timestamp = split1@Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3 derive(effective_start_date = currentTimestamp(),",
				"          isCurrent = 'Y',",
				"          each(match(type=='integer'), $$ = iifNull($$, 0))) ~> derivedColumn1",
				"split2@updateOldRecord select(mapColumn(",
				"          Location_Id = split2@Location_Id,",
				"          Name,",
				"          City,",
				"          Country,",
				"          State,",
				"          Zipcode,",
				"          Location_key = split2@Location_key,",
				"          Delete_Flg = split2@Delete_Flg,",
				"          Active_Flag,",
				"          Date_Last_Modified = split2@Date_Last_Modified,",
				"          Created_By = split2@Created_By,",
				"          Created_Timestamp = split2@Created_Timestamp,",
				"          Last_Updated_By = split2@Last_Updated_By,",
				"          Last_Update_Timestamp = split2@Last_Update_Timestamp,",
				"          Last_Modified_Time,",
				"          Last_Modified_Date,",
				"          Location_key = split2@Location_key,",
				"          Location_ID = split2@Location_ID,",
				"          Location_Name,",
				"          Location_Country,",
				"          Location_City,",
				"          Location_State,",
				"          Location_Zipcode,",
				"          Create_Date,",
				"          Date_Last_Modified = split2@Date_Last_Modified,",
				"          Delete_Flg = split2@Delete_Flg,",
				"          Created_By = split2@Created_By,",
				"          Created_Timestamp = split2@Created_Timestamp,",
				"          Last_Updated_By = split2@Last_Updated_By,",
				"          Last_Update_Timestamp = split2@Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4 derive(effective_end_date = currentTimestamp(),",
				"          isCurrent = 'N') ~> derivedColumn2",
				"derivedColumn1 alterRow(insertIf(true())) ~> alterRow1",
				"derivedColumn2 alterRow(updateIf(true())) ~> alterRow2",
				"alterRow1, alterRow2 union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:[($filename)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}