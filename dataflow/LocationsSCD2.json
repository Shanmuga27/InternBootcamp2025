{
	"name": "LocationsSCD2",
	"properties": {
		"folder": {
			"name": "stg_to_dw"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "srcLOC"
				},
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "tgtLOC"
				}
			],
			"sinks": [
				{
					"name": "sink1"
				},
				{
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "leftjoin"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "alterRowInsert"
				},
				{
					"name": "alterRowUpdate"
				},
				{
					"name": "selectTGT"
				},
				{
					"name": "selectSRCcolumns"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Location_Id as short,",
				"          Name as string,",
				"          City as string,",
				"          Country as string,",
				"          State as string,",
				"          Zipcode as string,",
				"          Location_key as short,",
				"          Delete_Flg as boolean,",
				"          Active_Flag as boolean,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Modified_Date as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcLOC",
				"source(output(",
				"          Location_key as string,",
				"          Location_ID as string,",
				"          Location_Name as string,",
				"          Location_Country as string,",
				"          Location_City as string,",
				"          Location_State as string,",
				"          Location_Zipcode as string,",
				"          Create_Date as string,",
				"          Date_Last_Modified as string,",
				"          Delete_Flg as string,",
				"          Created_By as string,",
				"          Created_Timestamp as string,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> tgtLOC",
				"derivedColumn2, selectTGT join(srcLOC@Location_Id == T_Location_ID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> leftjoin",
				"leftjoin split(isNull(T_Location_ID) || (srcLOC@Location_Id == T_Location_ID || Location_City != T_Location_City || Location_Country != T_Location_Country),",
				"     (srcLOC@Location_Id == T_Location_ID || Location_City != T_Location_City ||Location_Country != T_Location_Country),",
				"     disjoint: true) ~> split1@(InsertStream, UpdateStream)",
				"split1@UpdateStream derive(Last_Modified_Date = currentTimestamp(),",
				"          Last_Modified_Time = currentTimestamp(),",
				"          Delete_Flag = 'Y',",
				"          Active_Flag = 'N') ~> derivedColumn1",
				"srcLOC derive(Location_Zipcode = iif(length(Location_Zipcode)==6, Location_Zipcode, iif(length(Location_Zipcode)>6, rtrim(Location_Zipcode), lpad(Location_Zipcode,6,'0')))) ~> derivedColumn2",
				"split1@InsertStream alterRow(insertIf(true())) ~> alterRowInsert",
				"derivedColumn1 alterRow(updateIf(true())) ~> alterRowUpdate",
				"tgtLOC select(mapColumn(",
				"          Location_key,",
				"          Location_ID,",
				"          Location_Name,",
				"          Location_Country,",
				"          Location_City,",
				"          Location_State,",
				"          Location_Zipcode,",
				"          Create_Date,",
				"          Date_Last_Modified,",
				"          Delete_Flg,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectTGT",
				"alterRowInsert select(mapColumn(",
				"          Location_Id,",
				"          Location_Name,",
				"          Location_Key,",
				"          Location_City,",
				"          Location_Country,",
				"          Location_State,",
				"          Location_Zipcode,",
				"          Delete_Flag,",
				"          Create_Date,",
				"          Date_Last_Modified,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp,",
				"          Active_Flag,",
				"          T_Location_ID,",
				"          T_Location_Name,",
				"          T_Location_Key,",
				"          T_Location_City,",
				"          T_Location_Country,",
				"          T_Location_State,",
				"          T_Location_Zipcode,",
				"          T_Delete_Flag,",
				"          T_Create_Date,",
				"          T_Date_Last_Modified,",
				"          T_Created_By,",
				"          T_Created_Timestamp,",
				"          T_Last_Updated_By,",
				"          T_Last_Update_Timestamp,",
				"          T_Active_Flag",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectSRCcolumns",
				"alterRowUpdate select(mapColumn(",
				"          Location_Id,",
				"          Location_Name,",
				"          Location_Key,",
				"          Location_City,",
				"          Location_Country,",
				"          Location_State,",
				"          Location_Zipcode,",
				"          Delete_Flag,",
				"          Create_Date,",
				"          Date_Last_Modified,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp,",
				"          Active_Flag,",
				"          T_Location_ID,",
				"          T_Location_Name,",
				"          T_Location_Key,",
				"          T_Location_City,",
				"          T_Location_Country,",
				"          T_Location_State,",
				"          T_Location_Zipcode,",
				"          T_Delete_Flag,",
				"          T_Create_Date,",
				"          T_Date_Last_Modified,",
				"          T_Created_By,",
				"          T_Created_Timestamp,",
				"          T_Last_Updated_By,",
				"          T_Last_Update_Timestamp,",
				"          T_Active_Flag,",
				"          Last_Modified_Date,",
				"          Last_Modified_Time",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"selectSRCcolumns sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['I_Locations_TGT_IN1686.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['U_Locations_TGT_IN1686.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink2"
			]
		}
	}
}