{
	"name": "LocationsSCD2",
	"properties": {
		"folder": {
			"name": "Workshop_answers/stg_to_dw"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "srcLOC"
				},
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "tgtLOC"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ds_blob_IN1674",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "leftjoin"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "alterRowInsert"
				},
				{
					"name": "alterRowUpdate"
				},
				{
					"name": "selectTGT"
				},
				{
					"name": "selectSRCcolumns"
				},
				{
					"name": "select1"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Location_Id as string,",
				"          Name as string,",
				"          City as string,",
				"          Country as string,",
				"          State as string,",
				"          Zipcode as string,",
				"          Location_key as short,",
				"          Delete_Flg as string,",
				"          Active_Flag as string,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Modified_Date as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcLOC",
				"source(output(",
				"          Location_key as string,",
				"          Location_ID as string,",
				"          Location_Name as string,",
				"          Location_Country as string,",
				"          Location_City as string,",
				"          Location_State as string,",
				"          Location_Zipcode as string,",
				"          Create_Date as string,",
				"          Date_Last_Modified as string,",
				"          Delete_Flg as string,",
				"          Created_By as string,",
				"          Created_Timestamp as string,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> tgtLOC",
				"derivedColumn2, selectTGT join(srcLOC@Location_Id == selectTGT@Location_ID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> leftjoin",
				"leftjoin split(isNull(srcLOC@Location_Id) || (srcLOC@Location_Id == selectTGT@Location_ID || Location_City != selectTGT@Location_ID || Location_Country != selectTGT@Location_ID),",
				"     (srcLOC@Location_Id == selectTGT@Location_ID || Location_City != Location_City ||Location_Country != Location_Country),",
				"     disjoint: true) ~> split1@(InsertStream, UpdateStream)",
				"split1@UpdateStream derive(Last_Modified_Date = currentTimestamp(),",
				"          Last_Modified_Time = currentTimestamp(),",
				"          Delete_Flag = 'Y',",
				"          Active_Flag = 'N') ~> derivedColumn1",
				"srcLOC derive(Location_Zipcode = iif(length(Zipcode)==6, Zipcode, iif(length(Zipcode)>6, rtrim(Zipcode), lpad(Zipcode,6,'0')))) ~> derivedColumn2",
				"split1@InsertStream alterRow(insertIf(true())) ~> alterRowInsert",
				"derivedColumn1 alterRow(updateIf(true())) ~> alterRowUpdate",
				"tgtLOC select(mapColumn(",
				"          Location_key,",
				"          Location_ID,",
				"          Location_Name,",
				"          Location_Country,",
				"          Location_City,",
				"          Location_State,",
				"          Location_Zipcode,",
				"          Create_Date,",
				"          Date_Last_Modified,",
				"          Delete_Flg,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectTGT",
				"alterRowInsert select(mapColumn(",
				"          Location_Id = split1@InsertStream@Location_Id,",
				"          Name,",
				"          City,",
				"          Country,",
				"          State,",
				"          Zipcode,",
				"          Location_key = split1@InsertStream@Location_key,",
				"          Delete_Flg = split1@InsertStream@Delete_Flg,",
				"          Active_Flag,",
				"          Date_Last_Modified = split1@InsertStream@Date_Last_Modified,",
				"          Created_By = split1@InsertStream@Created_By,",
				"          Created_Timestamp = split1@InsertStream@Created_Timestamp,",
				"          Last_Updated_By = split1@InsertStream@Last_Updated_By,",
				"          Last_Update_Timestamp = split1@InsertStream@Last_Update_Timestamp,",
				"          Last_Modified_Time,",
				"          Last_Modified_Date,",
				"          Location_Zipcode = split1@InsertStream@Location_Zipcode,",
				"          Location_key = split1@InsertStream@Location_key,",
				"          Location_ID = split1@InsertStream@Location_ID,",
				"          Location_Name,",
				"          Location_Country,",
				"          Location_City,",
				"          Location_State,",
				"          Location_Zipcode = split1@InsertStream@Location_Zipcode,",
				"          Create_Date,",
				"          Date_Last_Modified = split1@InsertStream@Date_Last_Modified,",
				"          Delete_Flg = split1@InsertStream@Delete_Flg,",
				"          Created_By = split1@InsertStream@Created_By,",
				"          Created_Timestamp = split1@InsertStream@Created_Timestamp,",
				"          Last_Updated_By = split1@InsertStream@Last_Updated_By,",
				"          Last_Update_Timestamp = split1@InsertStream@Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectSRCcolumns",
				"alterRowUpdate select(mapColumn(",
				"          Location_Id = split1@UpdateStream@Location_Id,",
				"          Name,",
				"          City,",
				"          Country,",
				"          State,",
				"          Zipcode,",
				"          Location_key = split1@UpdateStream@Location_key,",
				"          Delete_Flg = split1@UpdateStream@Delete_Flg,",
				"          Active_Flag,",
				"          Date_Last_Modified = split1@UpdateStream@Date_Last_Modified,",
				"          Created_By = split1@UpdateStream@Created_By,",
				"          Created_Timestamp = split1@UpdateStream@Created_Timestamp,",
				"          Last_Updated_By = split1@UpdateStream@Last_Updated_By,",
				"          Last_Update_Timestamp = split1@UpdateStream@Last_Update_Timestamp,",
				"          Last_Modified_Time,",
				"          Last_Modified_Date,",
				"          Location_Zipcode = split1@UpdateStream@Location_Zipcode,",
				"          Location_key = split1@UpdateStream@Location_key,",
				"          Location_ID = split1@UpdateStream@Location_ID,",
				"          Location_Name,",
				"          Location_Country,",
				"          Location_City,",
				"          Location_State,",
				"          Location_Zipcode = split1@UpdateStream@Location_Zipcode,",
				"          Create_Date,",
				"          Date_Last_Modified = split1@UpdateStream@Date_Last_Modified,",
				"          Delete_Flg = split1@UpdateStream@Delete_Flg,",
				"          Created_By = split1@UpdateStream@Created_By,",
				"          Created_Timestamp = split1@UpdateStream@Created_Timestamp,",
				"          Last_Updated_By = split1@UpdateStream@Last_Updated_By,",
				"          Last_Update_Timestamp = split1@UpdateStream@Last_Update_Timestamp,",
				"          Delete_Flag",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"selectSRCcolumns, select1 union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['I_Locations_TGT_IN1686.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}