				"          Sales_Rep_Id as short,",
				"          Sales_Rep_Name as string,",
				"          LoginAccess as boolean,",
				"          Email as string,",
				"          Phone as string,",
				"          Address as string,",
				"          City as string,",
				"          Country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Sales",
				"Customers select(mapColumn(",
				"          Customer_Id,",
				"          Company_Name",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 keyGenerate(output(Customer_Key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1 derive(Delete_Flag = \"N\",",
				"          Create_Date = currentTimestamp(),",
				"          Date_Last_Modified = currentTimestamp(),",
				"          {Created_By } = \"IN1674\",",
				"          Created_Timestamp = currentTimestamp(),",
				"          Last_Updated_By = \"IN1674\",",
				"          Last_Update_Timestamp = currentTimestamp(),",
				"          Active_Flag = \"Y\") ~> derivedColumn1",
				"Estimate select(mapColumn(",
				"          Transaction_Id,",
				"          Transaction_Line_Id,",
				"          Memo,",
				"          Sticker_Requirements,",
				"          Inner_Requirements,",
				"          Customer_Requirements,",
				"          Sales_Program,",
				"          Buyer_Dept,",
				"          Buyer_Confirmed_On,",
				"          Dept_Program,",
				"          Program_0,",
				"          Cancelled,",
				"          Confidence_Factor_Id,",
				"          Company_Id,",
				"          Item_Id,",
				"          Location_Id,",
				"          Sales_Rep_Id,",
				"          TranId,",
				"          Price_Sticker_Id,",
				"          Po,",
				"          Release_Order_Number,",
				"          Cntnr_,",
				"          Etd_Ship_Date,",
				"          Ship_Date_Outbound,",
				"          Cancel_Date_Outbound,",
				"          Expiration_Date,",
				"          Item_Count,",
				"          Inner_Qty,",
				"          Release_Quantity,",
				"          Quantity_Received_In_Shipment,",
				"          Item_Unit_Price,",
				"          Amount,",
				"          Eta_Arrival_Date,",
