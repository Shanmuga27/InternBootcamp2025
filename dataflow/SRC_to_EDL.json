				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey3",
				"surrogateKey3 derive(Delete_Flg = \"N\",",
				"          Active_Flag = \"Y\",",
				"          Date_Last_Modified = currentTimestamp(),",
				"          Created_By = \"IN1674\",",
				"          Created_Timestamp = currentTimestamp(),",
				"          Last_Updated_By = \"IN1674\",",
				"          Last_Update_Timestamp = currentTimestamp()) ~> derivedColumn3",
				"Product select(mapColumn(",
				"          Item_Id,",
				"          Generic_Description,",
				"          PurchaseDescription,",
				"          Artwork,",
				"          Color,",
				"          Package_Type,",
				"          Special_Requirements,",
				"          Case_Pack,",
				"          Full_Name,",
				"          Display_Name,",
				"          Account_Manager_Name,",
				"          Brand_Name,",
				"          Brand_Manager_Name,",
				"          Item_Status,",
				"          Item_Type,",
				"          Maker_Name,",
				"          Product_Manager_Name,",
				"          Master_Carton_Rqmnts,",
				"          Trade_Partner_Name,",
				"          Part_Of_Assembly_Item,",
				"          Type_Name,",
				"          Trade_Partner_Code,",
				"          VendorName,",
				"          UPC,",
				"          QunatityOnHand,",
				"          SSCC14,",
				"          Master_Carton_Markings_Item_N",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4 keyGenerate(output(Item_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey4",
				"surrogateKey4 derive(Delete_flg = \"N\",",
				"          Active_Flag = \"Y\",",
				"          Create_Date = currentTimestamp(),",
				"          Date_last_modified = currentTimestamp(),",
				"          Created_By = \"IN1674\",",
				"          Created_Timestamp = currentTimestamp(),",
				"          Last_Updated_By = \"IN1674\",",
				"          Last_Update_Timestamp = currentTimestamp()) ~> derivedColumn4",
