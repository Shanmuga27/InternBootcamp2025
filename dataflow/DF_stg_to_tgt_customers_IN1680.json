{
	"name": "DF_stg_to_tgt_customers_IN1680",
	"properties": {
		"folder": {
			"name": "DFmock_stg_tgt"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "SRCcust"
				},
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "SRCtgtcust"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference"
					},
					"name": "SNKcust"
				}
			],
			"transformations": [
				{
					"name": "surrogatecustomer"
				},
				{
					"name": "derivedName"
				},
				{
					"name": "SLCTrenamecols"
				},
				{
					"name": "joincustomerSrcAndTgt"
				},
				{
					"name": "derivedInsert"
				},
				{
					"name": "selectSrc"
				},
				{
					"name": "split1"
				},
				{
					"name": "joinsSRCforupdate"
				},
				{
					"name": "derivedNewINsert"
				},
				{
					"name": "split2"
				},
				{
					"name": "selectUpdate"
				},
				{
					"name": "alterRowInsert"
				},
				{
					"name": "alterRowUpdate"
				},
				{
					"name": "unionAll"
				}
			],
			"scriptLines": [
				"parameters{",
				"     filename as string",
				"}",
				"source(output(",
				"          CustomerID as integer,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Email as string,",
				"          Country as string,",
				"          {created date} as timestamp,",
				"          {created by } as string,",
				"          {updated date} as timestamp,",
				"          {updated by} as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCcust",
				"source(output(",
				"          customer_id as integer,",
				"          customer_key as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          customer_name as string,",
				"          email as string,",
				"          country as string,",
				"          isActive as string,",
				"          start_date as timestamp,",
				"          end_date as timestamp,",
				"          created_date as timestamp,",
				"          created_by as string,",
				"          updated_date as timestamp,",
				"          updated_by as string,",
				"          runid as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SRCtgtcust",
				"SRCcust keyGenerate(output(customer_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogatecustomer",
				"surrogatecustomer derive(customer_name = concat(FirstName, LastName)) ~> derivedName",
				"SRCtgtcust select(mapColumn(",
				"          tgt_customer_id = customer_id,",
				"          tgt_customer_key = customer_key,",
				"          tgt_first_name = first_name,",
				"          tgt_last_name = last_name,",
				"          tgt_customer_name = customer_name,",
				"          tgt_email = email,",
				"          tgt_country = country,",
				"          tgt_isActive = isActive,",
				"          tgt_start_date = start_date,",
				"          tgt_end_date = end_date,",
				"          tgt_created_date = created_date,",
				"          tgt_created_by = created_by,",
				"          tgt_updated_date = updated_date,",
				"          tgt_updated_by = updated_by,",
				"          tgt_runid = runid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SLCTrenamecols",
				"derivedName, SLCTrenamecols join(CustomerID == tgt_customer_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joincustomerSrcAndTgt",
				"split1@insert derive(start_date = currentTimestamp(),",
				"          isActive = 'Y') ~> derivedInsert",
				"derivedInsert select(mapColumn(",
				"          CustomerID,",
				"          FirstName,",
				"          LastName,",
				"          Email,",
				"          Country,",
				"          {created date},",
				"          {created by },",
				"          {updated date},",
				"          {updated by},",
				"          runid,",
				"          customer_key,",
				"          customer_name,",
				"          start_date,",
				"          isActive",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectSrc",
				"joincustomerSrcAndTgt split(isNull(tgt_customer_id) || !isNull(tgt_customer_id) && (Country!=tgt_country && tgt_isActive=='Y'),",
				"     disjoint: false) ~> split1@(insert)",
				"SLCTrenamecols, SRCcust join(tgt_customer_id == CustomerID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinsSRCforupdate",
				"split2@update derive(isActive = 'N',",
				"          end_date = currentTimestamp()) ~> derivedNewINsert",
				"joinsSRCforupdate split(!isNull(tgt_customer_id) && (Country!=tgt_country && tgt_isActive=='Y'),",
				"     disjoint: false) ~> split2@(update)",
				"derivedNewINsert select(mapColumn(",
				"          customer_id = tgt_customer_id,",
				"          customer_key = tgt_customer_key,",
				"          first_name = tgt_first_name,",
				"          last_name = tgt_last_name,",
				"          customer_name = tgt_customer_name,",
				"          email = tgt_email,",
				"          start_date = tgt_start_date,",
				"          created_date = tgt_created_date,",
				"          created_by = tgt_created_by,",
				"          updated_date = tgt_updated_date,",
				"          updated_by = tgt_updated_by,",
				"          runid = tgt_runid,",
				"          isActive,",
				"          end_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectUpdate",
				"selectSrc alterRow(insertIf(true())) ~> alterRowInsert",
				"selectUpdate alterRow(updateIf(true())) ~> alterRowUpdate",
				"alterRowInsert, alterRowUpdate union(byName: true)~> unionAll",
				"unionAll sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          anime_id as string,",
				"          name as string,",
				"          genre as string,",
				"          type as string,",
				"          episodes as string,",
				"          rating as string,",
				"          members as string",
				"     ),",
				"     partitionFileNames:[($filename)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SNKcust"
			]
		}
	}
}