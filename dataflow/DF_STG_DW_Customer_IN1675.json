{
	"name": "DF_STG_DW_Customer_IN1675",
	"properties": {
		"folder": {
			"name": "Workshop_IN1675/STG_DW_IN1675"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "SrcCustomer"
				},
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "tgtCustomer"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference"
					},
					"name": "DWCustomer"
				}
			],
			"transformations": [
				{
					"name": "Transformation"
				},
				{
					"name": "leftjoin"
				},
				{
					"name": "select1"
				},
				{
					"name": "split1"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Customer_Key as integer,",
				"          Customer_Id as integer,",
				"          Company_Name as string,",
				"          Delete_Flag as integer,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          Active_Flag as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcCustomer",
				"source(output(",
				"          Customer_Key as integer,",
				"          Customer_Id as integer,",
				"          Company_Name as string,",
				"          Created_Date as timestamp,",
				"          Last_Modified_Date as timestamp,",
				"          Delete_Flag as string,",
				"          Active_Flag as string,",
				"          Created_Time as timestamp,",
				"          Created_By as string,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Updated_By as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> tgtCustomer",
				"select2 derive(Company_Name = initCap(Company_Name),",
				"          Delete_Flag = 'N') ~> Transformation",
				"Transformation, tgtCustomer join(select2@Customer_Key == tgtCustomer@Customer_Key,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> leftjoin",
				"split1@Insert select(mapColumn(",
				"          Customer_Key = split1@Insert@Customer_Key,",
				"          Customer_Id = split1@Insert@Customer_Id,",
				"          Company_Name = split1@Insert@Company_Name,",
				"          Delete_Flag = split1@Insert@Delete_Flag,",
				"          Create_Date,",
				"          Date_Last_Modified,",
				"          Created_By = split1@Insert@Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By = split1@Insert@Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"leftjoin split(isNull(tgtCustomer@Customer_Key),",
				"     !isNull(tgtCustomer@Customer_Key)&& Transformation@Company_Name!=tgtCustomer@Company_Name,",
				"     disjoint: false) ~> split1@(Insert, Update)",
				"SrcCustomer select(mapColumn(",
				"          Customer_Key,",
				"          Customer_Id,",
				"          Company_Name,",
				"          Delete_Flag,",
				"          Create_Date,",
				"          Date_Last_Modified,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"split1@Update select(mapColumn(",
				"          Customer_Key = split1@Update@Customer_Key,",
				"          Customer_Id = split1@Update@Customer_Id,",
				"          Company_Name = split1@Update@Company_Name,",
				"          Delete_Flag = split1@Update@Delete_Flag,",
				"          Create_Date,",
				"          Date_Last_Modified,",
				"          Created_By = split1@Update@Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By = split1@Update@Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1, select3 union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['DW_Customer.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> DWCustomer"
			]
		}
	}
}