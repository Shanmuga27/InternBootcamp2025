{
	"name": "SCD1_CUSTOMERS",
	"properties": {
		"folder": {
			"name": "STG_To_DW"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"name": "STGCustomer"
				},
				{
					"name": "DimCustomer"
				}
			],
			"sinks": [
				{
					"name": "TGTCustomer"
				},
				{
					"name": "TGTCustomerUpdate"
				}
			],
			"transformations": [
				{
					"name": "join"
				},
				{
					"name": "split1"
				},
				{
					"name": "select1"
				},
				{
					"name": "insertif"
				},
				{
					"name": "updateif"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Customer_Id as integer,",
				"          Customer_key as integer,",
				"          Company_Name as string,",
				"          Delete_Flg as string,",
				"          Create_Date as timestamp,",
				"          Date_Last_Modified as timestamp,",
				"          Created_By as string,",
				"          Created_Timestamp as timestamp,",
				"          Last_Updated_By as string,",
				"          Last_Update_Timestamp as timestamp,",
				"          Active_Flag as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false) ~> STGCustomer",
				"source(output(",
				"          Customer_Key as integer,",
				"          Customer_Id as integer,",
				"          Company_Name as string,",
				"          Created_Date as timestamp,",
				"          Last_Modified_Date as timestamp,",
				"          Delete_Flag as string,",
				"          Created_Time as timestamp,",
				"          Created_By as string,",
				"          Last_Modified_Time as timestamp,",
				"          Last_Updated_By as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false) ~> DimCustomer",
				"select1, DimCustomer join(select1@Customer_Id == DimCustomer@Customer_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join",
				"join split(isNull(DimCustomer@Customer_Id),",
				"     select1@Customer_Id==DimCustomer@Customer_Id && (select1@Company_Name != DimCustomer@Company_Name),",
				"     disjoint: true) ~> split1@(Insert, Update)",
				"STGCustomer select(mapColumn(",
				"          Customer_Id,",
				"          Customer_key,",
				"          Company_Name,",
				"          Delete_Flg,",
				"          Create_Date,",
				"          Date_Last_Modified,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"split1@Insert alterRow(insertIf(true())) ~> insertif",
				"split1@Update alterRow(updateIf(true())) ~> updateif",
				"insertif select(mapColumn(",
				"          Customer_Id = split1@Insert@Customer_Id,",
				"          Customer_key = split1@Insert@Customer_key,",
				"          Company_Name = split1@Insert@Company_Name,",
				"          Delete_Flg,",
				"          Create_Date,",
				"          Date_Last_Modified,",
				"          Created_By = split1@Insert@Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By = split1@Insert@Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> select2",
				"updateif select(mapColumn(",
				"          Customer_Id = split1@Update@Customer_Id,",
				"          Customer_key = split1@Update@Customer_key,",
				"          Company_Name = split1@Update@Company_Name,",
				"          Delete_Flg,",
				"          Create_Date,",
				"          Date_Last_Modified,",
				"          Created_By = split1@Update@Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By = split1@Update@Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> select3",
				"select2 derive(Create_Date = toTimestamp(currentDate()),",
				"          Created_By = \"IN1689\",",
				"          Created_Timestamp = currentTimestamp(),",
				"          Company_Name = initCap(Company_Name)) ~> derivedColumn1",
				"select3 derive(Date_Last_Modified = toTimestamp(currentDate()),",
				"          Last_Updated_By = \"IN1689\",",
				"          Last_Update_Timestamp = currentTimestamp(),",
				"          Company_Name = initCap(Company_Name)) ~> derivedColumn2",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Dim_Customer'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          Customer_key,",
				"          Customer_Id,",
				"          Company_Name,",
				"          Create_Date,",
				"          Date_Last_Modified,",
				"          Delete_Flg,",
				"          Created_By,",
				"          Created_Timestamp,",
				"          Last_Updated_By,",
				"          Last_Update_Timestamp",
				"     ),",
				"     partitionBy('hash', 1)) ~> TGTCustomer",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Dim_Customer2'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> TGTCustomerUpdate"
			]
		}
	}
}