			"referenceName": "LS_Azure_Blob_Storage",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"FolderName": {
				"type": "string"
			},
			"FileName": {
				"type": "string"
			},
			"SheetNo": {
				"type": "int"
			}
		},
		"annotations": [],
		"type": "Excel",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "@dataset().FileName",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().FolderName",
					"type": "Expression"
				},
				"container": "boootcamp25"
			},
			"sheetIndex": {
				"value": "@dataset().SheetNo",
				"type": "Expression"
			},
			"firstRowAsHeader": true
		},
		"schema": []
	}
