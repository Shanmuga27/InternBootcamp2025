{
	"name": "PS_Session_prac",
	"properties": {
		"activities": [
			{
				"name": "Copy_from_src_to_des",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "select * from transactions\nwhere order_date >= (select JOB_START_DATETIME from LOAD_CONTROL where  JOB_ID = 101)",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_OnPremSQL_IN1675",
						"type": "DatasetReference",
						"parameters": {
							"TableName": "transactions",
							"SchemaName": "DMuthuku"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference",
						"parameters": {
							"ContainerName": "boootcamp25",
							"FolderName": "IN1675",
							"FileName": "test.csv"
						}
					}
				]
			}
		],
		"annotations": []
	}
}