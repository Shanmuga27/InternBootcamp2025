{
	"name": "PL_DAY5_EX2",
	"properties": {
		"activities": [
			{
				"name": "CP_Blob_Server",
				"type": "Copy",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Data flow",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "SqlServerSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"tableOption": "autoCreate"
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference",
						"parameters": {
							"PR_Directory": "IN1684/Day 4",
							"PR_Filename": "AllOrders_Unioned_IN1684.csv"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_SQL_Server_IN1684",
						"type": "DatasetReference",
						"parameters": {
							"PR_Tablename": "AllOrders_Unioned_IN1684",
							"PR_Schema": "PMahendi",
							"PR_Database": "ADF_Training"
						}
					}
				]
			},
			{
				"name": "Data flow",
				"type": "ExecuteDataFlow",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "DF_Orders",
						"type": "DataFlowReference",
						"datasetParameters": {
							"Orders": {
								"PR_Directory": "Exercise 4 src files",
								"PR_Filename": "Orders.csv"
							},
							"sink": {
								"PR_Directory": "IN1684/Day 4",
								"PR_Filename": "AllOrders_Unioned_IN1684.csv"
							}
						}
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "DF_Regions",
				"type": "ExecuteDataFlow",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "DF_Region",
						"type": "DataFlowReference",
						"parameters": {
							"PR_Region": {
								"value": "@pipeline().globalParameters.Region",
								"type": "Expression"
							}
						},
						"datasetParameters": {
							"Customers": {
								"PR_Directory": "Exercise 4 src files",
								"PR_Filename": "Customers.csv"
							},
							"Orders": {
								"PR_Directory": "Exercise 4 src files",
								"PR_Filename": "Orders.csv"
							},
							"tgtAPAC": {
								"PR_Directory": "IN1684/regions",
								"PR_Filename": "Orders_APAC"
							},
							"tgtEMEA": {
								"PR_Directory": "IN1684/regions",
								"PR_Filename": "Orders_EMEA"
							},
							"tgtAMER": {
								"PR_Directory": "IN1684/regions",
								"PR_Filename": "Customers_AMER"
							}
						}
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "Retrive regions files",
				"type": "GetMetadata",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "DF_Regions",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference",
						"parameters": {
							"PR_Directory": "IN1684/regions",
							"PR_Filename": "*"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Load tables sequentially",
				"type": "ForEach",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Retrive regions files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Retrive regions files').output.childItems",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "CP_Blob_SQLServer",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobStorageReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "SqlServerSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false,
									"tableOption": "autoCreate"
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_Blob_IN1684",
									"type": "DatasetReference",
									"parameters": {
										"PR_Directory": "IN1684/regions",
										"PR_Filename": {
											"value": "@item().Name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_SQL_Server_IN1684",
									"type": "DatasetReference",
									"parameters": {
										"PR_Tablename": {
											"value": "@item().Name",
											"type": "Expression"
										},
										"PR_Schema": "PMahendi",
										"PR_Database": "ADF_Training"
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "Lookup_ETL_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "select * from ETL_Config",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_Server_IN1684",
						"type": "DatasetReference",
						"parameters": {
							"PR_Tablename": "ETL_Config",
							"PR_Schema": "PMahendi",
							"PR_Database": "ADF_Training"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Loop through ETL_Config",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_ETL_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_ETL_Config').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Condition",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(item().LoadType,'Full')",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Lookup_Incremental",
										"type": "Lookup",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "SqlServerSource",
												"sqlReaderQuery": {
													"value": "@concat('select isnull(max(',item().KeyColumn,'),0) as k from ', item().TargetTable)",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"dataset": {
												"referenceName": "DS_SQL_Server_IN1684",
												"type": "DatasetReference",
												"parameters": {
													"PR_Tablename": {
														"value": "@item().SourceTable",
														"type": "Expression"
													},
													"PR_Schema": "PMahendi",
													"PR_Database": "ADF_Training"
												}
											},
											"firstRowOnly": false
										}
									},
									{
										"name": "Incremental Load",
										"type": "Copy",
										"dependsOn": [
											{
												"activity": "Lookup_Incremental",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "SqlServerSource",
												"additionalColumns": [
													{
														"name": "LastModified",
														"value": {
															"value": "@utcNow()",
															"type": "Expression"
														}
													}
												],
												"sqlReaderQuery": {
													"value": "@concat('select * from ', item().SourceTable,\n     ' where ', item().KeyColumn, ' > ''', activity('Lookup_Incremental').output.value[0].k, '''')\n ",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"sink": {
												"type": "SqlServerSink",
												"writeBehavior": "insert",
												"sqlWriterUseTableLock": false
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "DS_SQL_Server_IN1684",
												"type": "DatasetReference",
												"parameters": {
													"PR_Tablename": {
														"value": "@item().SourceTable",
														"type": "Expression"
													},
													"PR_Schema": "PMahendi",
													"PR_Database": "ADF_Training"
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_SQL_Server_IN1684",
												"type": "DatasetReference",
												"parameters": {
													"PR_Tablename": {
														"value": "@item().TargetTable",
														"type": "Expression"
													},
													"PR_Schema": "PMahendi",
													"PR_Database": "ADF_Training"
												}
											}
										]
									}
								],
								"ifTrueActivities": [
									{
										"name": "Full Load",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "SqlServerSource",
												"additionalColumns": [
													{
														"name": "LastModified",
														"value": {
															"value": "@utcNow()",
															"type": "Expression"
														}
													}
												],
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"sink": {
												"type": "SqlServerSink",
												"preCopyScript": {
													"value": "@{concat('TRUNCATE TABLE ',item().TargetTable)}",
													"type": "Expression"
												},
												"writeBehavior": "insert",
												"sqlWriterUseTableLock": false
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "DS_SQL_Server_IN1684",
												"type": "DatasetReference",
												"parameters": {
													"PR_Tablename": {
														"value": "@item().SourceTable\r\n",
														"type": "Expression"
													},
													"PR_Schema": "PMahendi",
													"PR_Database": "ADF_Training"
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_SQL_Server_IN1684",
												"type": "DatasetReference",
												"parameters": {
													"PR_Tablename": {
														"value": "@item().TargetTable",
														"type": "Expression"
													},
													"PR_Schema": "PMahendi",
													"PR_Database": "ADF_Training"
												}
											}
										]
									}
								]
							}
						}
					]
				}
			}
		],
		"folder": {
			"name": "DAY 5"
		},
		"annotations": []
	}
}