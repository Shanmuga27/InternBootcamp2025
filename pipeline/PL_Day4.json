{
	"name": "PL_Day4",
	"properties": {
		"activities": [
			{
				"name": "Copy SQL-csv",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_OnPrem_SQLServer",
						"type": "DatasetReference",
						"parameters": {
							"Par_SchemaName": "RRamesh",
							"Par_TableName": "cust"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_CSV_IN1685",
						"type": "DatasetReference",
						"parameters": {
							"Param_Container": "boootcamp25",
							"Param_Folder": "IN1685",
							"Param_File": "dummy_cust.csv"
						}
					}
				]
			}
		],
		"annotations": []
	}
}