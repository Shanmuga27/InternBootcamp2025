{
	"name": "Row_Count_Check",
	"properties": {
		"activities": [
			{
				"name": "SrcCustomers_RowCount",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference",
						"parameters": {
							"ContainerName": "boootcamp25",
							"FolderName": "IN1675/mock_staging",
							"FileName": "Stg_customer.csv"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "TgtCustomers_RowCount",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_CSV_IN1675",
						"type": "DatasetReference",
						"parameters": {
							"ContainerName": "boootcamp25",
							"FolderName": "IN1675/mock_target",
							"FileName": "Tgt_customer.csv"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Set variable1",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "SrcCustomers_RowCount",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "SrcCount",
					"value": {
						"value": "@activity('SrcCustomers_RowCount').output.count",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set variable2",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "TgtCustomers_RowCount",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "TgtCount",
					"value": {
						"value": "@activity('TgtCustomers_RowCount').output.count",
						"type": "Expression"
					}
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Set variable1",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set variable2",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(variables('SrcCount'),variables('TgtCount'))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "If_not_match",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "Result",
								"value": {
									"value": "'Src to Tgt row count not match'",
									"type": "Expression"
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "If_Match",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "Result",
								"value": {
									"value": "'Src to Tgt row count matches'",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"variables": {
			"SrcCount": {
				"type": "Integer"
			},
			"TgtCount": {
				"type": "Integer"
			},
			"Result": {
				"type": "String"
			}
		},
		"annotations": []
	}
}