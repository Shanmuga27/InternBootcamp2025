				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"additionalColumns": [
							{
								"name": "current date",
								"value": {
									"value": "@formatDateTime(utcNow())",
									"type": "Expression"
								}
							},
							{
								"name": "pipieline name",
								"value": {
									"value": "@pipeline().Pipeline",
									"type": "Expression"
								}
							},
							{
								"name": "current date1",
								"value": {
									"value": "@formatDateTime(utcNow())",
									"type": "Expression"
								}
							},
							{
								"name": "pipeline name1",
								"value": {
									"value": "@pipeline().Pipeline",
									"type": "Expression"
								}
							},
							{
								"name": "pipeline runid",
