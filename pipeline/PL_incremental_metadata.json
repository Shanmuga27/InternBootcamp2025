{
	"name": "PL_incremental_metadata",
	"properties": {
		"activities": [
			{
				"name": "metadata_of_files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference",
						"parameters": {
							"container": "boootcamp25",
							"folder": "Src files",
							"file": "*"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "append_array_names_into_array",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "metadata_of_files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('metadata_of_files').output.childItems",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "append_file_name_in_array",
							"type": "AppendVariable",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"variableName": "File_names",
								"value": {
									"value": "@string(replace(replace(item().name,'.csv' ,''),'orders_' ,''))",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "read_untill_array_is_empty",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "append_array_names_into_array",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"activities": [
						{
							"name": "read_current_file",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "current_file_name",
								"value": {
									"value": "@min(variables('File_names'))",
									"type": "Expression"
								}
							}
						}
					],
					"timeout": "0.12:00:00"
				}
			},
			{
				"name": "Set variable1",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "append_array_names_into_array",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "read_file_names",
					"value": {
						"value": "@min(variables('File_names').output)",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"File_names": {
				"type": "Array"
			},
			"read_file_names": {
				"type": "Array"
			},
			"current_file_name": {
				"type": "Integer"
			}
		},
		"folder": {
			"name": "exercise"
		},
		"annotations": []
	}
}