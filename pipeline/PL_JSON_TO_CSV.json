{
	"name": "PL_JSON_TO_CSV",
	"properties": {
		"activities": [
			{
				"name": "CD_OrderDetails",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings",
							"copyBehavior": "FlattenHierarchy"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['OrderDetailID']"
								},
								"sink": {
									"name": "OrderDetailID",
									"type": "Int64"
								}
							},
							{
								"source": {
									"path": "$['OrderID']"
								},
								"sink": {
									"name": "OrderID",
									"type": "Int64"
								}
							},
							{
								"source": {
									"path": "$['ProductID']"
								},
								"sink": {
									"name": "ProductID",
									"type": "Int64"
								}
							},
							{
								"source": {
									"path": "$['Quantity']"
								},
								"sink": {
									"name": "Quantity",
									"type": "Int64"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Json",
						"type": "DatasetReference",
						"parameters": {
							"foldername": "SourceFiles",
							"filename": "orderdetails.json"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Blob_IN1677_Src",
						"type": "DatasetReference",
						"parameters": {
							"directory": "Target/IN1677/src_csv",
							"file": "orderdetails"
						}
					}
				]
			},
