{
	"name": "PL_Metadata",
	"properties": {
		"activities": [
			{
				"name": "If_Metadata_Col_Count",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Metadata_src_products",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Metadata_tgt_products",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('Metadata_src_products').output.columnCount,activity('Metadata_tgt_products').output.columnCount )",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Variable_Col_count_not_matches",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "result",
								"value": "\"Column Count not equal\""
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Variable_Col_count_Matches",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "result",
								"value": {
									"value": "\"Equal columnCount\"",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Metadata_src_products",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference",
						"parameters": {
							"PR_Directory": "IN1684/Practice/Source Files",
							"PR_Filename": "products.csv"
						}
					},
					"fieldList": [
						"columnCount"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Metadata_tgt_products",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Blob_IN1684",
						"type": "DatasetReference",
						"parameters": {
							"PR_Directory": "IN1684/Practice/Target/tgt",
							"PR_Filename": "dim_products"
						}
					},
					"fieldList": [
						"columnCount"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
		"variables": {
			"result": {
				"type": "String"
			}
		},
		"folder": {
			"name": "QA"
		},
		"annotations": []
	}
}