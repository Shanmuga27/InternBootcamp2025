{
	"name": "PL_multiple_ex_to_sql_server_IN1680",
	"properties": {
		"activities": [
			{
				"name": "metadata_for_northwind",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_blob_excel",
						"type": "DatasetReference",
						"parameters": {
							"container": "boootcamp25",
							"folder": "IN1680/northwind",
							"file": "*",
							"sheetindex": 0
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"enablePartitionDiscovery": false
					}
				}
			},
			{
				"name": "for_each_excel",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "metadata_for_northwind",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('metadata_for_northwind').output.childItems",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "copy_data_from_excel_server",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "ExcelSource",
									"storeSettings": {
										"type": "AzureBlobStorageReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									}
								},
								"sink": {
									"type": "SqlServerSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false,
									"tableOption": "autoCreate"
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_blob_excel",
									"type": "DatasetReference",
									"parameters": {
										"container": "boootcamp25",
										"folder": "IN1680/northwind",
										"file": {
											"value": "@item().name",
											"type": "Expression"
										},
										"sheetindex": 0
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_SQL_Server_IN1680",
									"type": "DatasetReference",
									"parameters": {
										"SchemaName": "KRavi",
										"TableName": "tgt_multipleexcel_IN1680"
									}
								}
							]
						}
					]
				}
			}
		],
		"annotations": []
	}
}