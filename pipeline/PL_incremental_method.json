					"activities": [
						{
							"name": "DF_Incremental_method",
							"type": "ExecuteDataFlow",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataflow": {
									"referenceName": "DF_Incremental_method",
									"type": "DataFlowReference",
									"datasetParameters": {
										"srcOrdersData": {
											"container": "boootcamp25",
											"folder": "Src files",
											"file": {
												"value": "@item().name",
												"type": "Expression"
											}
										},
										"tgt": {
											"container": "boootcamp25",
											"folder": "IN1680",
											"file": "tgt_incr.csv"
										},
										"sink1": {
											"container": "boootcamp25",
											"folder": "IN1680",
											"file": "tgt_incr.csv"
										}
									}
								},
								"compute": {
									"coreCount": 8,
									"computeType": "General"
								},
								"traceLevel": "Fine"
							}
						}
					]
				}
			},
			{
				"name": "get_all_the_files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Blob_1680",
						"type": "DatasetReference",
						"parameters": {
							"container": "boootcamp25",
							"folder": "Src files",
							"file": "*"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
		"variables": {
			"Max_id": {
				"type": "Integer"
			}
		},
		"folder": {
			"name": "exercise"
		},
		"annotations": []
	}
