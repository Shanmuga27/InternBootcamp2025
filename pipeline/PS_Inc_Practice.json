					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_OnPremSQL_IN1675",
					"type": "LinkedServiceReference",
					"parameters": {
						"database": "ADF_Training"
					}
				},
				"typeProperties": {
					"scripts": [
