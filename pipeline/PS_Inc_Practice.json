						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "SqlServerSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"tableOption": "autoCreate"
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_OnPremSQL_IN1675",
						"type": "DatasetReference",
						"parameters": {
							"TableName": "SalesCSV",
							"SchemaName": "DMuthuku",
							"DatabaseName": "ADF_Training"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_OnPremSQL_IN1675",
						"type": "DatasetReference",
						"parameters": {
							"TableName": "tgt_Sales",
							"SchemaName": "DMuthuku",
							"DatabaseName": "ADF_Training"
						}
					}
				]
			},
			{
				"name": "Script1",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Copy data1",
						"dependencyConditions": [
							"Succeeded"
						]
