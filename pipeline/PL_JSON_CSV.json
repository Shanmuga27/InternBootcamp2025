{
	"name": "PL_JSON_CSV",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['name']"
								},
								"sink": {
									"name": "name",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['age']"
								},
								"sink": {
									"name": "age",
									"type": "Int64"
								}
							},
							{
								"source": {
									"path": "$['city']"
								},
								"sink": {
									"name": "city",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['married']"
								},
								"sink": {
									"name": "married",
									"type": "Boolean"
								}
							},
							{
								"source": {
									"path": "$['hobbies'][0]"
								},
								"sink": {
									"name": "items",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['address']['street']"
								},
								"sink": {
									"name": "street",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['address']['city']"
								},
								"sink": {
									"name": "address_city",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['address']['postal_code']"
								},
								"sink": {
									"name": "postal_code",
									"type": "Int64"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Json",
						"type": "DatasetReference",
						"parameters": {
							"foldername": "IN1677/JSON",
							"filename": "sample1.json"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Blob_IN1677_Tgt",
						"type": "DatasetReference",
						"parameters": {
							"container": "boootcamp25",
							"directory": "IN1677/JSON_TO_CSV",
							"file": "sample1.csv"
						}
					}
				]
			},
			{
				"name": "Switch1",
				"type": "Switch",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@pipeline().parameters.reg",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "Eu"
						},
						{
							"value": "US"
						}
					]
				}
			}
		],
		"parameters": {
			"reg": {
				"type": "string"
			}
		},
		"folder": {
			"name": "learn"
		},
		"annotations": []
	}
}