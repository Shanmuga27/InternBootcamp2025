					{
						"activity": "LKP_Orders",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_Orders').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "If_Con_Junk_Value",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@or(\n    equals(item().order_amount,0),\n    equals(item().order_date,'1990-01-01') \n    )",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Var_No_JunkValue",
										"type": "SetVariable",
										"dependsOn": [],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "res",
											"value": false
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Var_JunkValue",
										"type": "SetVariable",
										"dependsOn": [],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "res",
											"value": true
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"variables": {
			"res": {
				"type": "Boolean"
			}
		},
		"folder": {
			"name": "Practice/Testing"
		},
		"annotations": []
	}
}