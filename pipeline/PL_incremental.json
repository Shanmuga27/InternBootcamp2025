					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Filter1",
				"type": "Filter",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "LookupSRC",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "LookupTGT",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LookupSRC').output.value['4']",
						"type": "Expression"
					},
					"condition": {
						"value": "@greater(item(), activity('LookupTGT').output.firstRow)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "LookupTGT",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
