				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "select max(order_start_dt)\nfrom RRamesh.tgt;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_OnPrem_SQLServer",
						"type": "DatasetReference",
						"parameters": {
